                                                        <div class="tm-elite-checkbox-item @(selectedRow.ResultMaster.isentered == true ? "active" : "")" @onclick="() => selectedRow.ResultMaster.isentered = !(selectedRow.ResultMaster.isentered ?? false)">
                                                            <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                            <span class="tm-elite-checkbox-label">Entered</span>
                                                        </div>
                                                        <div class="tm-elite-checkbox-item @(selectedRow.ResultMaster.sendsms == true ? "active" : "")" @onclick="() => selectedRow.ResultMaster.sendsms = !(selectedRow.ResultMaster.sendsms ?? false)">
                                                            <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                            <span class="tm-elite-checkbox-label">SMS</span>
                                                        </div>
                                                        <div class="tm-elite-checkbox-item @(selectedRow.ResultMaster.is_escalation == true ? "active" : "")" @onclick="() => selectedRow.ResultMaster.is_escalation = (selectedRow.ResultMaster.is_escalation == true ? false : true)">
                                                            <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                            <span class="tm-elite-checkbox-label">Escalation</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="flex-1" style="display: flex; flex-direction: column; gap: 20px;">
                                                    <div class="display-flex gap-16">
                                                        <div class="flex-1">
                                                            <label class="tm-elite-label">UNITS</label>
                                                            <div style="display: flex; gap: 8px;">
                                                                <InputSelect @bind-Value="selectedRow.ResultProperties.defaultunitscode" class="tm-elite-input" style="flex: 1;">
                                                                    <option value="0">SELECT UNITS</option>
                                                                    @foreach(var u in units) { <option value="@u.ucode">@u.name</option> }
                                                                </InputSelect>
                                                                <button type="button" class="tm-btn-primary" style="padding: 0 12px; height: 38px; display: flex; align-items: center; border-radius: 5px;" @onclick="ShowUnitModal" title="View Units">
                                                                    <i class="material-symbols-outlined" style="font-size: 16px;">list</i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <label class="tm-elite-label">DECIMAL</label>
                                                            <InputNumber @bind-Value="selectedRow.ResultProperties.decimalvalue" class="tm-elite-input" style="width: 80px;" />
                                                        </div>
                                                    </div>

                                                    <div class="display-flex align-center justify-between">
                                                        <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.isgraph == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.isgraph = !(selectedRow.ResultProperties.isgraph ?? false)">
                                                            <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                            <span class="tm-elite-checkbox-label">Graph Value</span>
                                                            <InputNumber @bind-Value="selectedRow.ResultProperties.graphvalue" class="tm-elite-input ml-12" style="width: 60px; height: 28px; padding: 0 8px;" @onclick:stopPropagation="true" />
                                                        </div>
                                                        <a class="font-11" style="color: #4f46e5; text-decoration: underline; cursor: pointer; font-weight: 600;">Text Template</a>
                                                    </div>

                                                    @if (selectedRow?.ResultProperties != null && !((selectedRow.ResultProperties.resultvaluetype == "Numeric" || selectedRow.ResultProperties.resultvaluetype == "Calculated Value") && (selectedRow.ResultProperties.detailednormalvalues ?? false)))
                                                    {
                                                        <div style="flex-grow: 1; display: flex; flex-direction: column;">
                                                            <div class="display-flex justify-between align-center mb-8" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                                                <label class="tm-elite-label" style="margin: 0;">NORMAL VALUE (SIMPLE)</label>
                                                                @if (selectedRow.ResultProperties.resultvaluetype == "Text" || selectedRow.ResultProperties.resultvaluetype == "Text & Number")
                                                                {
                                                                    <div class="display-flex align-center gap-8" style="display: flex; align-items: center; gap: 8px;">
                                                                        <span style="font-size: 10px; font-weight: 700; color: #64748b;">SEX:</span>
                                                                        <select class="tm-elite-input" style="width: 100px; height: 26px; font-size: 11px; padding: 0 8px;" @onchange="OnTextNormalSexChange" value="@selectedTextSex">
                                                                            <option value="Both">For All</option>
                                                                            <option value="Male">Male</option>
                                                                            <option value="Female">Female</option>
                                                                            <option value="Child">Child</option>
                                                                        </select>
                                                                    </div>
                                                                }
                                                            </div>
                                                            @if (selectedRow.ResultProperties.resultvaluetype == "Text" || selectedRow.ResultProperties.resultvaluetype == "Text & Number")
                                                            {
                                                                <textarea class="tm-elite-input" style="flex-grow: 1; min-height: 180px; padding: 5px; line-height: 1.6; font-family: inherit; resize: none;" @bind="currentTextNormalValue" placeholder="Enter reference ranges for reporting..."></textarea>
                                                            }
                                                            else
                                                            {
                                                                <textarea class="tm-elite-input" style="flex-grow: 1; min-height: 180px; padding: 5px; line-height: 1.6; font-family: inherit; resize: none;" @bind="selectedRow.ResultProperties.normalvalue" placeholder="Enter reference ranges for reporting..."></textarea>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="mt-24 pt-24" style="border-top: 1px solid #e2e8f0;">
                                                <div class="display-flex gap-32 mb-20">
                                                    <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.detailednormalvalues == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.detailednormalvalues = !(selectedRow.ResultProperties.detailednormalvalues ?? false)">
                                                        <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                        <span class="tm-elite-checkbox-label" style="font-weight: 600;">Detailed Normal Range</span>
                                                    </div>
                                                    <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.showalertonhigherlower == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.showalertonhigherlower = !(selectedRow.ResultProperties.showalertonhigherlower ?? false)">
                                                        <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                        <span class="tm-elite-checkbox-label" style="color: #ef4444; font-weight: 600;">Show Alert on Lower & Higher values</span>
                                                    </div>
                                                </div>

                                                <div class="display-flex align-center gap-24 flex-wrap" style="background: #f8fafc; padding: 24px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; align-items: center; flex-wrap: wrap;">
                                                    @if (!(selectedRow.ResultProperties.detailednormalvalues ?? false))
                                                    {
                                                        <div class="display-flex align-center gap-12">
                                                            <span class="tm-elite-label m-0">NORMAL RANGE</span>
                                                            <InputSelect @bind-Value="selectedRow.ResultProperties.rangetype" class="tm-elite-input" style="width: 120px; height: 40px;">
                                                                <option value="-">-</option><option value="Range">Range</option><option value="Upto">Upto</option>
                                                                <option value="Less than">Less than</option><option value="&lt;">&lt;</option><option value="&lt;=">&lt;=</option>
                                                                <option value="≤">≤</option><option value="More than">More than</option><option value="&gt;">&gt;</option>
                                                                <option value="&gt;=">&gt;=</option><option value="≥">≥</option><option value="=">=</option>
                                                            </InputSelect>
                                                            <InputNumber @bind-Value="selectedRow.ResultProperties.fromnormalvalue" class="tm-elite-input" style="width: 100px; height: 40px;" />
                                                            <InputNumber @bind-Value="selectedRow.ResultProperties.tonormalvalue" class="tm-elite-input" style="width: 100px; height: 40px;" />
                                                        </div>
                                                    }
                                                    
                                                    <div class="display-flex align-center gap-12 @((selectedRow.ResultProperties.detailednormalvalues ?? false) ? "" : "ml-auto")">
                                                        <span class="tm-elite-label m-0" style="color: #ea580c;">CRITICAL LOW</span>
                                                        <InputSelect @bind-Value="selectedRow.ResultProperties.criticallowtype" class="tm-elite-input" style="width: 120px; height: 40px;">
                                                            <option value="-">-</option><option value="Range">Range</option><option value="Upto">Upto</option>
                                                            <option value="Less than">Less than</option><option value="&lt;">&lt;</option><option value="&lt;=">&lt;=</option>
                                                            <option value="≤">≤</option><option value="More than">More than</option><option value="&gt;">&gt;</option>
                                                            <option value="&gt;=">&gt;=</option><option value="≥">≥</option><option value="=">=</option>
                                                        </InputSelect>
                                                        <InputText @bind-Value="selectedRow.ResultProperties.criticallowrange" class="tm-elite-input" style="width: 100px; height: 40px;" />
                                                    </div>

                                                    <div class="display-flex align-center gap-12">
                                                        <span class="tm-elite-label m-0" style="color: #ef4444;">CRITICAL HIGH</span>
                                                        <InputSelect @bind-Value="selectedRow.ResultProperties.criticalhightype" class="tm-elite-input" style="width: 120px; height: 40px;">
                                                            <option value="-">-</option><option value="Range">Range</option><option value="Upto">Upto</option>
                                                            <option value="Less than">Less than</option><option value="&lt;">&lt;</option><option value="&lt;=">&lt;=</option>
                                                            <option value="≤">≤</option><option value="More than">More than</option><option value="&gt;">&gt;</option>
                                                            <option value="&gt;=">&gt;=</option><option value="≥">≥</option><option value="=">=</option>
                                                        </InputSelect>
                                                        <InputText @bind-Value="selectedRow.ResultProperties.criticalhighrange" class="tm-elite-input" style="width: 100px; height: 40px;" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (activeTab == "Age Based Reference" || activeTab == "Age Based")
                                    {
                                        @if ((selectedRow?.ResultProperties?.detailednormalvalues ?? false) && (selectedRow?.ResultProperties?.resultvaluetype == "Text" || selectedRow?.ResultProperties?.resultvaluetype == "Text & Number" || selectedRow?.ResultProperties?.resultvaluetype == "Numeric" || selectedRow?.ResultProperties?.resultvaluetype == "Calculated Value"))
                                        {
                                            <div class="display-flex justify-between align-center mb-16">
                                                <div style="font-size: 13px; font-weight: 700; color: #1e293b;">Detailed Reference Ranges</div>
                                                <button type="button" class="tm-btn-primary" style="padding: 6px 12px;" @onclick="AddDetailedRange">
                                                    <i class="material-symbols-outlined font-18">add</i> ADD RANGE
                                                </button>
                                            </div>
                                            <div class="lc-overflow-auto no-scrollbar" style="max-height: 400px; border: 1.5px solid #e2e8f0; border-radius: 12px; overflow: auto;">
                                                <table class="tm-age-table">
                                                    <thead>
                                                        <tr>
                                                            <th>From</th>
                                                            <th>Type</th>
                                                            <th>To</th>
                                                            <th>Type</th>
                                                            <th>Sex</th>
                                                            <th>Range Type</th>
                                                            <th>Min</th>
                                                            <th>Max</th>
                                                            <th>Condition</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (selectedRow.DetailedNormalValues != null)
                                                        {
                                                            @foreach (var range in selectedRow.DetailedNormalValues)
                                                            {
                                                                <tr>
                                                                    <td><input type="number" class="tm-age-input" @bind="range.agefrom" /></td>
                                                                    <td>
                                                                        <select class="tm-age-input" @bind="range.agefromtype">
                                                                            <option>Yrs</option><option>Mths</option><option>Days</option>
                                                                        </select>
                                                                    </td>
                                                                    <td><input type="number" class="tm-age-input" @bind="range.ageto" /></td>
                                                                    <td>
                                                                        <select class="tm-age-input" @bind="range.agetotype">
                                                                            <option>Yrs</option><option>Mths</option><option>Days</option>
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <select class="tm-age-input" @bind="range.sex">
                                                                            <option value="Both">For All</option><option value="Male">Male</option><option value="Female">Female</option>
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <select class="tm-age-input" @bind="range.rangetype">
                                                                            <option>Between</option><option>&gt;</option><option>&lt;</option><option>=</option>
                                                                        </select>
                                                                    </td>
                                                                    <td><input type="number" step="any" class="tm-age-input" @bind="range.rangefrom" /></td>
                                                                    <td><input type="number" step="any" class="tm-age-input" @bind="range.rangeto" /></td>
                                                                    <td>
                                                                        <select class="tm-age-input" @bind="range.agerangetype">
                                                                            <option value="Child">Child</option>
                                                                            <option value="Adult Male">Adult Male</option>
                                                                            <option value="Adult Female">Adult Female</option>
                                                                            <option value="Child Male">Child Male</option>
                                                                            <option value="Child Female">Child Female</option>
                                                                            <option value="Good Control">Good Control</option>
                                                                            <option value="Fair Control">Fair Control</option>
                                                                            <option value="Pregnancy">Pregnancy</option>
                                                                        </select>
                                                                    </td>
                                                                    <td style="text-align: center;">
                                                                        <i class="material-symbols-outlined text-red-500 cursor-pointer" @onclick="() => selectedRow.DetailedNormalValues.Remove(range)">delete</i>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="display-flex flex-col gap-12 mt-16">
                                                <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.showagedbased == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.showagedbased = !(selectedRow.ResultProperties.showagedbased ?? false)">
                                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                    <span class="tm-elite-checkbox-label">Show Age based Normal Ranges in report</span>
                                                </div>
                                                <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.printunitsinnormalvalues == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.printunitsinnormalvalues = !(selectedRow.ResultProperties.printunitsinnormalvalues ?? false)">
                                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                    <span class="tm-elite-checkbox-label">Print Units in Normal Values</span>
                                                </div>
                                                <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.printspecialfieldsatrightside == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.printspecialfieldsatrightside = !(selectedRow.ResultProperties.printspecialfieldsatrightside ?? false)">
                                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                    <span class="tm-elite-checkbox-label">Print Special Field at Right Side</span>
                                                </div>
                                                <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.printnormalvaluesatbottom == true ? "active" : "")" @onclick="() => selectedRow.ResultProperties.printnormalvaluesatbottom = !(selectedRow.ResultProperties.printnormalvaluesatbottom ?? false)">
                                                    <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                    <span class="tm-elite-checkbox-label">Print Normal Values at Bottom</span>
                                                </div>
                                                <div class="display-flex gap-32 mt-8">
                                                    <label class="display-flex align-center gap-8 cursor-pointer">
                                                        <input type="radio" name="groupType" checked="@(selectedRow.ResultProperties.groupvaluesbysex ?? false)" @onchange="@(e => selectedRow.ResultProperties.groupvaluesbysex = true)" />
                                                        <span class="tm-elite-checkbox-label">Group Values by Sex</span>
                                                    </label>
                                                    <label class="display-flex align-center gap-8 cursor-pointer">
                                                        <input type="radio" name="groupType" checked="@(selectedRow.ResultProperties.groupvaluesbyspecialfield ?? false)" @onchange="@(e => selectedRow.ResultProperties.groupvaluesbyspecialfield = true)" />
                                                        <span class="tm-elite-checkbox-label">Group Values by Special Condition</span>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="display-flex align-center justify-center p-32 text-slate-400">
                                                <span class="material-symbols-outlined font-48">lock</span>
                                                <span class="ml-12 font-13">Enable 'Detailed Normal Range' in Settings to configure age-based references.</span>
                                            </div>
                                        }
                                    }
                                    else if (activeTab == "Comments")
                                    {
                                        <div class="mb-20">
                                            <div class="tm-elite-checkbox-item @(selectedRow.ResultProperties.printconclusioninreport == true ? "active" : "")" style="margin-bottom: 20px;" @onclick="() => selectedRow.ResultProperties.printconclusioninreport = !(selectedRow.ResultProperties.printconclusioninreport ?? false)">
                                                <div class="tm-elite-checkbox-box"><i class="material-symbols-outlined">check</i></div>
                                                <span class="tm-elite-checkbox-label">Print Conclusion In Report</span>
                                            </div>

                                            <div class="mb-20">
                                                <label class="tm-elite-label">CONCLUSION</label>
                                                <div style="border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #fff;">
                                                    <SFRichTextEditor @bind-Value="selectedRow.ResultProperties.conclusionforfixedtext" />
                                                </div>
                                            </div>

                                            <div class="mb-20">
                                                <label class="tm-elite-label">FOOTER</label>
                                                <div style="border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #fff;">
                                                    <SFRichTextEditor @bind-Value="selectedRow.ResultProperties.footermessage" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (activeTab == "Specimens")
                                    {
                                        @if (selectedRow.ResultProperties.resultvaluetype == "Culture" || selectedRow.ResultProperties.resultvaluetype == "Title" || selectedRow.ResultProperties.resultvaluetype == "SubTitle")
                                        {
                                            <div class="mb-20">
                                                <label class="tm-elite-label">SPECIMEN</label>
                                                <input type="text" list="specimen_options" class="tm-elite-input" @bind="selectedRow.ResultProperties.normalvalue" />
                                                <datalist id="specimen_options">
                                                    <option value="EDTA"></option>
                                                    <option value="Serum"></option>
                                                    <option value="Serum-F"></option>
                                                    <option value="Serum-PP"></option>
                                                    <option value="Urine"></option>
                                                </datalist>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 16px;">Parameter Overrides</div>
                                            <div class="lc-overflow-auto no-scrollbar" style="border: 1.5px solid #e2e8f0; border-radius: 12px;">
                                                <table class="tm-age-table">
                                                    <thead>
                                                        <tr>
                                                             <th style="width: 50px; text-align: center;">S.No</th>
                                                            <th>Parameter</th>
                                                            <th>Machine</th>
                                                            <th>Sample</th>
                                                            <th>Method</th>
                                                            <th style="width: 80px; text-align: center;">Default</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (testData.ResultRows != null)
                                                        {
                                                            @for (int i = 0; i < testData.ResultRows.Count; i++)
                                                            {
                                                                var index = i;
                                                                var row = testData.ResultRows[i];
                                                                <tr>
                                                                    <td style="text-align: center; font-weight: 700; color: #64748b;">@(index + 1)</td>
                                                                    <td style="font-weight: 700; color: #4f46e5;">@row.ResultMaster.cellcontent</td>
                                                                    <td>
                                                                        <select class="tm-age-input" value="@row.ResultProperties.mccode" @onchange="(e) => OnRowMachineChange(e, row)">
                                                                            <option value="0">SELECT MACHINE</option>
                                                                            @foreach (var m in machines) { <option value="@m.mccode">@m.name</option> }
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <select class="tm-age-input" value="@row.ResultProperties.scode" @onchange="(e) => OnRowSpecimenChange(e, row)">
                                                                            <option value="0">SELECT SPECIMEN</option>
                                                                            @foreach (var s in specimens) { <option value="@s.scode">@s.name</option> }
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <select class="tm-age-input" value="@row.ResultProperties.rtmcode" @onchange="(e) => OnRowMethodChange(e, row)">
                                                                            <option value="0">SELECT METHOD</option>
                                                                            @foreach (var m in methods) { <option value="@m.rtmcode">@m.name</option> }
                                                                        </select>
                                                                    </td>
                                                                    <td style="text-align: center;">
                                                                        <input type="checkbox" @bind="row.ResultProperties.usedefault" />
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div style="margin-top: 12px; font-size: 11px; color: #64748b; font-style: italic;">
                                                Machine and specimen are shown for all parameters. Use the top header dropdowns to set all at once.
                                            </div>
                                        }
                                    }
                                    else if (activeTab == "Option Text")
                                    {
                                        <div class="mb-20">
                                            <label class="tm-elite-label">RICH TEXT TEMPLATE FOR @selectedRow.ResultMaster.col2</label>
                                            <div style="border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #fff; min-height: 250px;">
                                                <SFRichTextEditor @bind-Value="selectedRow.ResultMaster.cellcontent" />
                                            </div>
                                            <div class="mt-8 font-11" style="color: #64748b;">
                                                Use the editor above to design the report layout for this parameter.
                                            </div>
                                        </div>
                                    }
                                }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="tm-footer">
            <div class="tm-footer-left">
                <div class="tm-footer-item">
                    <span class="tm-footer-label" style="font-weight: 700; font-size: 11px; color: #64748b; margin-right: 8px;">TOTAL RECORDS:</span>
                    <span class="tm-footer-value" style="font-weight: 800; font-size: 13px; color: var(--lc-secondary);">@allTests.Count</span>
                </div>
            </div>
            <div class="tm-footer-right display-flex gap-12">
                @if (!isListView)
                {
                    <button type="button" @onclick="DeleteTest" style="background: #ef4444; color: white; border: none; padding: 6px 16px; border-radius: 8px; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 700; font-size: 11px; box-shadow: 0 4px 6px rgba(239, 68, 68, 0.2); white-space: nowrap; height: 30px;">
                        <i class="material-symbols-outlined font-14">delete</i> DELETE
                    </button>
                    <button type="button" class="tm-btn-outline" @onclick="ResetForm" style="padding: 6px 12px; border-radius: 8px; display: flex; align-items: center; gap: 6px; font-size: 11px; height: 30px;">
                        <i class="material-symbols-outlined font-14">add_circle</i> NEW / CLEAR
                    </button>
                    <button type="button" class="tm-btn-outline" @onclick="GoToList" style="padding: 6px 12px; border-radius: 8px; display: flex; align-items: center; gap: 6px; font-size: 11px; height: 30px;">
                        <i class="material-symbols-outlined font-14">close</i> CLOSE
                    </button>
                    <button type="submit" class="tm-btn-primary" style="padding: 6px 20px; border-radius: 8px; display: flex; align-items: center; gap: 6px; font-size: 11px; height: 30px;">
                        <i class="material-symbols-outlined font-14">save</i> SAVE
                    </button>
                }
            </div>
        </div>
    </EditForm>
</div>

<!-- Master Data Modal -->
@if (showMasterModal)
{
    <div class="tm-modal-overlay" @onclick="() => showMasterModal = false">
        <div class="tm-modal-content" @onclick:stopPropagation="true">
            <div class="tm-modal-header">
                <span>@modalTitle</span>
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="tm-modal-close" @onclick="CloseMasterModal">
                        <i class="material-symbols-outlined">close</i>
                    </button>
                </div>
            </div>
