    private async Task DeleteTestFromList(test_master test)
    {
        if (test == null) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the test '{test.name}'?");
        if (confirmed)
        {
            IsLoading = true;
            StateHasChanged();
            if (await TestSvc.SoftDeleteTestAsync(test.tcode))
            {
                Toast.Success("Deleted");
                await LoadTests();
            }
            else
            {
                Toast.Error("Delete failed");
            }
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void ResetForm() { testData = new(); AddTestRow(); selectedRow = testData.ResultRows[0]; quillInitialized = false; reportingSearchText = ""; reportingDays = null; reportingHours = null; reportingMins = null; }
    private async Task HideTestDropdown() {  }
    private void HandleInvalidSubmit() => Toast.Warning("Check required fields");
}
