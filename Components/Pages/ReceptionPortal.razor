@page "/nishant/reception-portal"
@using SharedComponents.Rcl.Models
@using Newtonsoft.Json
@using Medico_Backend.Model
@using Booking.Helpers
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.ToastService Toast
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject Booking.Services.DoctorService DoctorService
@inject Booking.Services.VitalsService VitalsService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="reception-page">
    <DnaLoader IsLoading="@isLoading" Message="Loading Portal Data..." />
    <!-- Patient Master Style Header Card -->
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-12">
            <div class="icon-box-container flex-center bg-indigo-50 rounded-lg shadow-sm">
                <i class="bi bi-hospital icon-lg text-indigo-600"></i>
            </div>
            <div>
                <h1 class="lab-title-text">Reception Portal</h1>
                <div class="display-flex align-center gap-6" style="margin-top: 2px;">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Patient Check-in Desk</span>
                </div>
            </div>
        </div>

        <div class="header-action-group">
            <button type="button" class="btn-new-patient-primary" @onclick="OpenNewPatientModal">
                <i class="bi bi-plus-lg"></i>
                <span>New Patient</span>
            </button>
        </div>
    </div>

    <!-- Patient Check-in Main Section Card -->
    <div class="reception-card check-in-card">
        <div class="card-header-flex">
            <h2 class="card-section-title">
                <span class="material-symbols-outlined icon-indigo-badge">how_to_reg</span> Patient Check-in
            </h2>
            <div class="queue-status-badge">
                QUEUE: @(recentCheckIns.Count) ACTIVE
            </div>
        </div>

        <div class="card-body-content">
            <label class="field-uppercase-label">SEARCH BY MRN NO, NAME, MOBILE NO</label>
            <div class="input-validate-row" style="position: relative;">
                <div class="patient-id-input-box">
                    <input type="text" class="patient-id-control" 
                           @bind="checkInSearchQuery" 
                           @bind:event="oninput" 
                           @onkeyup="HandleCheckInKeyUp" 
                           @onfocus="OnInputFocus" 
                           placeholder="Type MRN No (ID), Name, or Mobile No..." />
                    <i class="bi bi-card-text input-right-icon"></i>

                    <!-- Live Autocomplete Search Dropdown -->
                    @if (showSearchDropdown && matchingCustomers.Any())
                    {
                        <div class="search-results-dropdown">
                            @foreach (var c in matchingCustomers)
                            {
                                <div class="search-result-item" @onclick="() => SelectCustomer(c)">
                                    <div>
                                        <div class="result-name">@(string.IsNullOrWhiteSpace(c.namewithinitials) ? c.name : c.namewithinitials)</div>
                                        <div class="result-sub"><i class="bi bi-telephone"></i> @(string.IsNullOrWhiteSpace(c.mobile) ? c.phone : c.mobile)</div>
                                    </div>
                                    <div class="result-id">@GetMrn(c)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <button type="button" class="btn-validate-blue" @onclick="ValidatePatient">
                    Validate
                </button>
            </div>

            <!-- Patient Found Info Box -->
            @if (selectedCustomer != null)
            {
                <div class="patient-found-banner">
                    <div class="patient-avatar-box">
                        <div class="patient-avatar-initials">@GetInitials(selectedCustomer.namewithinitials ?? selectedCustomer.name)</div>
                    </div>
                    <div class="patient-details-info">
                        <div class="found-label">PATIENT FOUND</div>
                        <div class="patient-full-name">
                            @(string.IsNullOrWhiteSpace(selectedCustomer.namewithinitials) ? selectedCustomer.name : selectedCustomer.namewithinitials)
                            <span class="mrn-badge-pill">ID: @GetMrn(selectedCustomer)</span>
                        </div>
                        <div class="patient-sub-detail">
                            <i class="bi bi-cake2 detail-icon"></i> DOB: @(selectedCustomer.dateofbirth.HasValue ? selectedCustomer.dateofbirth.Value.ToString("dd MMM yyyy") : "N/A") (@(selectedCustomer.ageyears)y)
                            &nbsp;|&nbsp; <i class="bi bi-telephone detail-icon"></i> Mobile: @(string.IsNullOrWhiteSpace(selectedCustomer.mobile) ? selectedCustomer.phone : selectedCustomer.mobile)
                        </div>
                        <div class="patient-sub-detail">
                            <i class="bi bi-geo-alt detail-icon"></i> Address: @GetFormattedAddress(selectedCustomer)
                        </div>
                    </div>

                    <!-- Right-aligned action buttons inside Patient Found banner -->
                    <div class="patient-found-actions-right">
                        <button type="button" class="btn-outline-modify" @onclick="ModifyProfile">
                            Modify Profile
                        </button>
                        <button type="button" class="btn-confirm-blue" @onclick="() => ConfirmCheckIn(false)">
                            Confirm Check-in
                        </button>
                    </div>
                </div>
            }
            else if (isSearchPerformed && selectedCustomer == null)
            {
                <div class="patient-not-found-banner">
                    <i class="bi bi-exclamation-circle text-warning fs-4"></i>
                    <div>
                        <div class="fw-bold text-dark">No patient found matching "@checkInSearchQuery"</div>
                        <div class="text-muted small">Please verify MRN No, Name, or Mobile No, or click <strong>New Patient</strong> to register.</div>
                    </div>
                    <button type="button" class="btn-new-patient-sm" @onclick="OpenNewPatientModal">
                        + Register New Patient
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Recent Check-in Confirmations Section -->
    <div class="reception-card recent-confirmations-card">
        <div class="card-header-flex">
            <h2 class="card-section-title">
                <span class="material-symbols-outlined icon-indigo-badge">history</span> Recent Check-in Confirmations
            </h2>
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label style="font-weight: 600; color: #475569; font-size: 0.85rem; text-transform: uppercase;">SEARCH</label>
                    <input type="text" class="form-control-input" style="padding: 4px 10px; width: 220px; font-size: 0.9rem;" placeholder="Search ID, Name, Phone..." @bind="tableSearchQuery" @bind:event="oninput" />
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <label style="font-weight: 600; color: #475569; font-size: 0.85rem; text-transform: uppercase;">DATE</label>
                    <input type="date" class="form-control-input" style="padding: 4px 8px; width: 150px; font-size: 0.9rem;" @bind="selectedDate" @bind:after="LoadRecentCheckInsAsync" />
                </div>
            </div>
        </div>

        <div class="recent-table-wrapper">
            <table class="recent-checkins-table">
                <thead>
                    <tr>
                        <th>MRN No</th>
                        <th>PATIENT NAME</th>
                        <th>MOBILE NO</th>
                        <th>DATE & TIME</th>
                        <th>INVESTIGATION</th>
                        <th>DOCTOR NAME</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredRecentCheckIns != null && FilteredRecentCheckIns.Any())
                    {
                        @foreach (var item in FilteredRecentCheckIns)
                        {
                            <tr class="@(item.is_vip == true || item.isvip == true ? "vip-row" : "")">
                                <td>
                                    <div class="table-patient-id">@(item.custcode ?? "-")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark" style="display: flex; align-items: center;">
                                        @GetPatientName(item)
                                        @if (item.is_vip == true || item.isvip == true)
                                        {
                                            <span class="vip-badge" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 0.7rem; margin-left: 8px; display: inline-flex; align-items: center; gap: 2px;" title="VIP Patient">VIP</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="table-icon-text">
                                        <i class="bi bi-telephone"></i>
                                        <span>@GetMobileNo(item.custcode)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-icon-text">
                                        <i class="bi bi-calendar3"></i>
                                        <span>@item.entered_date.ToIndianTime().ToString("MMM dd, yyyy hh:mm tt")</span>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: #475569;">
                                        <div>@(string.IsNullOrWhiteSpace(item.investigation) ? "doctor" : item.investigation)</div>
                                        @if (!string.IsNullOrEmpty(item.test_name))
                                        {
                                            <span style="font-size: 0.72rem; color: #64748b; font-weight: normal; display: block; margin-top: 2px;">@item.test_name</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: #1e293b;">
                                        @{
                                            var docName = GetDoctorName(item);
                                        }
                                        @if (!string.IsNullOrWhiteSpace(docName))
                                        {
                                            <span>@docName</span>
                                        }
                                        else
                                        {
                                            <span style="color: #94a3b8;">-</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="status-pill-arrived @GetStatusClass(item)">
                                        <span class="dot-inner"></span> @GetDisplayStatus(item)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No recent check-in confirmations recorded.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- New Patient Registration Modal Popup Component -->
<NewPatientRegistration IsVisible="showNewPatientModal" EditPatient="editingCustomer" OnClose="HandleModalClose" OnPatientSaved="HandlePatientSaved" />

<!-- Check-in Details Modal -->
@if (showCheckInModal)
{
    <div class="modal-overlay">
        <div class="modal-container" style="max-width: 500px;">
            <div class="modal-header">
                <h3 class="modal-title">Confirm Patient Check-in</h3>
                <button type="button" class="btn-close-modal" @onclick="() => showCheckInModal = false" title="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div style="margin-bottom: 16px; padding: 12px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <div style="font-weight: 700; color: #1e293b; font-size: 0.95rem;">
                        @(string.IsNullOrWhiteSpace(selectedCustomer?.namewithinitials) ? selectedCustomer?.name : selectedCustomer?.namewithinitials)
                    </div>
                    <div style="font-size: 0.8rem; color: #64748b; font-weight: 600; margin-top: 4px;">
                        ID: @GetMrn(selectedCustomer)
                    </div>
                </div>

                <div class="form-grid" style="grid-template-columns: 1fr; gap: 12px;">
                    <!-- Primary Investigation Slot -->
                    <div class="form-group">
                        <label class="field-uppercase-label">INVESTIGATION (PRIMARY SLOT)</label>
                        <select class="form-control-select" @bind="checkInInvestigation">
                            <option value="">Select Primary Investigation</option>
                            <option value="doctor">Doctor</option>
                            <option value="lab">Lab</option>
                            <option value="scan">Scan</option>
                            <option value="ecg_echo">ECG / Echo</option>
                        </select>
                    </div>

                    <!-- Additional Investigation Slots -->
                    <div class="form-group">
                        <label class="field-uppercase-label">ADDITIONAL INVESTIGATION SLOTS</label>
                        <div style="display: flex; gap: 8px;">
                            <select class="form-control-select" style="flex: 1;" @bind="checkInInvestigation2">
                                <option value="">Slot 2</option>
                                <option value="doctor">Doctor</option>
                                <option value="lab">Lab</option>
                                <option value="scan">Scan</option>
                                <option value="ecg_echo">ECG / Echo</option>
                            </select>
                            <select class="form-control-select" style="flex: 1;" @bind="checkInInvestigation3">
                                <option value="">Slot 3</option>
                                <option value="doctor">Doctor</option>
                                <option value="lab">Lab</option>
                                <option value="scan">Scan</option>
                                <option value="ecg_echo">ECG / Echo</option>
                            </select>
                        </div>
                    </div>

                    <!-- Doctor Selection -->
                    <div class="form-group">
                        <label class="field-uppercase-label">DOCTOR</label>
                        <div class="doctor-selector-wrapper">
                            <button type="button" class="doctor-selector-button @(showCheckInDoctorDropdown ? "active" : "")" @onclick="() => showCheckInDoctorDropdown = !showCheckInDoctorDropdown">
                                <span>
                                    @if (checkInDoctorCode.HasValue && checkInDoctorCode.Value > 0)
                                    {
                                        @($"Dr. {(doctors.FirstOrDefault(d => d.dcode == checkInDoctorCode.Value)?.name ?? "Selected")}")
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">Select Doctor...</span>
                                    }
                                </span>
                                <i class="bi bi-chevron-down dropdown-icon"></i>
                            </button>
                            @if (showCheckInDoctorDropdown)
                            {
                                <div class="doctor-selector-dropdown">
                                    @foreach (var doc in doctors)
                                    {
                                        var isSelected = checkInDoctorCode == doc.dcode;
                                        <div class="doctor-option-item @(isSelected ? "selected" : "")" 
                                             @onclick="() => { checkInDoctorCode = doc.dcode; showCheckInDoctorDropdown = false; }">
                                            <div class="doctor-availability-indicator available">
                                                <i class="bi bi-check-circle"></i>
                                            </div>
                                            <div class="doctor-option-content">
                                                <div class="doctor-option-name">Dr. @doc.name</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Test Name -->
                    @if (checkInInvestigation == "lab")
                    {
                        <div class="form-group">
                            <label class="field-uppercase-label">TEST NAME</label>
                            <input type="text" class="form-control-input" @bind="checkInTestName" placeholder="e.g. CBC Blood Test..." />
                        </div>
                    }
                    else if (checkInInvestigation == "scan")
                    {
                        <div class="form-group">
                            <label class="field-uppercase-label">TEST NAME</label>
                            <select class="form-control-select" @bind="checkInTestName">
                                <option value="">Select Scan Test</option>
                                <option value="ANC Scan (Antenatal Check-up Ultrasound)">ANC Scan (Antenatal Check-up Ultrasound)</option>
                                <option value="NT + FT Scan (Nuchal Translucency + First Trimester)">NT + FT Scan (Nuchal Translucency + First Trimester)</option>
                                <option value="Anomaly Scan (Level II / TIFFA)">Anomaly Scan (Level II / TIFFA)</option>
                                <option value="Growth Scan (Fetal Growth Ultrasound)">Growth Scan (Fetal Growth Ultrasound)</option>
                                <option value="USG Abd Scan (Abdominal Ultrasound)">USG Abd Scan (Abdominal Ultrasound)</option>
                            </select>
                        </div>
                    }

                    <!-- VIP Checkbox -->
                    <div class="form-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px; margin-top: 8px;">
                        <input type="checkbox" id="checkInIsVip" @bind="checkInIsVip" style="width: 16px; height: 16px; cursor: pointer;" />
                        <label for="checkInIsVip" style="font-weight: 600; color: #334155; font-size: 0.82rem; cursor: pointer; user-select: none; margin: 0;">Mark as VIP Patient</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => showCheckInModal = false">Cancel</button>
                <button type="button" class="btn-primary-indigo" @onclick="SubmitCheckIn">Confirm Check-in</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = false;
    private string checkInSearchQuery = "";
    private bool showNewPatientModal = false;
    private bool showSearchDropdown = false;
    private bool isSearchPerformed = false;

    private bool showCheckInModal = false;
    private bool showCheckInDoctorDropdown = false;
    private int? checkInDoctorCode;
    private string checkInInvestigation = "doctor";
    private string checkInInvestigation2 = "";
    private string checkInInvestigation3 = "";
    private string checkInTestName = "";
    private bool checkInIsVip = false;

    private string TenantCode = "";
    private string AuthToken = "";

    private List<CustomerModel> allCustomers = new();
    private List<CustomerModel> matchingCustomers = new();
    private CustomerModel? selectedCustomer = null;
    private CustomerModel? editingCustomer = null;

    private List<NewPatientRegistration.DoctorModel> doctors = new();
    private List<VitalsModel> recentCheckIns = new();
    private string tableSearchQuery = "";
    private DateTime selectedDate = DateTime.UtcNow.ToIndianTime().Date;

    private IEnumerable<VitalsModel> FilteredRecentCheckIns
    {
        get
        {
            if (recentCheckIns == null) return Enumerable.Empty<VitalsModel>();
            if (string.IsNullOrWhiteSpace(tableSearchQuery)) return recentCheckIns;

            var q = tableSearchQuery.Trim();

            return recentCheckIns.Where(item =>
            {
                var idMatch = !string.IsNullOrEmpty(item.custcode) && item.custcode.Contains(q, StringComparison.OrdinalIgnoreCase);
                var nameMatch = !string.IsNullOrEmpty(item.patient_name) && item.patient_name.Contains(q, StringComparison.OrdinalIgnoreCase);
                
                var phone = GetMobileNo(item.custcode);
                var phoneMatch = !string.IsNullOrEmpty(phone) && phone.Contains(q);

                return idMatch || nameMatch || phoneMatch;
            });
        }
    }

    protected override void OnInitialized()
    {
        var uri = NavigationManager.Uri;
        if (uri.Contains("openRegister=true"))
        {
            editingCustomer = null;
            showNewPatientModal = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            StateHasChanged();
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : TenantState.TenantCode ?? "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : TenantState.AuthToken ?? "";

                await LoadCustomersAsync();

                // Load Doctors list
                var rawDocs = await DoctorService.GetDoctorsAsync();
                doctors = rawDocs.Select(d => new NewPatientRegistration.DoctorModel
                {
                    dcode = d.dcode,
                    name = !string.IsNullOrWhiteSpace(d.name) ? d.name : (!string.IsNullOrWhiteSpace(d.doctorfullname) ? d.doctorfullname : (!string.IsNullOrWhiteSpace(d.shortname) ? d.shortname : $"Doctor {d.dcode}"))
                }).ToList();

                // Load Vitals list
                await LoadRecentCheckInsAsync();

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[ReceptionPortal] Init error: {ex.Message}");
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadRecentCheckInsAsync()
    {
        try
        {
            var list = await VitalsService.GetVitalsAsync();
            recentCheckIns = list
                .Where(x => x.entered_date.ToIndianTime().Date == selectedDate.Date &&
                            (string.IsNullOrEmpty(TenantCode) || string.Equals(x.tenant_code, TenantCode, StringComparison.OrdinalIgnoreCase)))
                .OrderByDescending(x => x.entered_date)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ReceptionPortal] Error loading recent check-ins: {ex.Message}");
        }
    }

    private string GetMobileNo(string? custcode)
    {
        if (string.IsNullOrWhiteSpace(custcode)) return "-";
        var cleanCustCode = custcode.Replace("PID-", "", StringComparison.OrdinalIgnoreCase);
        var cust = allCustomers.FirstOrDefault(x => 
            x.custcode == custcode || 
            x.tenantcustcode == custcode || 
            x.custid.ToString() == custcode ||
            x.custcode == cleanCustCode ||
            x.tenantcustcode == cleanCustCode ||
            x.custid.ToString() == cleanCustCode);
        return cust?.mobile ?? cust?.phone ?? "-";
    }

    private string GetPatientName(VitalsModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.patient_name) && item.patient_name != "-")
        {
            return item.patient_name;
        }
        if (string.IsNullOrWhiteSpace(item.custcode)) return "-";
        var cleanCustCode = item.custcode.Replace("PID-", "", StringComparison.OrdinalIgnoreCase);
        var cust = allCustomers.FirstOrDefault(x => 
            x.custcode == item.custcode || 
            x.tenantcustcode == item.custcode || 
            x.custid.ToString() == item.custcode ||
            x.custcode == cleanCustCode ||
            x.tenantcustcode == cleanCustCode ||
            x.custid.ToString() == cleanCustCode);
        if (cust != null)
        {
            return string.IsNullOrWhiteSpace(cust.namewithinitials) ? cust.name : cust.namewithinitials;
        }
        return "-";
    }

    private string GetDoctorName(VitalsModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.doctor_name))
        {
            return item.doctor_name;
        }
        if (item.dcode.HasValue && item.dcode.Value > 0)
        {
            var doc = doctors.FirstOrDefault(d => d.dcode == item.dcode.Value);
            return doc?.name ?? "";
        }
        return "";
    }

    private string GetDoctorSlotStatus(VitalsModel item)
    {
        if (item == null) return "waiting";

        // Check if any slot is doctor and has a status
        if (string.Equals(item.in1, "doctor", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.in1_status)) return item.in1_status;
        if (string.Equals(item.in2, "doctor", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.in2_status)) return item.in2_status;
        if (string.Equals(item.in3, "doctor", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.in3_status)) return item.in3_status;
        if (string.Equals(item.in4, "doctor", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.in4_status)) return item.in4_status;
        if (string.Equals(item.in5, "doctor", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.in5_status)) return item.in5_status;

        // Fallback to item.status or first available slot status or waiting
        var fallback = item.status;
        if (string.IsNullOrWhiteSpace(fallback))
        {
            fallback = new[] { item.in1_status, item.in2_status, item.in3_status, item.in4_status, item.in5_status }
                .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s)) ?? "waiting";
        }
        return fallback;
    }

    private string GetDisplayStatus(VitalsModel item)
    {
        var rawStatus = GetDoctorSlotStatus(item);

        return (rawStatus.ToLower().Trim()) switch
        {
            "waiting" or "waiting_for_test" or "waiting for test" => "Waiting",
            "up_next" or "up-next" or "up next" => "Up-next",
            "in_consultation" or "consultation" => "Consultation",
            "on_going" or "on-going" or "on going" => "On going",
            "completed" => "Completed",
            "report_received" or "report received" => "Report Received",
            "check_in" or "check in" => "Check In",
            "check_out" or "check out" => "Check Out",
            _ => string.IsNullOrWhiteSpace(rawStatus) ? "Waiting" : rawStatus.Replace("_", " ")
        };
    }

    private string GetStatusClass(VitalsModel item)
    {
        var rawStatus = GetDoctorSlotStatus(item);

        return (rawStatus.ToLower().Trim()) switch
        {
            "waiting" or "waiting_for_test" or "waiting for test" => "waiting",
            "up_next" or "up-next" or "up next" => "upnext",
            "in_consultation" or "consultation" => "consultation",
            "on_going" or "on-going" or "on going" => "upnext",
            "completed" => "completed",
            "report_received" or "report received" => "received",
            "pending" => "pending",
            "cancelled" or "cancel" => "cancelled",
            _ => "waiting"
        };
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareUrl");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Remove("tenant_code");
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            using var client = CreateClient();
            HttpResponseMessage? response = null;

            // 1. Try api/Customer/get
            try
            {
                response = await client.GetAsync("api/Customer/get");
                if (!response.IsSuccessStatusCode)
                {
                    response = await client.GetAsync("Customer/get");
                }
            }
            catch { }

            // 2. Try customer/getcus (primary endpoint used in PatientMaster)
            if (response == null || !response.IsSuccessStatusCode)
            {
                try
                {
                    response = await client.GetAsync("customer/getcus");
                    if (!response.IsSuccessStatusCode)
                    {
                        response = await client.GetAsync("api/Customer/getcus");
                    }
                }
                catch { }
            }

            // 3. Try Customer/partition
            if (response == null || !response.IsSuccessStatusCode)
            {
                try
                {
                    response = await client.GetAsync("Customer/partition?pagenumber=1&pagesize=1000");
                    if (!response.IsSuccessStatusCode)
                    {
                        response = await client.GetAsync("api/Customer/partition?pagenumber=1&pagesize=1000");
                    }
                }
                catch { }
            }

            if (response != null && response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrWhiteSpace(jsonStr))
                {
                    var list = JsonConvert.DeserializeObject<List<CustomerModel>>(jsonStr);
                    if (list != null)
                    {
                        allCustomers = list
                            .Where(x => string.IsNullOrEmpty(TenantCode) || string.Equals(x.tenant_code, TenantCode, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                        Console.WriteLine($"[ReceptionPortal] Loaded {allCustomers.Count} customers.");
                        if (selectedCustomer != null)
                        {
                            var updated = allCustomers.FirstOrDefault(x => x.custid == selectedCustomer.custid);
                            if (updated != null) selectedCustomer = updated;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ReceptionPortal] Error loading customers: {ex.Message}");
        }
    }

    private void OpenNewPatientModal()
    {
        editingCustomer = null;
        showNewPatientModal = true;
    }

    private void HandleModalClose()
    {
        showNewPatientModal = false;
        editingCustomer = null;
    }

    private async Task OnInputFocus()
    {
        if (!allCustomers.Any())
        {
            await LoadCustomersAsync();
        }
        showSearchDropdown = matchingCustomers.Any();
    }

    private async Task HandleCheckInKeyUp(KeyboardEventArgs e)
    {
        isSearchPerformed = true;

        if (!allCustomers.Any())
        {
            await LoadCustomersAsync();
        }

        if (string.IsNullOrWhiteSpace(checkInSearchQuery))
        {
            matchingCustomers.Clear();
            showSearchDropdown = false;
            selectedCustomer = null;
            return;
        }

        var query = checkInSearchQuery.Trim();
        matchingCustomers = allCustomers.Where(c =>
            (!string.IsNullOrEmpty(c.custcode) && c.custcode.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.tenantcustcode) && c.tenantcustcode.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.customermanualcode) && c.customermanualcode.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            ("PID-" + c.custid).Contains(query, StringComparison.OrdinalIgnoreCase) ||
            (c.custid.ToString().Contains(query)) ||
            (!string.IsNullOrEmpty(c.name) && c.name.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.namewithinitials) && c.namewithinitials.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.mobile) && c.mobile.Contains(query)) ||
            (!string.IsNullOrEmpty(c.phone) && c.phone.Contains(query))
        ).Take(8).ToList();

        showSearchDropdown = matchingCustomers.Any();

        if (e.Key == "Enter")
        {
            await ValidatePatient();
        }
    }

    private void SelectCustomer(CustomerModel customer)
    {
        selectedCustomer = customer;
        checkInSearchQuery = !string.IsNullOrWhiteSpace(customer.tenantcustcode) ? customer.tenantcustcode : (string.IsNullOrWhiteSpace(customer.custcode) ? $"PID-{customer.custid}" : customer.custcode);
        showSearchDropdown = false;
        isSearchPerformed = true;
    }

    private async Task ValidatePatient()
    {
        showSearchDropdown = false;
        isSearchPerformed = true;

        if (!allCustomers.Any())
        {
            await LoadCustomersAsync();
        }

        if (string.IsNullOrWhiteSpace(checkInSearchQuery))
        {
            Toast.ShowError("Please enter MRN No, Name, or Mobile No to search.");
            return;
        }

        var query = checkInSearchQuery.Trim();
        var found = allCustomers.FirstOrDefault(c =>
            (!string.IsNullOrEmpty(c.custcode) && c.custcode.Equals(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.tenantcustcode) && c.tenantcustcode.Equals(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.customermanualcode) && c.customermanualcode.Equals(query, StringComparison.OrdinalIgnoreCase)) ||
            ("PID-" + c.custid).Equals(query, StringComparison.OrdinalIgnoreCase) ||
            (c.custid.ToString() == query) ||
            (!string.IsNullOrEmpty(c.mobile) && c.mobile.Equals(query)) ||
            (!string.IsNullOrEmpty(c.phone) && c.phone.Equals(query)) ||
            (!string.IsNullOrEmpty(c.name) && c.name.Equals(query, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.namewithinitials) && c.namewithinitials.Equals(query, StringComparison.OrdinalIgnoreCase))
        );

        if (found == null)
        {
            found = allCustomers.FirstOrDefault(c =>
                (!string.IsNullOrEmpty(c.custcode) && c.custcode.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.tenantcustcode) && c.tenantcustcode.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
                ("PID-" + c.custid).Contains(query, StringComparison.OrdinalIgnoreCase) ||
                (c.custid.ToString().Contains(query)) ||
                (!string.IsNullOrEmpty(c.name) && c.name.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.namewithinitials) && c.namewithinitials.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.mobile) && c.mobile.Contains(query)) ||
                (!string.IsNullOrEmpty(c.phone) && c.phone.Contains(query))
            );
        }

        selectedCustomer = found;
        if (selectedCustomer != null)
        {
            Toast.ShowSuccess($"Patient Found: {(string.IsNullOrWhiteSpace(selectedCustomer.namewithinitials) ? selectedCustomer.name : selectedCustomer.namewithinitials)}");
        }
        else
        {
            Toast.ShowError("No patient record found matching your query.");
        }
    }

    private void ConfirmCheckIn(bool isNewRegistration = false)
    {
        if (selectedCustomer == null)
        {
            Toast.ShowError("No patient selected for check-in.");
            return;
        }

        // Auto-choose Preferred Doctor if selected during registration, else set to null
        checkInDoctorCode = (selectedCustomer.dcode.HasValue && selectedCustomer.dcode.Value > 0) 
            ? selectedCustomer.dcode.Value 
            : null;

        checkInInvestigation = "doctor";
        checkInInvestigation2 = "";
        checkInInvestigation3 = "";
        checkInTestName = "";
        checkInIsVip = false;
        showCheckInModal = true;
    }

    private async Task SubmitCheckIn()
    {
        if (selectedCustomer == null) return;

        var name = string.IsNullOrWhiteSpace(selectedCustomer.namewithinitials) ? selectedCustomer.name : selectedCustomer.namewithinitials;
        var mrn = !string.IsNullOrWhiteSpace(selectedCustomer.tenantcustcode) 
            ? selectedCustomer.tenantcustcode 
            : (string.IsNullOrWhiteSpace(selectedCustomer.custcode) ? $"PID-{selectedCustomer.custid}" : selectedCustomer.custcode);

        if (checkInDoctorCode.HasValue && checkInDoctorCode.Value > 0)
        {
            try
            {
                var allVitals = await VitalsService.GetVitalsAsync();
                var today = DateTime.Now.Date;
                var existing = allVitals.FirstOrDefault(x =>
                    x.dcode == checkInDoctorCode.Value &&
                    x.entered_date.Date == today &&
                    (
                        string.Equals(x.custcode, mrn, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(x.custcode, selectedCustomer.custcode, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(x.custcode, selectedCustomer.tenantcustcode, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(x.custcode, $"PID-{selectedCustomer.custid}", StringComparison.OrdinalIgnoreCase)
                    )
                );

                if (existing != null)
                {
                    var docName = doctors.FirstOrDefault(d => d.dcode == checkInDoctorCode.Value)?.name ?? $"Doctor ID {checkInDoctorCode.Value}";
                    var registeredTime = existing.entered_date.ToIndianTime().ToString("yyyy-MM-dd HH:mm");
                    Toast.ShowError($"The patient is already registered on {registeredTime} for {docName}.");
                    return;
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[ReceptionPortal] Duplicate check error: {ex.Message}");
            }
        }

        var newVital = new VitalsModel
        {
            custcode = mrn,
            patient_name = name,
            dcode = checkInDoctorCode,
            in1 = checkInInvestigation,
            in2 = string.IsNullOrWhiteSpace(checkInInvestigation2) ? null : checkInInvestigation2,
            in3 = string.IsNullOrWhiteSpace(checkInInvestigation3) ? null : checkInInvestigation3,
            test_name = checkInTestName,
            status = "waiting_for_test",
            is_vip = checkInIsVip,
            entered_date = DateTime.Now,
            arrival_time = TimeOnly.FromDateTime(DateTime.Now),
            usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1,
            computercode = 1
        };

        var success = await VitalsService.InsertVitalAsync(newVital);
        if (success)
        {
            Toast.ShowSuccess($"Check-in confirmed for {name} ({mrn})");
            showCheckInModal = false;
            selectedCustomer = null;
            checkInSearchQuery = "";
            isSearchPerformed = false;
            await LoadRecentCheckInsAsync();
            StateHasChanged();
        }
        else
        {
            Toast.ShowError("Failed to confirm check-in.");
        }
    }

    private void ModifyProfile()
    {
        if (selectedCustomer != null)
        {
            editingCustomer = selectedCustomer;
            showNewPatientModal = true;
        }
    }

    private async Task HandlePatientSaved(CustomerModel savedPatient)
    {
        bool isNewPatientRegistration = (editingCustomer == null);

        showNewPatientModal = false;
        editingCustomer = null;

        if (savedPatient != null)
        {
            // Instantly select the saved patient and display check-in modal
            selectedCustomer = savedPatient;
            checkInSearchQuery = !string.IsNullOrWhiteSpace(savedPatient.tenantcustcode) ? savedPatient.tenantcustcode : (string.IsNullOrWhiteSpace(savedPatient.custcode) ? $"PID-{savedPatient.custid}" : savedPatient.custcode);
            isSearchPerformed = true;

            if (isNewPatientRegistration)
            {
                ConfirmCheckIn(isNewRegistration: true);
            }
            StateHasChanged();
        }

        // Reload customers list asynchronously in background without blocking check-in modal display
        _ = Task.Run(async () =>
        {
            await LoadCustomersAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "P";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[parts.Length - 1][0]}".ToUpper();
    }

    private string GetFormattedAddress(CustomerModel c)
    {
        var list = new List<string>();
        if (!string.IsNullOrWhiteSpace(c.street)) list.Add(c.street.Trim());
        if (!string.IsNullOrWhiteSpace(c.city)) list.Add(c.city.Trim());
        if (!string.IsNullOrWhiteSpace(c.zipcode)) list.Add(c.zipcode.Trim());
        return list.Any() ? string.Join(", ", list) : "No address provided";
    }

    private string GetMrn(CustomerModel? c)
    {
        if (c == null) return "-";
        if (!string.IsNullOrWhiteSpace(c.tenantcustcode)) return c.tenantcustcode;
        if (!string.IsNullOrWhiteSpace(c.custcode)) return c.custcode;
        return $"PID-{c.custid}";
    }
