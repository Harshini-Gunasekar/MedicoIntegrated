    private void ToggleDashboardSection() => isDashboardSectionOpen = !isDashboardSectionOpen;
    private void ToggleOpPortalSection() => isOpPortalSectionOpen = !isOpPortalSectionOpen;
    private void ToggleIpPortalSection() => isIpPortalSectionOpen = !isIpPortalSectionOpen;
    private void ToggleOtPortalSection() => isOtPortalSectionOpen = !isOtPortalSectionOpen;
