    private bool IsAnonymousPath(string path)
    {
        path = NormalizePath(path);
        return string.IsNullOrEmpty(path) || 
               path == "login" || 
               path == "user-login" || 
               path == "admin-login" ||
               path == "forgot-password" ||
               path == "register" ||
               path == "user-register" ||
               path == "token-display";
    }

    private static bool IsAdminRole(string? role)
    {
        if (string.IsNullOrEmpty(role)) return false;
        return string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Super Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Power User", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "PowerUser", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Tenant", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAdmin()
    {
        var role = TenantState.UserData?.Role;
        if (!string.IsNullOrEmpty(role))
        {
            bool isAdm = IsAdminRole(role);
            _isAdminSession = isAdm;
            return isAdm;
        }

        if (!string.IsNullOrEmpty(displayUserRole))
        {
            bool isAdm = IsAdminRole(displayUserRole);
            _isAdminSession = isAdm;
            return isAdm;
        }

        var name = TenantState.UserData?.UserName;
        if (string.IsNullOrEmpty(name))
            name = displayUserName;

        if (string.Equals(name, "admin", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(name, "administrator", StringComparison.OrdinalIgnoreCase))
        {
            _isAdminSession = true;
            return true;
        }

        if (string.IsNullOrEmpty(role))
        {
            // Fallback: decode from JWT claim
            var token = TenantState.AuthToken;
            if (!string.IsNullOrEmpty(token))
            {
                try
                {
                    var segments = token.Split('.');
                    if (segments.Length >= 2)
                    {
                        var payload = segments[1];
                        switch (payload.Length % 4)
                        {
                            case 2: payload += "=="; break;
                            case 3: payload += "="; break;
                        }
                        var jsonBytes = Convert.FromBase64String(payload);
                        var claimsDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                        if (claimsDict != null)
                        {
                            object? rVal = null;
                            if (claimsDict.TryGetValue("role", out rVal) ||
                                claimsDict.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                                role = rVal?.ToString();
                        }
                    }
                }
                catch { }
            }
        }

        bool result = IsAdminRole(role);
        _isAdminSession = result;
        return result;
    }

    private static string NormalizeRightsKey(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;
        return s.Replace(" ", "").Replace("_", "").Replace("-", "").ToLowerInvariant();
    }

