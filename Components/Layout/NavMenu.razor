    private async Task PromptOpenShiftInNav()
    {
        try
        {
            int resolvedBhCode = 1;
            if (TenantState.BranchCode.HasValue && TenantState.BranchCode.Value > 0)
            {
                resolvedBhCode = TenantState.BranchCode.Value;
            }
            else
            {
                try
                {
                    var bhRes = await _sessionStorage.GetAsync<string>("bhcode");
                    if (bhRes.Success && int.TryParse(bhRes.Value, out int sBh) && sBh > 0)
                    {
                        resolvedBhCode = sBh;
                    }
                }
                catch { }
            }

            int resolvedCntCode = 1;
            if (TenantState.CounterCode.HasValue && TenantState.CounterCode.Value > 0)
            {
                resolvedCntCode = TenantState.CounterCode.Value;
            }
            else
            {
                try
                {
                    var cntRes = await _sessionStorage.GetAsync<string>("cntcode");
                    if (cntRes.Success && int.TryParse(cntRes.Value, out int sCnt) && sCnt > 0)
                    {
                        resolvedCntCode = sCnt;
                    }
                }
                catch { }
            }

            string resolvedBranchName = "Main branch";
            string resolvedCounterName = $"Counter {resolvedCntCode}";
            try
            {
                var counters = await CounterMasterService.GetCountersAsync();
                if (counters != null && counters.Any())
                {
                    var cnt = counters.FirstOrDefault(c => (int)c.cntcode == resolvedCntCode && (c.bhcode == resolvedBhCode || c.bhcode == 0 || c.bhcode == null))
                              ?? counters.FirstOrDefault(c => (int)c.cntcode == resolvedCntCode)
                              ?? counters.FirstOrDefault(c => c.bhcode == resolvedBhCode);

                    if (cnt != null)
                    {
                        resolvedCntCode = (int)cnt.cntcode;
                        if (!string.IsNullOrWhiteSpace(cnt.name))
                        {
                            resolvedCounterName = cnt.name;
                        }
                    }
                }
            }
            catch { }

            navPromptBhCode = resolvedBhCode;
            navPromptCntCode = resolvedCntCode;
            navPromptBranchName = resolvedBranchName;
            navPromptCounterName = resolvedCounterName;
            showNavOpenShiftModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error preparing open shift modal in nav: {ex.Message}");
            showNavOpenShiftModal = true;
            StateHasChanged();
        }
    }

