    private string NormalizePath(string path)
    {
        path = path.Trim().ToLower();
        if (path.StartsWith("/"))
        {
            path = path.Substring(1);
        }
        int queryIndex = path.IndexOf('?');
        if (queryIndex >= 0)
        {
            path = path.Substring(0, queryIndex);
        }
        return path;
    }

    private bool CheckPathPermission(string path)
    {
        path = NormalizePath(path);

        if (IsAnonymousPath(path))
        {
            return true;
        }

        // Administrator bypass
        if (IsAdmin())
        {
            return true;
        }

        if (!TenantState.IsAuthenticated)
        {
            return false;
        }

        switch (path)
        {
            case "home":
            case "dashboard":
                return true;

            // Reception & OP Portal
            case "op-dashboard":
                return HasRight("OP Portal", "OP Dashboard");
            case "booking/reception":
                return HasRight("OP Portal", "Patient Check-in");
            case "booking/customer":
                return HasRight("OP Portal", "Patient Check-in") || HasRight("OP Portal", "Outpatient Visiting");
            case "booking/outpatient":
                return HasRight("OP Portal", "Outpatient Visiting");
            case "booking/patient":
            case "patientmaster":
                return HasRight("OP Portal", "Patient Master");
            case "country-master":
                return HasRight("OP Portal", "Country Master");
            case "state-master":
                return HasRight("OP Portal", "State Master");
            case "city-master":
