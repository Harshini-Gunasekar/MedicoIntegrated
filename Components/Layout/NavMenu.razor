@using Newtonsoft.Json
@using Booking.Helpers
@using SharedComponents.Rcl.Models
@using Booking.Models
@using Booking.Services
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.ToastService Toast
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.CounterMasterService CounterMasterService
@inject Booking.Services.LabSettingService LabSettingService
@inject Booking.Services.RoleMasterService RoleService
@inject LabCare.Services.UserService UserService
@inject IJSRuntime JS
@implements IDisposable

<div class="sidebar-overlay @(IsSidebarVisible ? "show" : "")" @onclick="ToggleSidebar"></div>

<aside class="sidebar @(isSidebarCollapsed ? "collapsed" : "") @(IsSidebarVisible ? "show" : "")">
    <div class="sidebar-header">
        <div class="logo-container" style="gap: 0.65rem;">
            <img src="images/logo.png" style="width: 30px; height: 30px; border-radius: 8px;" alt="Medico Logo" />
            <div>
                <div class="logo-title">MEDICO</div>
                <div class="logo-subtitle">Portal</div>
            </div>
        </div>
        <div class="desktop-toggle" @onclick="ToggleCollapse" title="@(isSidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
            @if (isSidebarCollapsed)
            {
                <i class="bi bi-chevron-right"></i>
            }
            else
            {
                <i class="bi bi-chevron-left"></i>
            }
        </div>
    </div>

    <div class="sidebar-search-container">
        <div class="sidebar-search-wrapper">
            <i class="bi bi-search sidebar-search-icon"></i>
            <input type="text" class="sidebar-search-input" placeholder="Search menu items..." @bind="menuSearchQuery" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(menuSearchQuery))
            {
                <button class="sidebar-search-clear" type="button" @onclick="ClearMenuSearch" title="Clear search">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            }
            else
            {
                <span class="search-shortcut-badge">⌘K</span>
            }
        </div>
    </div>
    
    <div class="sidebar-menu">
        @if (!string.IsNullOrWhiteSpace(menuSearchQuery))
        {
            <!-- search results block unchanged -->
            <div class="sidebar-search-results">
                @{
                    var matches = GetFilteredMenuItems().ToList();
                }
                <div class="d-flex justify-content-between align-items-center px-1 mb-2">
                    <span class="sidebar-section-title p-0" style="font-size: 0.72rem;">SEARCH RESULTS</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill fw-bold" style="font-size: 0.72rem;">@matches.Count FOUND</span>
                </div>
                @if (!matches.Any())
                {
                    <div class="text-muted p-3 text-center rounded-3 bg-white border" style="font-size: 0.8rem;">
                        <i class="bi bi-search d-block mb-1 text-secondary opacity-50" style="font-size: 1.1rem;"></i>
                        No pages found matching "<strong>@menuSearchQuery</strong>"
                    </div>
                }
                else
                {
                    @foreach (var item in matches)
                    {
                        <NavLink href="@item.Href" class="nav-item sidebar-search-item d-flex justify-content-between align-items-center text-decoration-none" @onclick="OnSearchItemClick">
                            <span class="d-flex align-items-center gap-2">
                                <i class="bi @item.Icon text-primary opacity-75"></i>
                                <span style="font-size: 0.8rem; font-weight: 600; color: #1e293b;">@item.Title</span>
                            </span>
                            <span class="sidebar-search-badge">@item.Category</span>
                        </NavLink>
                    }
                }
            </div>
        }
        else if (!_menuReady)
        {
            @* Skeleton loader shown while session is being restored after a page reload *@
            <div class="sidebar-skeleton" style="padding: 0.5rem 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
                @for (int i = 0; i < 7; i++)
                {
                    <div style="height: 36px; border-radius: 8px; background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite;"></div>
                }
            </div>
            <style>
                @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
            </style>
        }
        else
        {
            <!-- DASHBOARD SECTION -->
            <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleDashboardSection">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-grid-1x2-fill section-icon section-icon-dashboard"></i>
                    <span>Dashboard</span>
                </span>
                <i class="bi bi-chevron-down dropdown-arrow-icon @(isDashboardSectionOpen ? "open" : "")"></i>
            </div>
            @if (isDashboardSectionOpen)
            {
                <nav>
                    <NavLink href="/home" class="nav-item" @onclick="CloseSidebar" title="Overview of Medico Portal metrics, bookings, and activities">
                        <i class="bi bi-grid-fill"></i>
                        <span>Dashboard</span>
                    </NavLink>
                </nav>
            }

            <!-- OP PORTAL SECTION -->
            @if (HasMainModule("OP Portal"))
            {
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleOpPortalSection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-heart-pulse-fill section-icon section-icon-op"></i>
                        <span>OP Portal</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isOpPortalSectionOpen ? "open" : "")"></i>
                </div>
                @if (isOpPortalSectionOpen)
                {
                    <nav>
                        @if (HasRight("OP Portal", "OP Dashboard"))
                        {
                            <NavLink href="/op-dashboard" class="nav-item" @onclick="CloseSidebar" title="OP Portal Dashboard & Queue Metrics">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>OP Dashboard</span>
                            </NavLink>
                        }
                        @if (HasRight("OP Portal", "Patient Check-in"))
                        {
                            <NavLink href="/booking/reception" class="nav-item" @onclick="CloseSidebar" title="Manage patient arrivals, walk-ins, and appointments">
                                <i class="bi bi-people-fill"></i>
                                <span>Patient Check-In</span>
                            </NavLink>
                        }
                        @if (HasRight("OP Portal", "Outpatient Visiting"))
                        {
                            <NavLink href="/booking/outpatient" class="nav-item" @onclick="CloseSidebar" title="Track and manage outpatient consultations and queues">
                                <i class="bi bi-hospital"></i>
                                <span>Outpatient Visiting</span>
                            </NavLink>
                        }
                        @if (HasRight("OP Portal", "OP Token Display"))
                        {
                            <NavLink href="/op-token-display" class="nav-item" @onclick="CloseSidebar" title="Live Outpatient Visiting Token Display Signage">
                                <i class="bi bi-display"></i>
                                <span>OP Token Display</span>
                            </NavLink>
                        }
                        @if (HasRight("OP Portal", "Slot Master"))
                        {
                            <NavLink href="/slots" class="nav-item" @onclick="CloseSidebar" title="Configure and schedule doctor availability slots">
                                <i class="bi bi-calendar-range"></i>
                                <span>Slot Master</span>
                            </NavLink>
                        }

                        @if (HasRight("OP Portal", "Patient Master") || HasRight("OP Portal", "Country Master") || HasRight("OP Portal", "State Master") || HasRight("OP Portal", "City Master") || HasRight("OP Portal", "Area Master") || HasRight("OP Portal", "Service Type Master"))
                        {
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleReceptionMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>Reception Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isReceptionMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isReceptionMastersOpen)
                            {
                                <div class="nav-submenu">
                                    @if (HasRight("OP Portal", "Patient Master"))
                                    {
                                        <NavLink href="/patientmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Manage central patient registrations and demographics">
                                            <span>Patient Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("OP Portal", "Country Master"))
                                    {
                                        <NavLink href="/country-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure country records">
                                            <span>Country Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("OP Portal", "State Master"))
                                    {
                                        <NavLink href="/state-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure state records">
                                            <span>State Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("OP Portal", "City Master"))
                                    {
                                        <NavLink href="/city-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure city records">
                                            <span>City Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("OP Portal", "Area Master"))
                                    {
                                        <NavLink href="/area-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure geographical areas and pin codes">
                                            <span>Area Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("OP Portal", "Service Type Master"))
                                    {
                                        <NavLink href="/service-type-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure Service type records">
                                            <span>Service Type Master</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        }
                    </nav>
                }
            }

            <!-- IP PORTAL SECTION -->
            @if (HasMainModule("IP Portal"))
            {
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleIpPortalSection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-hospital-fill section-icon section-icon-ip"></i>
                        <span>IP Portal</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isIpPortalSectionOpen ? "open" : "")"></i>
                </div>
                @if (isIpPortalSectionOpen)
                {
                    <nav>
                        @if (HasRight("IP Portal", "IP Dashboard"))
                        {
                            <NavLink href="/ip-dashboard" class="nav-item" @onclick="CloseSidebar" title="IP Portal Dashboard & Bed Statistics">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>IP Dashboard</span>
                            </NavLink>
                        }
                        @if (HasRight("IP Portal", "IP Registration"))
                        {
                            <NavLink href="/booking/ip-registration" class="nav-item" @onclick="CloseSidebar" title="Inpatient IPD Registration">
                                <i class="bi bi-hospital"></i>
                                <span>IP Registration</span>
                            </NavLink>
                        }
                        @if (HasRight("IP Portal", "Available Beds"))
                        {
                            <NavLink href="/booking/available-beds" class="nav-item" @onclick="CloseSidebar" title="Available Beds Status">
                                <i class="bi bi-door-open"></i>
                                <span>Available Beds</span>
                            </NavLink>
                        }
                        @if (HasRight("IP Portal", "Bed Transfer"))
                        {
                            <NavLink href="/bed-transfer-master" class="nav-item" @onclick="CloseSidebar" title="Inpatient Bed Transfer">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Bed Transfer</span>
                            </NavLink>
                        }
                        @if (HasRight("IP Portal", "Discharge Summary"))
                        {
                            <NavLink href="/discharge-summary" class="nav-item" @onclick="CloseSidebar" title="Discharge Summary">
                                <i class="bi bi-file-earmark-medical"></i>
                                <span>Discharge Summary</span>
                            </NavLink>
                        }
                        @if (HasRight("IP Portal", "Nurse Notes"))
                        {
                            <NavLink href="/ip/nurse-notes" class="nav-item" @onclick="CloseSidebar" title="Nurse Notes — IP Nursing Documentation">
                                <i class="bi bi-clipboard2-pulse-fill"></i>
                                <span>Nurse Notes</span>
                            </NavLink>
                        }

                        <!-- IPD Masters Dropdown -->
                        @if (HasRight("IP Portal", "Bed Master") || HasRight("IP Portal", "Ward Master") || HasRight("IP Portal", "Room Type Master") || HasRight("IP Portal", "Floor Master") || HasRight("IP Portal", "Block Master") || HasRight("IP Portal", "Nurse Master") || HasRight("IP Portal", "IO Particulars Master") || HasRight("IP Portal", "Service Name Master") || HasRight("IP Portal", "Schedule Type Master") || HasRight("IP Portal", "Discharge Template Master"))
                        {
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleIpdMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>IP Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isIpdMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isIpdMastersOpen)
                            {
                                <div class="nav-submenu">
                                    @if (HasRight("IP Portal", "Bed Master"))
                                    {
                                        <NavLink href="/bed-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Bed Master">
                                            <span>Bed Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Ward Master"))
                                    {
                                        <NavLink href="/ward-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Ward Master">
                                            <span>Ward Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Room Type Master"))
                                    {
                                        <NavLink href="/room-type-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Room Type Master">
                                            <span>Room Type Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Floor Master"))
                                    {
                                        <NavLink href="/floor-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Floor Master">
                                            <span>Floor Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Block Master"))
                                    {
                                        <NavLink href="/block-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Block Master">
                                            <span>Block Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Nurse Master"))
                                    {
                                        <NavLink href="/nurse-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Nurse Master">
                                            <span>Nurse Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "IO Particulars Master"))
                                    {
                                        <NavLink href="/io-particulars" class="nav-submenu-item" @onclick="CloseSidebar" title="IO Particulars Master">
                                            <span>IO Particulars Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Service Name Master"))
                                    {
                                        <NavLink href="/service-name-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Service Name Master">
                                            <span>Service Name Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Schedule Type Master"))
                                    {
                                        <NavLink href="/schedule-type-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Schedule Type Master">
                                            <span>Schedule Type Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("IP Portal", "Discharge Template Master"))
                                    {
                                        <NavLink href="/summary-templates" class="nav-submenu-item" @onclick="CloseSidebar" title="Discharge Template Master">
                                            <span>Discharge Template Master</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        }
                    </nav>
                }
            }

            <!-- OT PORTAL (OPERATION THEATER) SECTION -->
            @if (HasMainModule("Operation Theatre"))
            {
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleOtPortalSection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-heart-pulse-fill section-icon section-icon-ot"></i>
                        <span>Operation Theater</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isOtPortalSectionOpen ? "open" : "")"></i>
                </div>
                @if (isOtPortalSectionOpen)
                {
                    <nav>
                        @if (HasRight("Operation Theatre", "OT Console"))
                        {
                            <NavLink href="/ot-console" class="nav-item" @onclick="CloseSidebar" title="OT Console — Surgical Episodes & Clinical Management">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>OT Console</span>
                            </NavLink>
                        }

                        @if (HasRight("Operation Theatre", "Available Theatre"))
                        {
                            <NavLink href="/ot-availability" class="nav-item" @onclick="CloseSidebar" title="Available Theaters — Real-time OT Suite Slot Availability">
                                <i class="bi bi-door-open-fill"></i>
                                <span>Available Theaters</span>
                            </NavLink>
                        }

                        <!-- OT Masters Dropdown -->
                        @if (HasRight("Operation Theatre", "Add OT") || HasRight("Operation Theatre", "Fee Categories"))
                        {
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleOtMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>OT Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isOtMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isOtMastersOpen)
                            {
                                <div class="nav-submenu">
                                    @if (HasRight("Operation Theatre", "Add OT"))
                                    {
                                        <NavLink href="/ot-master" class="nav-submenu-item" @onclick="CloseSidebar" title="OT Master — Operation Theater & Suites Directory">
                                            <span>Add OT</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("Operation Theatre", "Fee Categories"))
                                    {
                                        <NavLink href="/ot-fee-category" class="nav-submenu-item" @onclick="CloseSidebar" title="Fee Category Master — Doctor & Staff Fee Allocation Categories">
                                            <span>Fee Categories</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        }
                    </nav>
                }
            }

            <!-- BILLING PORTAL SECTION -->
            @if (HasMainModule("Billing Portal"))
            {
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleBillingPortalSection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card-2-front-fill section-icon section-icon-billing"></i>
                        <span>Billing Portal</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isBillingPortalSectionOpen ? "open" : "")"></i>
                </div>
                @if (isBillingPortalSectionOpen)
                {
                    <nav>
                        @if (HasRight("Billing Portal", "Billing Portal"))
                        {
                            <NavLink href="/billing" class="nav-item" @onclick="CloseSidebar" title="Process payments, billing counters, and print invoices">
                                <i class="bi bi-receipt"></i>
                                <span>Billing Portal</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Due Collection"))
                        {
                            <NavLink href="/due-collection" class="nav-item" @onclick="CloseSidebar" title="Manage pending due balances and patient statement ledger">
                                <i class="bi bi-cash-coin"></i>
                                <span>Due Collection</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Due Collection History"))
                        {
                            <NavLink href="/due-collection-history" class="nav-item" @onclick="CloseSidebar" title="View past collections and due receipt logs">
                                <i class="bi bi-clock-history"></i>
                                <span>Due Collection History</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Patient Advance"))
                        {
                            <NavLink href="/patient-advance-collection" class="nav-item" @onclick="CloseSidebar" title="Manage patient advance deposits, refunds, and advance ledger">
                                <i class="bi bi-piggy-bank"></i>
                                <span>Patient Advance</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Bill List"))
                        {
                            <NavLink href="/bills" class="nav-item" @onclick="CloseSidebar" title="Search, track, and manage all patient invoices and payments logs">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Bills List</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Bill Summary"))
                        {
                            <NavLink href="/billing-summary" class="nav-item" @onclick="CloseSidebar" title="Combined Patient Billing Summary & Statements">
                                <i class="bi bi-receipt-cutoff"></i>
                                <span>Billing Summary</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Reports"))
                        {
                            <NavLink href="/billing-reports" class="nav-item" @onclick="CloseSidebar" title="Billing Statements & Summary Reports">
                                <i class="bi bi-file-earmark-bar-graph"></i>
                                <span>Reports</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Cash Counter"))
                        {
                            <NavLink href="/cash-counter" class="nav-item" @onclick="CloseSidebar" title="View cash drawer history, shift balance audits, and cash logs">
                                <i class="bi bi-wallet2"></i>
                                <span>Cash Counter</span>
                            </NavLink>
                        }
                        @if (HasRight("Billing Portal", "Counter Shift"))
                        {
                            <NavLink href="/counter-shift" class="nav-item" @onclick="CloseSidebar" title="Manage billing counter shifts and balances">
                                <i class="bi bi-clock-history"></i>
                                <span>Counter Shift</span>
                            </NavLink>
                        }

                        <!-- Billing Masters Dropdown -->
                        @if (HasRight("Billing Portal", "Bill No Sequence") || HasRight("Billing Portal", "Fee Type Master") || HasRight("Billing Portal", "Counter Master") || HasRight("Billing Portal", "Paymode Master") || HasRight("Billing Portal", "Test Fee Master") || HasRight("Billing Portal", "Reimbursement Co"))
                        {
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleBillingMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>Billing Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isBillingMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isBillingMastersOpen)
                            {
                                <div class="nav-submenu">
                                    @if (HasRight("Billing Portal", "Bill No Sequence"))
                                    {
                                        <NavLink href="/billno-sequence" class="nav-submenu-item" @onclick="CloseSidebar" title="Bill No Sequence">
                                            <span>Bill No Sequence</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("Billing Portal", "Fee Type Master"))
                                    {
                                        <NavLink href="/feetype-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Fee Type Master">
                                            <span>Fee Type Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("Billing Portal", "Counter Master"))
                                    {
                                        <NavLink href="/counter-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Counter Master">
                                            <span>Counter Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("Billing Portal", "Paymode Master"))
                                    {
                                        <NavLink href="/paymode-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Paymode Master">
                                            <span>Paymode Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("Billing Portal", "Test Fee Master"))
                                    {
                                        <NavLink href="/test-fee-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Test Fee Master">
                                            <span>Test Fee Master</span>
                                        </NavLink>
                                    }
                                    @if (HasRight("Billing Portal", "Reimbursement Co"))
                                    {
                                        <NavLink href="/reimbursementcompanymaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Reimbursement Company">
                                            <span>Reimbursement Co</span>
