    public class SidebarMenuItemModel
    {
        public string Title { get; set; } = "";
        public string Href { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Category { get; set; } = "";
    }

    private IEnumerable<SidebarMenuItemModel> GetFilteredMenuItems()
    {
        if (string.IsNullOrWhiteSpace(menuSearchQuery)) return Enumerable.Empty<SidebarMenuItemModel>();
        var query = menuSearchQuery.Trim();
        return GetAllMenuItems()
            .Where(m => CheckPathPermission(m.Href))
            .Where(m => m.Title.Contains(query, StringComparison.OrdinalIgnoreCase) || m.Category.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

