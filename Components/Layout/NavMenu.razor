    private static HashSet<string> BuildAliasSet(string normalized, Dictionary<string, string[]> map)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { normalized };
        foreach (var (_, aliases) in map)
        {
            if (aliases.Contains(normalized, StringComparer.OrdinalIgnoreCase))
            {
                foreach (var a in aliases) set.Add(a);
                break;
            }
        }
        return set;
    }

    private bool CheckUserRightsForMainModule(string mainModule)
    {
        if (TenantState.UserRightsList == null || !TenantState.UserRightsList.Any()) return false;
        var norm = NormalizeRightsKey(mainModule);
        var set  = BuildAliasSet(norm, _deptAliases);
        set.Add(mainModule);

        bool found = TenantState.UserRightsList.Any(r =>
            (r.ToView || r.ToAdd || r.ToEdit || r.ToDelete || r.ToExport) &&
            (set.Contains(r.Department ?? "") || set.Contains(NormalizeRightsKey(r.Department))));
#if DEBUG
        if (!found && TenantState.UserRightsList.Any())
            Console.WriteLine($"[NavMenu/Dept MISS] '{mainModule}' → DB depts: " +
                string.Join(", ", TenantState.UserRightsList.Select(r => r.Department ?? "null").Distinct().OrderBy(x => x)));
#endif
        return found;
    }

    private bool CheckUserRightsForSubModule(string mainModule, string subModule)
    {
        if (TenantState.UserRightsList == null || !TenantState.UserRightsList.Any()) return false;
        if (!string.IsNullOrWhiteSpace(mainModule) && !HasMainModule(mainModule)) return false;

        var norm = NormalizeRightsKey(subModule);
        var set  = BuildAliasSet(norm, _moduleAliases);
        set.Add(subModule);
        set.Add(subModule.Replace(" ", "_"));
        set.Add(subModule.Replace(" ", ""));

        bool found = TenantState.UserRightsList.Any(r =>
            (r.ToView || r.ToAdd || r.ToEdit || r.ToDelete || r.ToExport) &&
            (set.Contains(r.ModuleName ?? "") || set.Contains(NormalizeRightsKey(r.ModuleName))));
#if DEBUG
        if (!found && TenantState.UserRightsList.Any(r => r.ToView || r.ToAdd || r.ToEdit || r.ToDelete || r.ToExport))
            Console.WriteLine($"[NavMenu/Mod MISS] '{mainModule}' > '{subModule}' → DB pairs: " +
                string.Join(", ", TenantState.UserRightsList.Select(r => $"{r.Department}|{r.ModuleName}").Distinct().OrderBy(x => x)));
#endif
        return found;
    }

    private bool CheckUserRightsForAction(string mainModule, string subModule, string action)
    {
        if (TenantState.UserRightsList == null || !TenantState.UserRightsList.Any()) return false;
        if (!CheckUserRightsForSubModule(mainModule, subModule)) return false;

        var act = (action ?? "").Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(act) || act == "view" || act == "read" || act == "list" || act == "display")
        {
            return true;
        }

        var normSub = NormalizeRightsKey(subModule);
        var matching = TenantState.UserRightsList.Where(r => 
            string.Equals(NormalizeRightsKey(r.ModuleName), normSub, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(r.ModuleName?.Replace(" ", "_"), subModule.Replace(" ", "_"), StringComparison.OrdinalIgnoreCase)
        ).ToList();

        if (!matching.Any()) return true;

        if (act.Contains("create") || act.Contains("add") || act.Contains("new") || act.Contains("insert"))
            return matching.Any(r => r.ToAdd);

        if (act.Contains("edit") || act.Contains("update") || act.Contains("modify") || act.Contains("save"))
            return matching.Any(r => r.ToEdit);

        if (act.Contains("delete") || act.Contains("remove") || act.Contains("cancel"))
            return matching.Any(r => r.ToDelete);

        if (act.Contains("export") || act.Contains("print") || act.Contains("download"))
            return matching.Any(r => r.ToExport);

        return matching.Any(r => r.ToView);
    }

    private bool HasMainModule(string mainModule) => IsAdmin() || RoleService.HasMainModule(mainModule) || CheckUserRightsForMainModule(mainModule);
    private bool HasRight(string mainModule, string subModule) => IsAdmin() || RoleService.HasRight(mainModule, subModule) || CheckUserRightsForSubModule(mainModule, subModule);
    private bool HasAction(string mainModule, string subModule, string action) => IsAdmin() || RoleService.HasAction(mainModule, subModule, action) || CheckUserRightsForAction(mainModule, subModule, action);

    private string GetDisplayUserName()
    {
        if (!string.IsNullOrWhiteSpace(displayUserName)) 
            return displayUserName;

        if (!string.IsNullOrWhiteSpace(TenantState.UserData?.UserName)) 
            return TenantState.UserData.UserName;

        return "User";
    }

    private string GetDisplayUserRole()
    {
        if (!string.IsNullOrWhiteSpace(displayUserRole)) return displayUserRole;
        if (!string.IsNullOrWhiteSpace(TenantState.UserData?.Role)) return TenantState.UserData.Role;
        return "User";
    }

    private string GetUserInitials()
    {
        var name = GetDisplayUserName();
        if (string.IsNullOrWhiteSpace(name) || name == "User")
        {
            var role = GetDisplayUserRole();
            return !string.IsNullOrWhiteSpace(role) && role.Length >= 2 ? role.Substring(0, 2).ToUpper() : "U";
        }
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }

