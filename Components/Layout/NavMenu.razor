    private async Task ConfirmOpenShiftFromNavAsync()
    {
        if (navPromptBhCode <= 0 || navPromptCntCode <= 0)
        {
            navPromptBhCode = 1;
            navPromptCntCode = 1;
        }

        isOpeningShiftInNav = true;
        StateHasChanged();

        try
        {
            var openReq = new Booking.Models.OpenShiftRequest
            {
                bhcode = navPromptBhCode,
                cntcode = navPromptCntCode,
                counterdate = DateTime.Today
            };

            var rawResponse = await HmsBillingService.OpenShiftAsync(openReq);

            bool isSuccess = false;
            string displayMsg = "Shift opened successfully.";

            if (!string.IsNullOrEmpty(rawResponse) && !rawResponse.StartsWith("Error|"))
            {
                if (rawResponse.Trim().StartsWith("{") && rawResponse.Trim().EndsWith("}"))
                {
                    try
                    {
                        var jsonObj = Newtonsoft.Json.Linq.JObject.Parse(rawResponse);
                        if (jsonObj["message"] != null)
                        {
                            var msg = jsonObj["message"].ToString();
                            if (msg.Contains("success", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("safely shut down", StringComparison.OrdinalIgnoreCase) ||
                                msg.Contains("ok", StringComparison.OrdinalIgnoreCase))
                            {
                                isSuccess = true;
                                displayMsg = msg;
                            }
                            else
                            {
                                isSuccess = false;
                                displayMsg = msg;
                            }
                        }
                        else if (jsonObj["cnttid"] != null || jsonObj["shiftsno"] != null)
                        {
                            isSuccess = true;
                        }
                    }
                    catch
                    {
                        isSuccess = true;
                    }
                }
                else
                {
                    isSuccess = true;
                }
            }
            else if (!string.IsNullOrEmpty(rawResponse) && rawResponse.StartsWith("Error|"))
            {
                isSuccess = false;
                displayMsg = rawResponse.Replace("Error|", "");
            }

            if (isSuccess)
            {
                Toast.ShowSuccess($"Shift for counter '{navPromptCounterName}' opened successfully!");
                hasNavActiveShift = true;
                try
                {
                    await _sessionStorage.SetAsync("cntcode", navPromptCntCode.ToString());
                }
                catch { }
                showNavOpenShiftModal = false;
                await RefreshActiveShiftStatusAsync();
                StateHasChanged();
            }
            else
            {
                Toast.ShowError($"Failed to open shift: {displayMsg}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error opening shift: {ex.Message}");
        }
        finally
        {
            isOpeningShiftInNav = false;
            StateHasChanged();
        }
    }

    private async Task PromptEndShiftInNav()
    {
        _ = CloseSidebar();
        try
        {
            navOpenShiftsList = await HmsBillingService.GetOpenCountersAsync() ?? new();
            if (!navOpenShiftsList.Any())
            {
                hasNavActiveShift = false;
                StateHasChanged();
                Toast.ShowWarning("No active shifts open. Please open the counter.");
                NavigationManager.NavigateTo("/counter-shift");
                return;
            }
            hasNavActiveShift = true;

            int savedCntCode = 0;
            try
            {
                var cntCodeRes = await _sessionStorage.GetAsync<string>("cntcode");
                if (cntCodeRes.Success && !string.IsNullOrEmpty(cntCodeRes.Value))
                {
                    int.TryParse(cntCodeRes.Value, out savedCntCode);
                }
            }
            catch { }

            var active = navOpenShiftsList.FirstOrDefault(s => savedCntCode > 0 && s.cntcode == savedCntCode) 
                         ?? navOpenShiftsList.First();

            var labSetting = await LabSettingService.GetLabSettingAsync();
            bool isFixedMode = string.Equals(labSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase)
                               || string.Equals(active.shift_mode, "FIXED", StringComparison.OrdinalIgnoreCase);

            if (isFixedMode)
            {
                Toast.ShowWarning("The fixed timing shift cannot be closed manually. It closes automatically at the configured time or at midnight (12:00 AM).");
                return;
            }

            selectedNavShiftCnttid = active.cnttid;
            navShiftEndCounterName = $"Counter {active.cntcode}";
            showNavEndShiftModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error checking active shifts: {ex.Message}");
        }
    }

    private void CancelNavEndShift()
    {
        showNavEndShiftModal = false;
    }

    private async Task ConfirmNavEndShiftAsync()
    {
        if (selectedNavShiftCnttid == Guid.Empty) return;

        var labSetting = await LabSettingService.GetLabSettingAsync();
        var active = navOpenShiftsList.FirstOrDefault(s => s.cnttid == selectedNavShiftCnttid);
        bool isFixedMode = string.Equals(labSetting?.shift_timing_mode, "FIXED", StringComparison.OrdinalIgnoreCase)
                           || string.Equals(active?.shift_mode, "FIXED", StringComparison.OrdinalIgnoreCase);

        if (isFixedMode)
        {
            Toast.ShowWarning("The fixed timing shift cannot be closed manually. It closes automatically at the configured time or at midnight (12:00 AM).");
            showNavEndShiftModal = false;
            return;
        }

        isEndingNavShift = true;
        StateHasChanged();

        try
        {
            int userCode = TenantState.UserCode > 0 ? TenantState.UserCode : 10;
            var req = new Booking.Models.CloseShiftRequest
            {
                cnttid = selectedNavShiftCnttid.ToString(),
                usercode = userCode
            };

            var responseStr = await HmsBillingService.CloseShiftAsync(req);
            if (!string.IsNullOrEmpty(responseStr) && 
                (responseStr.Contains("safely shut down", StringComparison.OrdinalIgnoreCase) || 
                 responseStr.Contains("success", StringComparison.OrdinalIgnoreCase) || 
                 responseStr.Contains("cnttid")))
            {
                Toast.ShowSuccess($"Counter shift ended successfully! Logging out...");
                try
                {
                    await _sessionStorage.DeleteAsync("cntcode");
                }
                catch { }
                showNavEndShiftModal = false;
                StateHasChanged();
                await Task.Delay(1000);
                await HandleLogout();
            }
            else
            {
                Toast.ShowError($"Failed to end shift: {responseStr}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error ending shift: {ex.Message}");
        }
        finally
        {
            isEndingNavShift = false;
            showNavEndShiftModal = false;
            StateHasChanged();
        }
    }
}
