    private void ExpandSubmenuForCurrentUri()
    {
        var uri = new Uri(NavigationManager.Uri);
        var path = uri.AbsolutePath.ToLowerInvariant();
        
        if (path == "" || path == "/" || path == "/home" || path.Contains("home") || path.Contains("dashboard"))
        {
            isDashboardSectionOpen = true;
        }
        if (path.Contains("op-dashboard") || path.Contains("booking/reception") || path.Contains("booking/outpatient") || path.Contains("patientmaster") || path.Contains("country-master") || path.Contains("state-master") || path.Contains("city-master") || path.Contains("area-master") || path.Contains("service-type-master") || path.Contains("slots") || path.Contains("op-token-display") || path.Contains("reception"))
        {
