@code {
    [Parameter] public bool IsSidebarVisible { get; set; } = false;
    [Parameter] public EventCallback<bool> IsSidebarVisibleChanged { get; set; }

    private bool isSidebarCollapsed = false;
    private bool isDarkMode = false;
    private bool isDisposed = false;

    private string displayUserName = "";
    private string displayUserRole = "";

    private bool isDoctorMastersOpen = false;
    private bool isLabMastersOpen = false;
    private bool isOrgMastersOpen = false;
    private bool isIpdMastersOpen = false;
    private bool isOtMastersOpen = false;
    private bool isVitalsEntriesOpen = false;
    private bool isInventoryMastersOpen = false;
    private bool isTransactionsOpen = true;
    private bool isInventoryOpen = true;
    private bool isReceptionMastersOpen = false;
    private bool isBillingMastersOpen = false;

    private bool isDashboardSectionOpen = false;
    private bool isOpPortalSectionOpen = false;
    private bool isIpPortalSectionOpen = false;
    private bool isOtPortalSectionOpen = false;
    private bool isBillingPortalSectionOpen = false;
    private bool isLaboratorySectionOpen = false;
    private bool isPharmacySectionOpen = false;
    private bool isInventorySectionOpen = false;
    private bool isDoctorPortalSectionOpen = false;
    private bool isVitalPageSectionOpen = false;
    private bool isAdminPortalSectionOpen = false;

    private string menuSearchQuery = "";
    private void ClearMenuSearch() => menuSearchQuery = "";

    private System.Threading.Timer? _shiftExpirationTimer;
    private bool hasNavActiveShift = false;
    private bool showNavEndShiftModal = false;
    private bool isEndingNavShift = false;
    private Guid selectedNavShiftCnttid = Guid.Empty;
    private string navShiftEndCounterName = "Counter 1";
    private List<Booking.Models.CounterTimingDto> navOpenShiftsList = new();

    private bool showNavOpenShiftModal = false;
    private bool isOpeningShiftInNav = false;
    private string navPromptCounterName = "Main branch counter";
    private string navPromptBranchName = "Main branch";
    private int navPromptBhCode = 1;
    private int navPromptCntCode = 1;

    private bool _menuReady = false;    // true once session has been restored (shows skeleton until then)
    private bool _isAdminSession = false; // sticky: once latched never re-evaluates

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        TenantState.OnSessionChanged += HandleSessionChanged;
        RoleService.OnPermissionsChanged += HandlePermissionsChanged;
        ExpandSubmenuForCurrentUri();
        // Only sync from TenantState if it is already populated (e.g. same-tab navigation)
        SyncUserProfile();
        if (IsAdmin() && (!RoleService.IsPermissionsLoaded || !RoleService.CurrentUserPermissions.Any()))
        {
            RoleService.SetUserPermissions(RoleCatalogDefaults.GetDefaultPermissions());
        }
        // If TenantState is already authenticated at this point (e.g. second render, tab
        // reuse), mark the menu as ready immediately so no skeleton is shown.
        if (TenantState.IsAuthenticated && (IsAdmin() || RoleService.IsPermissionsLoaded))
            _menuReady = true;
    }

    // OnInitializedAsync is intentionally minimal.
    // ProtectedSessionStorage requires JS interop which is NOT available during
    // Blazor Server pre-rendering / first static render; calling it here throws
    // and gets silently swallowed, leaving displayUserName/Role empty anyway.
    // All session restoration is done in OnAfterRenderAsync where JS is available.
    protected override Task OnInitializedAsync() => Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartShiftMonitorTimer();

            await RestoreNavSessionAsync();

            // Mark menu as ready AFTER session is restored
            _menuReady = true;

            try
            {
                var theme = await JS.InvokeAsync<string>("medicoTheme.getTheme");
                isDarkMode = (theme == "dark");
            }
            catch {}

            _ = RefreshActiveShiftStatusAsync();

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RestoreNavSessionAsync()
    {
        try
        {
            // 1. Sync from TenantState if already populated
            SyncUserProfile();

            string localName = "";
            string localRole = "";
            string localTenant = "";
            string localToken = "";
            string localTenantName = "";
            int localUserCode = 0;
            int? localBhCode = null;
            int? localCntCode = null;
            bool localIsAdmin = false;

            // 2. Read fast multi-tab session from localStorage (0ms)
            try
            {
                var sessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                if (!string.IsNullOrWhiteSpace(sessionJson))
                {
                    var jObj = Newtonsoft.Json.Linq.JObject.Parse(sessionJson);
                    localName = jObj["user_name"]?.ToString() ?? jObj["login_input"]?.ToString() ?? "";
                    localRole = jObj["user_role"]?.ToString() ?? "";
                    localTenant = jObj["tenant_code"]?.ToString() ?? "";
                    localToken = jObj["authToken"]?.ToString() ?? "";
                    localTenantName = jObj["tenant_name"]?.ToString() ?? "";
                    localUserCode = jObj["user_code"]?.ToObject<int>() ?? 0;
                    localBhCode = jObj["bhcode"]?.ToObject<int?>();
                    localCntCode = jObj["cntcode"]?.ToObject<int?>();
                    localIsAdmin = jObj["isAdmin"]?.ToObject<bool>() == true;

                    if (!string.IsNullOrWhiteSpace(localName) && (string.IsNullOrWhiteSpace(displayUserName) || displayUserName == "User"))
                        displayUserName = localName;
                    if (!string.IsNullOrWhiteSpace(localRole) && (string.IsNullOrWhiteSpace(displayUserRole) || displayUserRole == "User"))
                        displayUserRole = localRole;
                }
            }
            catch { }

            // 3. Fallback to ProtectedSessionStorage for UserDetails
            if (string.IsNullOrWhiteSpace(displayUserName) || displayUserName == "User" || string.IsNullOrWhiteSpace(displayUserRole) || displayUserRole == "User")
            {
                try
                {
                    var userDetailsResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                    if (userDetailsResult.Success && userDetailsResult.Value != null)
                    {
                        var ud = userDetailsResult.Value;
                        if (!string.IsNullOrWhiteSpace(ud.UserName)) displayUserName = ud.UserName;
                        if (!string.IsNullOrWhiteSpace(ud.Role)) displayUserRole = ud.Role;
                        if (string.IsNullOrEmpty(localTenant)) localTenant = ud.TenantCode ?? "";
                        if (string.IsNullOrEmpty(localToken)) localToken = ud.AuthToken ?? "";
                        if (string.IsNullOrEmpty(localTenantName)) localTenantName = ud.TenantName ?? "";
                        if (localUserCode <= 0 && ud.UserCode.HasValue) localUserCode = ud.UserCode.Value;
                    }
                }
                catch { }

                if (string.IsNullOrWhiteSpace(displayUserName) || displayUserName == "User")
                {
                    try
                    {
                        var unRes = await _sessionStorage.GetAsync<string>("user_name");
                        if (unRes.Success && !string.IsNullOrWhiteSpace(unRes.Value))
                            displayUserName = unRes.Value;
                    }
                    catch { }
                }

                if (string.IsNullOrWhiteSpace(displayUserRole) || displayUserRole == "User")
                {
                    try
                    {
                        var urRes = await _sessionStorage.GetAsync<string>("user_role");
                        if (urRes.Success && !string.IsNullOrWhiteSpace(urRes.Value))
                            displayUserRole = urRes.Value;
                    }
                    catch { }
                }
            }

            // 4. Admin Detection
            bool isExplicitNonAdmin = (!string.IsNullOrWhiteSpace(displayUserRole) && !IsAdminRole(displayUserRole)) ||
                                      (TenantState.UserData != null && !string.IsNullOrWhiteSpace(TenantState.UserData.Role) && !IsAdminRole(TenantState.UserData.Role));

            bool isAdminDetected = false;
            if (!isExplicitNonAdmin)
            {
                isAdminDetected = IsAdminRole(displayUserRole) ||
                                  string.Equals(displayUserName, "admin", StringComparison.OrdinalIgnoreCase) ||
                                  (TenantState.UserData != null && IsAdminRole(TenantState.UserData.Role)) ||
                                  (localIsAdmin && string.IsNullOrWhiteSpace(displayUserRole));
            }

            if (isAdminDetected)
            {
                _isAdminSession = true;
                displayUserRole = "Administrator";
                if (string.IsNullOrWhiteSpace(displayUserName) || displayUserName == "User") displayUserName = "Administrator";
            }
            else
            {
                _isAdminSession = false;
            }

            // 5. Ensure permissions loaded into RoleService and UserRights into TenantState
            List<Booking.Models.RolePermissionItem>? loadedPerms = null;
            List<SharedComponents.Rcl.Models.User_Rights>? loadedRights = null;

            if (isAdminDetected)
            {
                _isAdminSession = true;
                loadedPerms = RoleCatalogDefaults.GetDefaultPermissions();
                RoleService.SetUserPermissions(loadedPerms);
                loadedRights = RoleMasterService.ConvertEffectivePermissionsToUserRights(loadedPerms, localUserCode);
            }
            else
            {
                _isAdminSession = false;
                if (!RoleService.IsPermissionsLoaded || !RoleService.CurrentUserPermissions.Any())
                {
                    try
                    {
                        var rolePermsResult = await _sessionStorage.GetAsync<List<Booking.Models.RolePermissionItem>>("UserRolePermissions");
                        if (rolePermsResult.Success && rolePermsResult.Value != null && rolePermsResult.Value.Any())
                        {
                            loadedPerms = rolePermsResult.Value;
                            RoleService.SetUserPermissions(loadedPerms);
                        }
                    }
                    catch { }

                    try
                    {
                        var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                        if (rightsResult.Success && rightsResult.Value != null && rightsResult.Value.Any())
                        {
                            loadedRights = rightsResult.Value;
                            if (loadedPerms == null || !loadedPerms.Any())
                            {
                                loadedPerms = RoleMasterService.ConvertUserRightsToPermissions(loadedRights);
                                RoleService.SetUserPermissions(loadedPerms);
                            }
                        }
                    }
                    catch { }

                    if ((loadedPerms == null || !loadedPerms.Any()) && TenantState.UserRightsList != null && TenantState.UserRightsList.Any())
                    {
                        loadedRights = (TenantState.UserRightsList as List<SharedComponents.Rcl.Models.User_Rights>) ?? TenantState.UserRightsList.ToList();
                        loadedPerms = RoleMasterService.ConvertUserRightsToPermissions(TenantState.UserRightsList);
                        RoleService.SetUserPermissions(loadedPerms);
                    }
                }
                else
                {
                    loadedPerms = RoleService.CurrentUserPermissions;
                    if (TenantState.UserRightsList != null && TenantState.UserRightsList.Any())
                    {
                        loadedRights = (TenantState.UserRightsList as List<SharedComponents.Rcl.Models.User_Rights>) ?? TenantState.UserRightsList.ToList();
                    }
                    else if (loadedPerms != null && loadedPerms.Any())
                    {
                        loadedRights = RoleMasterService.ConvertEffectivePermissionsToUserRights(loadedPerms, localUserCode);
                    }
                }
            }

            // 6. Set user display fields if TenantState.UserData is already populated
            if (TenantState.UserData != null)
            {
                if (string.IsNullOrWhiteSpace(TenantState.UserData.UserName) && !string.IsNullOrWhiteSpace(displayUserName))
                    TenantState.UserData.UserName = displayUserName;
                if (isAdminDetected)
                    TenantState.UserData.Role = "Administrator";
                else if (!string.IsNullOrWhiteSpace(displayUserRole))
                    TenantState.UserData.Role = displayUserRole;
            }

            _menuReady = true;
            ExpandSubmenuForCurrentUri();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { return; }
        catch (Microsoft.JSInterop.JSDisconnectedException) { return; }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] RestoreNavSessionAsync error: {ex.Message}");
        }
    }

    public void RefreshMenu()
    {
        _ = InvokeAsync(() =>
        {
            if (isDisposed) return Task.CompletedTask;
            SyncUserProfile();
            if (IsAdmin())
            {
                _isAdminSession = true;
                _menuReady = true;
                if (!RoleService.IsPermissionsLoaded || !RoleService.CurrentUserPermissions.Any())
                {
                    RoleService.SetUserPermissions(RoleCatalogDefaults.GetDefaultPermissions());
                }
            }
            else if (RoleService.IsPermissionsLoaded || (TenantState.UserRightsList != null && TenantState.UserRightsList.Any()))
            {
                _menuReady = true;
            }
            ExpandSubmenuForCurrentUri();
            _ = RefreshActiveShiftStatusAsync();
            return InvokeAsync(StateHasChanged);
        });
    }

    private void SyncUserProfile()
    {
        if (TenantState.UserData != null)
        {
            if (!string.IsNullOrWhiteSpace(TenantState.UserData.UserName))
                displayUserName = TenantState.UserData.UserName;
            if (!string.IsNullOrWhiteSpace(TenantState.UserData.Role))
            {
                displayUserRole = TenantState.UserData.Role;
                _isAdminSession = IsAdminRole(displayUserRole);
            }
        }
    }

    private void HandlePermissionsChanged()
    {
        RefreshMenu();
    }

    private void HandleSessionChanged()
    {
        RefreshMenu();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (isDisposed) return;
            ExpandSubmenuForCurrentUri();
            _ = RefreshActiveShiftStatusAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        isDisposed = true;
        _shiftExpirationTimer?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
        TenantState.OnSessionChanged -= HandleSessionChanged;
        RoleService.OnPermissionsChanged -= HandlePermissionsChanged;
    }

    private async Task ToggleSidebar()
    {
        IsSidebarVisible = !IsSidebarVisible;
        await IsSidebarVisibleChanged.InvokeAsync(IsSidebarVisible);
    }

    private async Task CloseSidebar()
    {
        if (IsSidebarVisible)
        {
            IsSidebarVisible = false;
            await IsSidebarVisibleChanged.InvokeAsync(false);
        }
    }

    private void ToggleCollapse() => isSidebarCollapsed = !isSidebarCollapsed;

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JS.InvokeAsync<string>("medicoTheme.toggleTheme");
            isDarkMode = (newTheme == "dark");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling theme: {ex.Message}");
        }
    }

    private void ToggleDoctorMasters() => isDoctorMastersOpen = !isDoctorMastersOpen;
    private void ToggleLabMasters() => isLabMastersOpen = !isLabMastersOpen;
    private void ToggleOrgMasters() => isOrgMastersOpen = !isOrgMastersOpen;
