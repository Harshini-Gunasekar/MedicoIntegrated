    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                try
                {
                    var currentTheme = await JS.InvokeAsync<string>("medicoTheme.getTheme");
                    isDarkMode = (currentTheme == "dark");
                }
                catch {}

                await ValidateAndAuthorizeAsync();

                if (TenantState.IsAuthenticated)
                {
                    try
                    {
                        await JS.InvokeVoidAsync("medicoPreventBackToLogin");
                    }
                    catch {}
                }
                await RestoreTabsFromStorageAsync();

                try
                {
                    if (!WalkinStateSvc.HasActiveDraft)
                    {
                        var res = await _sessionStorage.GetAsync<string>("WalkinDraftState");
                        if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
                        {
                            var model = JsonConvert.DeserializeObject<Booking.Components.Pages.ReceptionBooking.WalkinDraftModel>(res.Value);
                            if (model != null && model.ShowWalkinModal)
                            {
                                WalkinStateSvc.ShowWalkinModal = true;
                                WalkinStateSvc.IsWalkinMinimized = model.IsWalkinMinimized;
                                WalkinStateSvc.PatientSearchQuery = model.PatientSearchQuery ?? "";
                                WalkinStateSvc.WalkinCustid = model.WalkinCustid;
                                WalkinStateSvc.WalkinDate = model.WalkinDate != default ? model.WalkinDate : DateTime.UtcNow.ToIndianTime().Date;
                                WalkinStateSvc.WalkinDcode = model.WalkinDcode;
                                WalkinStateSvc.WalkinNotes = model.WalkinNotes ?? "";
                                WalkinStateSvc.SelectedSlotDetailId = model.SelectedSlotDetailId;
                                WalkinStateSvc.NotifyStateChanged();
                            }
                        }
                    }
                }
                catch { }

                var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                SyncCurrentPageToTabs(relativePath);

                try
                {
                    dotNetHelper = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("networkSpeedMonitor.init", dotNetHelper);
                }
                catch { }

                _ = Task.Run(async () =>
                {
                    try
                    {
                        deviceNetworkInfo = await NetworkInfoService.GetDeviceNetworkDetailsAsync();
                    }
                    catch { }
                });

                _navMenuRef?.RefreshMenu();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
                _isCircuitAborted = true;
                return;
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                _isCircuitAborted = true;
                return;
            }
        }
    }

    private async Task ValidateAndAuthorizeAsync()
    {
        try
        {
            SharedComponents.Rcl.Models.UserDetailsModel? user = null;
            List<SharedComponents.Rcl.Models.User_Rights> rights = new();
            List<Booking.Models.RolePermissionItem>? effectivePerms = null;

            string directUserName = "";
            string directUserRole = "";
            string directUserDescription = "";
            string loginInput = "";
            int directUserCode = 0;
            string tenantCode = "";
            string authToken = "";
            string tenantName = "";
            bool isTenantAdminSession = false;
            bool isBranchConfirmed = false;
            int? localBhCode = null;
            int? localCntCode = null;

            // 1. Fast Single-Pass Multi-Tab Session Read (0ms LocalStorage via JS)
            try
            {
                var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                if (!string.IsNullOrWhiteSpace(localSessionJson))
                {
                    var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                    authToken = jObj["authToken"]?.ToString() ?? "";
                    tenantCode = jObj["tenant_code"]?.ToString() ?? "";
                    tenantName = jObj["tenant_name"]?.ToString() ?? "";
                    directUserName = jObj["user_name"]?.ToString() ?? "";
                    loginInput = jObj["login_input"]?.ToString() ?? "";
                    directUserRole = jObj["user_role"]?.ToString() ?? "";
                    directUserDescription = jObj["user_description"]?.ToString() ?? "";
                    directUserCode = jObj["user_code"]?.ToObject<int>() ?? 0;
                    isTenantAdminSession = jObj["isAdmin"]?.ToObject<bool>() == true;
                    isBranchConfirmed = jObj["session_branch_confirmed"]?.ToObject<bool>() == true;
                    localBhCode = jObj["bhcode"]?.ToObject<int?>();
                    localCntCode = jObj["cntcode"]?.ToObject<int?>();

                    if (!string.IsNullOrWhiteSpace(directUserName) || !string.IsNullOrWhiteSpace(authToken) || !string.IsNullOrWhiteSpace(tenantCode))
                    {
                        var fastRole = !string.IsNullOrWhiteSpace(directUserDescription) && !int.TryParse(directUserDescription.Trim(), out _)
                            ? directUserDescription.Trim()
                            : (isTenantAdminSession ? "Administrator" : (!string.IsNullOrWhiteSpace(directUserRole) && !int.TryParse(directUserRole.Trim(), out _) ? directUserRole.Trim() : "User"));

                        user = new SharedComponents.Rcl.Models.UserDetailsModel
                        {
                            UserName = !string.IsNullOrWhiteSpace(directUserName) ? directUserName : (!string.IsNullOrWhiteSpace(loginInput) ? loginInput : (isTenantAdminSession ? "Administrator" : "User")),
                            Role = fastRole,
                            TenantCode = tenantCode,
                            TenantName = !string.IsNullOrWhiteSpace(tenantName) ? tenantName : (!string.IsNullOrWhiteSpace(tenantCode) ? $"{tenantCode} Healthcare Hospital" : "Medico Healthcare Hospital"),
                            AuthToken = authToken,
                            UserCode = directUserCode,
                            BranchCode = localBhCode,
                            CounterCode = localCntCode
                        };
                        TenantState.SetSession(tenantCode, authToken, user.TenantName, directUserCode, localBhCode, localCntCode, user, TenantState.UserRightsList?.ToList() ?? new List<SharedComponents.Rcl.Models.User_Rights>());
                    }
                }
            }
            catch { }

            // 2. Read UserDetails from Session Storage as supplementary
            try
            {
                var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
                if (userResult.Success && userResult.Value != null)
                {
                    user = userResult.Value;
                    if (string.IsNullOrEmpty(directUserName) && !string.IsNullOrWhiteSpace(user.UserName)) directUserName = user.UserName;
                    if (string.IsNullOrEmpty(directUserRole) && !string.IsNullOrWhiteSpace(user.Role)) directUserRole = user.Role;
                    if (string.IsNullOrEmpty(tenantCode) && !string.IsNullOrWhiteSpace(user.TenantCode)) tenantCode = user.TenantCode;
                    if (string.IsNullOrEmpty(authToken) && !string.IsNullOrWhiteSpace(user.AuthToken)) authToken = user.AuthToken;
                    if (string.IsNullOrEmpty(tenantName) && !string.IsNullOrWhiteSpace(user.TenantName)) tenantName = user.TenantName;
                    if (directUserCode == 0 && user.UserCode.HasValue) directUserCode = user.UserCode.Value;
                }
            }
            catch (OperationCanceledException)
            {
                _isCircuitAborted = true;
                return;
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                _isCircuitAborted = true;
                return;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[MainLayout] Error reading UserDetails: {ex.Message}");
            }

            // 3. Fallbacks from direct session keys if still missing
            if (!isTenantAdminSession)
            {
                try
                {
                    var itaRes = await _sessionStorage.GetAsync<bool>("IsTenantAdmin");
                    if (itaRes.Success && itaRes.Value) isTenantAdminSession = true;
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(directUserDescription))
            {
                try
                {
                    var descRes = await _sessionStorage.GetAsync<string>("user_description");
                    if (descRes.Success && !string.IsNullOrWhiteSpace(descRes.Value)) directUserDescription = descRes.Value.Trim();
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(directUserName))
            {
                try
                {
                    var unRes = await _sessionStorage.GetAsync<string>("user_name");
                    if (unRes.Success && !string.IsNullOrWhiteSpace(unRes.Value)) directUserName = unRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(loginInput))
            {
                try
                {
                    var liRes = await _sessionStorage.GetAsync<string>("login_input");
                    if (liRes.Success && !string.IsNullOrWhiteSpace(liRes.Value)) loginInput = liRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(directUserRole))
            {
                try
                {
                    var urRes = await _sessionStorage.GetAsync<string>("user_role");
                    if (urRes.Success && !string.IsNullOrWhiteSpace(urRes.Value)) directUserRole = urRes.Value;
                }
                catch { }
            }

            if (directUserCode == 0)
            {
                try
                {
                    var ucRes = await _sessionStorage.GetAsync<int>("user_code");
                    if (ucRes.Success) directUserCode = ucRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(tenantCode))
            {
                try
                {
                    var tcRes = await _sessionStorage.GetAsync<string>("tenant_code");
                    if (tcRes.Success && !string.IsNullOrWhiteSpace(tcRes.Value)) tenantCode = tcRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(authToken))
            {
                try
                {
                    var atRes = await _sessionStorage.GetAsync<string>("authToken");
                    if (atRes.Success && !string.IsNullOrWhiteSpace(atRes.Value)) authToken = atRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrWhiteSpace(tenantName))
            {
                try
                {
                    var tnRes = await _sessionStorage.GetAsync<string>("tenant_name");
                    if (tnRes.Success && !string.IsNullOrWhiteSpace(tnRes.Value)) tenantName = tnRes.Value;
                }
                catch { }
            }

            if (!isBranchConfirmed)
            {
                try
                {
                    var confRes = await _sessionStorage.GetAsync<bool>("session_branch_confirmed");
                    if (confRes.Success) isBranchConfirmed = confRes.Value;
                }
                catch { }
            }

            // Always resolve real user description from database if description is missing or numeric
            if ((string.IsNullOrWhiteSpace(directUserDescription) || int.TryParse(directUserDescription.Trim(), out _)) && directUserCode > 0)
            {
                try
                {
                    var dbUser = await UserService.GetUserMasterAsync(directUserCode, authToken, tenantCode);
                    if (dbUser != null && !string.IsNullOrWhiteSpace(dbUser.description))
                    {
                        directUserDescription = dbUser.description.Trim();
                        try { await _sessionStorage.SetAsync("user_description", directUserDescription); } catch { }
                    }
                }
                catch { }
            }

            // 4. Robust Admin detection
            bool isAdminDetected = isTenantAdminSession ||
                                  _isAdminSession ||
                                  IsAdminRole(directUserRole) ||
                                  IsAdminRole(directUserDescription) ||
                                  IsAdminRole(user?.Role) ||
                                  string.Equals(directUserName, "admin", StringComparison.OrdinalIgnoreCase) ||
                                  string.Equals(loginInput, "admin", StringComparison.OrdinalIgnoreCase) ||
                                  (loginInput != null && loginInput.StartsWith("admin@", StringComparison.OrdinalIgnoreCase)) ||
                                  IsAdminRoleFromJwt(authToken) ||
                                  IsAdminRoleFromJwt(user?.AuthToken);

            if (isAdminDetected)
            {
                isTenantAdminSession = true;
                _isAdminSession = true;
                if (string.IsNullOrWhiteSpace(directUserName))
                    directUserName = !string.IsNullOrWhiteSpace(loginInput) ? loginInput : "Administrator";
            }

            var resolvedEffectiveRole = !string.IsNullOrWhiteSpace(directUserDescription) && !int.TryParse(directUserDescription.Trim(), out _)
                ? directUserDescription.Trim()
                : (isAdminDetected ? "Administrator" : (!string.IsNullOrWhiteSpace(directUserRole) && !int.TryParse(directUserRole.Trim(), out _) ? directUserRole.Trim() : "User"));

            // Ensure user model is populated
            if (user == null && (!string.IsNullOrEmpty(authToken) || !string.IsNullOrEmpty(directUserName) || !string.IsNullOrEmpty(tenantCode) || isAdminDetected || directUserCode > 0))
            {
                user = new SharedComponents.Rcl.Models.UserDetailsModel
                {
                    UserName = !string.IsNullOrWhiteSpace(directUserName) ? directUserName : (!string.IsNullOrWhiteSpace(loginInput) ? loginInput : (isAdminDetected ? "Administrator" : "User")),
                    Role = resolvedEffectiveRole,
                    TenantCode = tenantCode,
                    TenantName = !string.IsNullOrWhiteSpace(tenantName) ? tenantName : "Medico Healthcare Hospital",
                    AuthToken = authToken,
                    UserCode = directUserCode,
                    BranchCode = localBhCode,
                    CounterCode = localCntCode
                };
            }
            else if (user != null)
            {
                if (string.IsNullOrWhiteSpace(user.UserName) && !string.IsNullOrWhiteSpace(directUserName))
                    user.UserName = directUserName;
                if (isAdminDetected)
                    user.Role = "Administrator";
                else
                    user.Role = resolvedEffectiveRole;
                if (string.IsNullOrWhiteSpace(user.TenantCode) && !string.IsNullOrWhiteSpace(tenantCode))
                    user.TenantCode = tenantCode;
                if (string.IsNullOrWhiteSpace(user.AuthToken) && !string.IsNullOrWhiteSpace(authToken))
                    user.AuthToken = authToken;
                if (!user.BranchCode.HasValue && localBhCode.HasValue)
                    user.BranchCode = localBhCode;
                if (!user.CounterCode.HasValue && localCntCode.HasValue)
                    user.CounterCode = localCntCode;
            }

            if (user != null && (!string.IsNullOrEmpty(user.UserName) || !string.IsNullOrEmpty(user.AuthToken) || !string.IsNullOrEmpty(user.TenantCode) || isAdminDetected))
            {
                int resolvedCode = user.UserCode ?? directUserCode;

                // 5. Read UserRights from session storage
                try
                {
                    var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");
                    if (rightsResult.Success && rightsResult.Value != null && rightsResult.Value.Any())
                    {
                        rights = rightsResult.Value;
                    }
                }
                catch { }

                // 6. Read UserRolePermissions from session storage
                try
                {
                    var rolePermsResult = await _sessionStorage.GetAsync<List<Booking.Models.RolePermissionItem>>("UserRolePermissions");
                    if (rolePermsResult.Success && rolePermsResult.Value != null && rolePermsResult.Value.Any())
                    {
                        effectivePerms = rolePermsResult.Value;
                    }
                }
                catch { }

                // 7. Convert UserRights if permissions list is empty
                if ((effectivePerms == null || !effectivePerms.Any()) && rights.Any())
                {
                    effectivePerms = RoleMasterService.ConvertUserRightsToPermissions(rights);
                }

                // 8. Check if user is an Administrator
                bool isAdminUser = isAdminDetected;

                if (isAdminUser)
                {
                    _isAdminSession = true;
                    effectivePerms = RoleCatalogDefaults.GetDefaultPermissions();
                    rights = RoleMasterService.ConvertEffectivePermissionsToUserRights(effectivePerms, resolvedCode);
                }
                else
                {
                    _isAdminSession = false;
                    if ((!rights.Any()) && effectivePerms != null && effectivePerms.Any())
                    {
                        rights = RoleMasterService.ConvertEffectivePermissionsToUserRights(effectivePerms, resolvedCode);
                    }
                }

                // 9. Restore confirmed branch
                int? restoredBhCode = user.BranchCode ?? localBhCode;
                try
                {
                    var bhRes = await _sessionStorage.GetAsync<string>("bhcode");
                    if (bhRes.Success && int.TryParse(bhRes.Value, out int bhVal) && bhVal > 0)
                    {
                        restoredBhCode = bhVal;
                    }
                }
                catch { }

                if (restoredBhCode.HasValue && (restoredBhCode.Value <= 0 || IsSampleBranch(null, null, restoredBhCode.Value)))
                {
                    restoredBhCode = null;
                }
                if (user.BranchCode.HasValue && (user.BranchCode.Value <= 0 || IsSampleBranch(null, null, user.BranchCode.Value)))
                {
                    user.BranchCode = null;
                }
                if (user.Branches != null && user.Branches.Any())
                {
                    user.Branches = user.Branches.Where(b => !IsSampleBranch(b.name, b.short_name, b.bh_code)).ToList();
                }

                int? effectiveConfirmedBranch = (isBranchConfirmed && restoredBhCode.HasValue && restoredBhCode.Value > 0) ? restoredBhCode.Value : null;
                user.BranchCode = effectiveConfirmedBranch;

                // 10. Set TenantState session FIRST
                TenantState.SetSession(user.TenantCode ?? tenantCode ?? "", user.AuthToken ?? authToken ?? "", user.TenantName ?? tenantName ?? "Medico Healthcare Hospital", resolvedCode, effectiveConfirmedBranch, user.CounterCode, user, rights);
                sessionRenderVersion++;

                // 11. Apply permissions to RoleService AFTER TenantState is set
                RoleService.SetUserPermissions(effectivePerms ?? new());

                // 12. Persist to session storage & localStorage
                if (effectivePerms != null && effectivePerms.Any())
                {
                    try { await _sessionStorage.SetAsync("UserRights", rights); } catch { }
                    try { await _sessionStorage.SetAsync("UserRolePermissions", effectivePerms); } catch { }
                    try { await _sessionStorage.SetAsync("IsTenantAdmin", isAdminUser); } catch { }
                }

                try { await _sessionStorage.SetAsync("UserDetails", user); } catch { }
                if (!string.IsNullOrWhiteSpace(user.UserName)) { try { await _sessionStorage.SetAsync("user_name", user.UserName); } catch { } }
                if (!string.IsNullOrWhiteSpace(user.Role)) { try { await _sessionStorage.SetAsync("user_role", user.Role); } catch { } }
                if (!string.IsNullOrWhiteSpace(directUserDescription)) { try { await _sessionStorage.SetAsync("user_description", directUserDescription); } catch { } }
                if (!string.IsNullOrWhiteSpace(user.TenantCode)) { try { await _sessionStorage.SetAsync("tenant_code", user.TenantCode); } catch { } }
                if (!string.IsNullOrWhiteSpace(user.AuthToken)) { try { await _sessionStorage.SetAsync("authToken", user.AuthToken); } catch { } }

                try
                {
                    var crossTab = new
                    {
                        authToken = user.AuthToken ?? authToken,
                        tenant_code = user.TenantCode ?? tenantCode,
                        tenant_name = user.TenantName ?? tenantName,
                        user_name = user.UserName ?? directUserName,
                        user_role = user.Role ?? resolvedEffectiveRole,
                        user_description = !string.IsNullOrWhiteSpace(directUserDescription) ? directUserDescription : (user.Role ?? resolvedEffectiveRole),
                        user_code = resolvedCode,
                        bhcode = effectiveConfirmedBranch ?? user.BranchCode,
                        cntcode = user.CounterCode,
                        isAdmin = isAdminUser,
                        session_branch_confirmed = isBranchConfirmed
                    };
                    await JS.InvokeVoidAsync("medicoSessionHelper.saveSession", JsonConvert.SerializeObject(crossTab));
                }
                catch { }

                _navMenuRef?.RefreshMenu();
                StateHasChanged();
                await CheckBranchSelectionAsync();

                // Non-blocking background fetch if permissions have not been loaded yet for regular user (never for admin)
                if (resolvedCode > 0 && !isAdminUser && !RoleService.IsPermissionsLoaded)
                {
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            var serverPerms = await RoleService.GetUserEffectivePermissionsAsync(resolvedCode, user.TenantCode);
                            if (serverPerms != null && serverPerms.Any())
                            {
                                RoleService.SetUserPermissions(serverPerms);
                                try { await _sessionStorage.SetAsync("UserRolePermissions", serverPerms); } catch { }
                                var newRights = RoleMasterService.ConvertEffectivePermissionsToUserRights(serverPerms, resolvedCode);
                                try { await _sessionStorage.SetAsync("UserRights", newRights); } catch { }
                                TenantState.SetSession(user.TenantCode ?? "", user.AuthToken ?? "", user.TenantName ?? "", resolvedCode, effectiveConfirmedBranch, user.CounterCode, user, newRights);
                                _navMenuRef?.RefreshMenu();
                            }
                        }
                        catch { }
                    });
                }
            }
            else
            {
                bool localHasData = false;
                try
                {
                    var localJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                    localHasData = !string.IsNullOrWhiteSpace(localJson);
                }
                catch { }

                if (!localHasData)
                    TenantState.Clear();
            }
        }
        catch (OperationCanceledException)
        {
            _isCircuitAborted = true;
            return;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            _isCircuitAborted = true;
            return;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] ValidateAndAuthorize error: {ex.Message}");
        }
        finally
        {
            if (!isDisposed && !_isCircuitAborted)
            {
                _hasSessionValidated = true;
                isCheckingAccess = false;
                EvaluateAccess();
                _navMenuRef?.RefreshMenu();
                StateHasChanged();
            }
        }
    }

    // ── Admin-role helpers used by ValidateAndAuthorizeAsync ──────────────────
    private static bool IsAdminRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return false;
        var r = role.Trim();
        return string.Equals(r, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Super Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Power User", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "PowerUser", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Tenant", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Tenant Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "TenantAdmin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "Client Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(r, "ClientAdmin", StringComparison.OrdinalIgnoreCase) ||
               r.Contains("Admin", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAdminRoleFromJwt(string? token)
    {
        if (string.IsNullOrEmpty(token)) return false;
        try
        {
            var segments = token.Split('.');
            if (segments.Length < 2) return false;
            var payload = segments[1];
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            var jsonBytes = Convert.FromBase64String(payload);
            var claims = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
            if (claims == null) return false;
            
            if (claims.TryGetValue("IsAdmin", out var isAdmVal) && 
                (string.Equals(isAdmVal?.ToString(), "true", StringComparison.OrdinalIgnoreCase) || 
                 string.Equals(isAdmVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase)))
                return true;

            if (claims.TryGetValue("power_user", out var puVal) && 
                (string.Equals(puVal?.ToString(), "true", StringComparison.OrdinalIgnoreCase) || 
                 string.Equals(puVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase)))
                return true;

            object? rVal = null;
            if (!claims.TryGetValue("role", out rVal) &&
                !claims.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                return false;
            return IsAdminRole(rVal?.ToString());
        }
        catch { return false; }
    }

    private static bool IsSampleBranch(string? name, string? shortName, int code)
    {
        if (code <= 0) return true;
        if (!string.IsNullOrWhiteSpace(name))
        {
            var n = name.Trim();
            if (n.Contains("sample", StringComparison.OrdinalIgnoreCase)) return true;
            if (n.Contains("smpl", StringComparison.OrdinalIgnoreCase)) return true;
            if (n.Contains("dummy", StringComparison.OrdinalIgnoreCase)) return true;
        }
        if (!string.IsNullOrWhiteSpace(shortName))
        {
            var s = shortName.Trim();
            if (s.Contains("sample", StringComparison.OrdinalIgnoreCase)) return true;
            if (s.Contains("smpl", StringComparison.OrdinalIgnoreCase)) return true;
            if (s.Contains("dummy", StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private bool IsGenericBranchOrTenantName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return true;
        var trimmed = name.Trim();
        return string.Equals(trimmed, "Main branch", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(trimmed, "Sample Branch", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(trimmed, "Main", StringComparison.OrdinalIgnoreCase) ||
               trimmed.EndsWith(" Branch", StringComparison.OrdinalIgnoreCase) ||
               trimmed.Contains("Hospital", StringComparison.OrdinalIgnoreCase) ||
               trimmed.Contains("Healthcare", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(trimmed, "MEDICO", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(trimmed, "LAB01", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAdminOrPowerUser() => IsAdmin();

    private async Task CheckBranchSelectionAsync()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!TenantState.IsAuthenticated || IsAnonymousPath(relativePath))
        {
            showBranchModal = false;
            return;
        }

        bool isBranchConfirmed = false;
        try
        {
            var confRes = await _sessionStorage.GetAsync<bool>("session_branch_confirmed");
            isBranchConfirmed = confRes.Success && confRes.Value;
        }
        catch { }

        if (!isBranchConfirmed)
        {
            try
            {
                var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                if (!string.IsNullOrWhiteSpace(localSessionJson))
                {
                    var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                    isBranchConfirmed = jObj["session_branch_confirmed"]?.ToObject<bool>() == true;
                }
            }
            catch { }
        }

        // 1. Resolve confirmed branch ID ONLY IF session_branch_confirmed is true
        int? confirmedBranchId = (isBranchConfirmed && TenantState.BranchCode.HasValue && TenantState.BranchCode.Value > 0) ? TenantState.BranchCode.Value : null;

        if (isBranchConfirmed && (!confirmedBranchId.HasValue || confirmedBranchId.Value <= 0))
        {
            try
            {
                var bhRes = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhRes.Success && int.TryParse(bhRes.Value, out int bVal) && bVal > 0)
                {
                    confirmedBranchId = bVal;
                }
            }
            catch { }
        }

        if (isBranchConfirmed && (!confirmedBranchId.HasValue || confirmedBranchId.Value <= 0))
        {
            try
            {
                var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                if (!string.IsNullOrWhiteSpace(localSessionJson))
                {
                    var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                    var localBh = jObj["bhcode"]?.ToObject<int?>();
                    if (localBh.HasValue && localBh.Value > 0) confirmedBranchId = localBh.Value;
                }
            }
            catch { }
        }

        if (confirmedBranchId.HasValue && (confirmedBranchId.Value <= 0 || IsSampleBranch(null, null, confirmedBranchId.Value)))
        {
            confirmedBranchId = null;
        }

        // If a valid branch is already selected and stored in session, sync state and NEVER prompt again
        if (isBranchConfirmed && confirmedBranchId.HasValue && confirmedBranchId.Value > 0)
        {
            selectedBranchId = confirmedBranchId.Value;
            if (TenantState.BranchCode != confirmedBranchId.Value)
            {
                var user = TenantState.UserData;
                if (user != null) user.BranchCode = confirmedBranchId.Value;
                TenantState.SetSession(TenantState.TenantCode, TenantState.AuthToken, TenantState.TenantName, TenantState.UserCode, confirmedBranchId.Value, TenantState.CounterCode, user, TenantState.UserRightsList.ToList());
            }

            showBranchModal = false;
            StateHasChanged();
            return;
        }

        // 2. Otherwise (first login when multiple branches exist and none chosen yet), load branches to show modal
        await LoadBranchesForSelectionAsync();

        // If no branches available (excluding Sample Branch), prompt to add a new branch
        if (sessionBranches == null || !sessionBranches.Any())
        {
            showBranchModal = true;
            StateHasChanged();
            return;
        }

        // If exactly 1 branch available, automatically select & confirm it without popup
        if (sessionBranches.Count == 1)
        {
            var singleBranch = sessionBranches.First();
            selectedBranchId = singleBranch.bh_code;
            await ConfirmBranchAsync();
            return;
        }

        // If multiple branches (>= 2 branches available) and none confirmed yet, show selection modal
        if (sessionBranches.Count >= 2)
        {
            if (selectedBranchId <= 0 || IsSampleBranch(null, null, selectedBranchId) || !sessionBranches.Any(b => b.bh_code == selectedBranchId))
            {
                if (TenantState.UserData?.BranchCode.HasValue == true && !IsSampleBranch(null, null, TenantState.UserData.BranchCode.Value) && sessionBranches.Any(b => b.bh_code == TenantState.UserData.BranchCode.Value))
                {
                    selectedBranchId = TenantState.UserData.BranchCode.Value;
                }
                else
                {
                    selectedBranchId = sessionBranches.First().bh_code;
                }
            }
            showBranchModal = true;
            StateHasChanged();
        }
    }

    private async Task LoadBranchesForSelectionAsync()
    {
        try
        {
            var branchesResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.BranchModel>>("UserBranches");
            if (branchesResult.Success && branchesResult.Value != null && branchesResult.Value.Any())
            {
                sessionBranches = branchesResult.Value;
            }

            bool needsBranchFetch = !sessionBranches.Any() || sessionBranches.Any(b => string.IsNullOrWhiteSpace(b.name) || b.name.StartsWith("Branch ", StringComparison.OrdinalIgnoreCase) || b.name.StartsWith("BRANCH ", StringComparison.OrdinalIgnoreCase) || IsSampleBranch(b.name, null, b.bh_code));

            if (needsBranchFetch)
            {
                string effectiveTenant = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : "";
                string effectiveToken = !string.IsNullOrEmpty(TenantState.AuthToken) ? TenantState.AuthToken : "";

                if (string.IsNullOrEmpty(effectiveTenant))
                {
                    try
                    {
                        var tcRes = await _sessionStorage.GetAsync<string>("tenant_code");
                        if (tcRes.Success && !string.IsNullOrWhiteSpace(tcRes.Value)) effectiveTenant = tcRes.Value;
                    }
                    catch { }
                }
                if (string.IsNullOrEmpty(effectiveToken))
                {
                    try
                    {
                        var atRes = await _sessionStorage.GetAsync<string>("authToken");
                        if (atRes.Success && !string.IsNullOrWhiteSpace(atRes.Value)) effectiveToken = atRes.Value;
                    }
                    catch { }
                }

                if (string.IsNullOrEmpty(effectiveTenant) || string.IsNullOrEmpty(effectiveToken))
                {
                    try
                    {
                        var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                        if (!string.IsNullOrWhiteSpace(localSessionJson))
                        {
                            var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                            if (string.IsNullOrEmpty(effectiveTenant)) effectiveTenant = jObj["tenant_code"]?.ToString() ?? "";
                            if (string.IsNullOrEmpty(effectiveToken)) effectiveToken = jObj["authToken"]?.ToString() ?? "";
                        }
                    }
                    catch { }
                }

                List<SharedComponents.Rcl.Models.BranchModel> fetchedBranches = new();

                // Exclusively use LabCareUrl (labcareapi)
                try
                {
                    var client = ClientFactory.CreateClient("LabCareUrl");
                    if (!string.IsNullOrEmpty(effectiveTenant))
                    {
                        client.DefaultRequestHeaders.Remove("tenant_code");
                        client.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                        client.DefaultRequestHeaders.Remove("tenantcode");
                        client.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                        client.DefaultRequestHeaders.Remove("tenant-code");
                        client.DefaultRequestHeaders.Add("tenant-code", effectiveTenant);
                    }
                    if (!string.IsNullOrEmpty(effectiveToken))
                    {
                        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
                    }

                    var apiRes = await client.GetAsync("api/Branch/get");
                    if (apiRes.IsSuccessStatusCode)
                    {
                        var json = await apiRes.Content.ReadAsStringAsync();
                        fetchedBranches = ParseBranchesFromJson(json);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[MainLayout] LabCareUrl fetch branches error: {ex.Message}");
                }

                if (fetchedBranches.Any())
                {
                    if (sessionBranches.Any())
                    {
                        foreach (var sb in sessionBranches)
                        {
                            var match = fetchedBranches.FirstOrDefault(fb => fb.bh_code == sb.bh_code);
                            if (match != null && !string.IsNullOrWhiteSpace(match.name))
                            {
                                sb.name = match.name.Trim();
                            }
                        }
                    }
                    else
                    {
                        sessionBranches = fetchedBranches;
                    }
                    try { await _sessionStorage.SetAsync("UserBranches", sessionBranches); } catch { }
                }
            }

            if (sessionBranches.Any())
            {
                sessionBranches = sessionBranches
                    .Where(b => !IsSampleBranch(b.name, null, b.bh_code))
                    .GroupBy(b => b.bh_code)
                    .Select(g => g.First())
                    .ToList();
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            return;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session branches: {ex.Message}");
        }
    }

    private List<SharedComponents.Rcl.Models.BranchModel> ParseBranchesFromJson(string json)
    {
        var list = new List<SharedComponents.Rcl.Models.BranchModel>();
        if (string.IsNullOrWhiteSpace(json)) return list;

        try
        {
            var jArr = Newtonsoft.Json.Linq.JArray.Parse(json);
            foreach (var item in jArr)
            {
                int code = item["bh_code"]?.ToObject<int>() 
                    ?? item["bhcode"]?.ToObject<int>() 
                    ?? item["code"]?.ToObject<int>() 
                    ?? item["id"]?.ToObject<int>() 
                    ?? 0;

                string rawName = item["name"]?.ToString() 
                    ?? item["branch_name"]?.ToString() 
                    ?? item["branchName"]?.ToString() 
                    ?? item["b_name"]?.ToString() 
                    ?? item["branchname"]?.ToString() 
                    ?? "";

                string rawShort = item["short_name"]?.ToString() 
                    ?? item["shortname"]?.ToString() 
                    ?? "";

                bool isDel = item["deleted"]?.ToObject<bool>() == true || item["is_deleted"]?.ToObject<bool>() == true;

                if (code > 0 && !isDel && !IsSampleBranch(rawName, rawShort, code))
                {
                    string displayName = !string.IsNullOrWhiteSpace(rawName) 
                        ? rawName.Trim() 
                        : (!string.IsNullOrWhiteSpace(rawShort) ? rawShort.Trim() : $"Branch {code}");

                    list.Add(new SharedComponents.Rcl.Models.BranchModel
                    {
                        bh_code = code,
                        name = displayName
                    });
                }
            }
        }
        catch
        {
            try
            {
                var dbList = Newtonsoft.Json.JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                list = dbList
                    .Where(b => !b.deleted && !IsSampleBranch(b.name, b.short_name, b.bh_code))
                    .Select(b => new SharedComponents.Rcl.Models.BranchModel
                    {
                        bh_code = b.bh_code,
                        name = !string.IsNullOrWhiteSpace(b.name) ? b.name.Trim() : (!string.IsNullOrWhiteSpace(b.short_name) ? b.short_name.Trim() : $"Branch {b.bh_code}")
                    }).ToList();
            }
            catch { }
        }

        return list;
    }

    private async Task ConfirmBranchAsync()
    {
        if (selectedBranchId <= 0) return;

        try { await _sessionStorage.SetAsync("bhcode", selectedBranchId.ToString()); } catch { }
        try { await _sessionStorage.SetAsync("session_branch_confirmed", true); } catch { }
        
        var user = TenantState.UserData;
        if (user != null)
        {
            user.BranchCode = selectedBranchId;
            try { await _sessionStorage.SetAsync("UserDetails", user); } catch { }
        }
        TenantState.SetSession(TenantState.TenantCode, TenantState.AuthToken, TenantState.TenantName, TenantState.UserCode, selectedBranchId, TenantState.CounterCode, user, TenantState.UserRightsList.ToList());

        try
        {
            var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
            var jObj = string.IsNullOrWhiteSpace(localSessionJson) ? new Newtonsoft.Json.Linq.JObject() : Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
            jObj["bhcode"] = selectedBranchId;
            jObj["session_branch_confirmed"] = true;
            await JS.InvokeVoidAsync("medicoSessionHelper.saveSession", jObj.ToString());
        }
        catch { }

        showBranchModal = false;
        StateHasChanged();
    }

    private bool showQuickBranchModal = false;
    private string newBranchName = "";
    private string newBranchShortName = "";
    private string newBranchAddress = "";
    private string newBranchMobile = "";
    private bool isSavingBranch = false;

    private void OpenAddBranchModal()
    {
        newBranchName = "";
        newBranchShortName = "";
        newBranchAddress = "";
        newBranchMobile = "";
        showQuickBranchModal = true;
    }

    private async Task SaveQuickBranchAsync()
    {
        if (string.IsNullOrWhiteSpace(newBranchName))
        {
            Toast.ShowError("Please enter a Branch Name.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newBranchShortName))
        {
            var trimmed = newBranchName.Trim();
            newBranchShortName = trimmed.Length >= 3 ? trimmed.Substring(0, 3).ToUpper() : trimmed.ToUpper();
        }

        // Duplicate check
        if (sessionBranches != null && sessionBranches.Any(b => b.name?.Trim().Equals(newBranchName.Trim(), StringComparison.OrdinalIgnoreCase) == true))
        {
            Toast.ShowError($"A branch with name '{newBranchName.Trim()}' already exists.");
            return;
        }

        isSavingBranch = true;
        try
        {
            string effectiveTenant = !string.IsNullOrEmpty(TenantState.TenantCode) ? TenantState.TenantCode : "";
            string effectiveToken = !string.IsNullOrEmpty(TenantState.AuthToken) ? TenantState.AuthToken : "";

            if (string.IsNullOrEmpty(effectiveTenant))
            {
                try
                {
                    var tcRes = await _sessionStorage.GetAsync<string>("tenant_code");
                    if (tcRes.Success && !string.IsNullOrWhiteSpace(tcRes.Value)) effectiveTenant = tcRes.Value;
                }
                catch { }
            }
            if (string.IsNullOrEmpty(effectiveToken))
            {
                try
                {
                    var atRes = await _sessionStorage.GetAsync<string>("authToken");
                    if (atRes.Success && !string.IsNullOrWhiteSpace(atRes.Value)) effectiveToken = atRes.Value;
                }
                catch { }
            }

            if (string.IsNullOrEmpty(effectiveTenant) || string.IsNullOrEmpty(effectiveToken))
            {
                try
                {
                    var localSessionJson = await JS.InvokeAsync<string>("medicoSessionHelper.getSession");
                    if (!string.IsNullOrWhiteSpace(localSessionJson))
                    {
                        var jObj = Newtonsoft.Json.Linq.JObject.Parse(localSessionJson);
                        if (string.IsNullOrEmpty(effectiveTenant)) effectiveTenant = jObj["tenant_code"]?.ToString() ?? "";
                        if (string.IsNullOrEmpty(effectiveToken)) effectiveToken = jObj["authToken"]?.ToString() ?? "";
                    }
                }
                catch { }
            }

            if (string.IsNullOrEmpty(effectiveToken) && TenantState.UserData?.AuthToken != null)
            {
                effectiveToken = TenantState.UserData.AuthToken;
            }

            if (string.IsNullOrEmpty(effectiveTenant))
            {
                effectiveTenant = "0010";
            }

            int effUser = 1;
            if (TenantState?.UserCode > 0) effUser = TenantState.UserCode;
            else if (TenantState?.UserData?.UserCode.HasValue == true && TenantState.UserData.UserCode.Value > 0)
                effUser = TenantState.UserData.UserCode.Value;

            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(effectiveTenant))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", effectiveTenant);
                client.DefaultRequestHeaders.Remove("tenantcode");
                client.DefaultRequestHeaders.Add("tenantcode", effectiveTenant);
                client.DefaultRequestHeaders.Remove("tenant-code");
                client.DefaultRequestHeaders.Add("tenant-code", effectiveTenant);
            }
            if (effUser > 0)
            {
                client.DefaultRequestHeaders.Remove("usercode");
                client.DefaultRequestHeaders.Add("usercode", effUser.ToString());
                client.DefaultRequestHeaders.Remove("user_code");
                client.DefaultRequestHeaders.Add("user_code", effUser.ToString());
            }
            if (!string.IsNullOrEmpty(effectiveToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", effectiveToken);
            }

            var newBranchObj = new Booking.Models.BranchModel
            {
                tenant_code = effectiveTenant,
                name = newBranchName.Trim(),
                short_name = newBranchShortName.Trim(),
                address = string.IsNullOrWhiteSpace(newBranchAddress) ? null : newBranchAddress.Trim(),
                mobile = string.IsNullOrWhiteSpace(newBranchMobile) ? null : newBranchMobile.Trim(),
                user_code = effUser,
                computer_code = effUser,
                is_main_branch = (sessionBranches == null || sessionBranches.Count == 0),
                is_branch = true,
                is_collection_centre = false,
                order_no = (sessionBranches != null && sessionBranches.Any()) ? (sessionBranches.Count + 1) : 1,
                deleted = false,
                entered_date = DateTime.Now,
                ibs_date = DateTime.Now
            };

            var jsonPayload = JsonConvert.SerializeObject(newBranchObj, Formatting.Indented);
            Console.WriteLine($"[MainLayout] Inserting Branch. Payload:\n{jsonPayload}");

            var response = await client.PostAsJsonAsync("api/Branch/insert", newBranchObj);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Branch created successfully!");
                showQuickBranchModal = false;

                try { await _sessionStorage.DeleteAsync("UserBranches"); } catch { }
                sessionBranches.Clear();

                await LoadBranchesForSelectionAsync();

                var createdBranch = sessionBranches.FirstOrDefault(b => string.Equals(b.name?.Trim(), newBranchName.Trim(), StringComparison.OrdinalIgnoreCase));
                if (createdBranch != null)
                {
                    selectedBranchId = createdBranch.bh_code;
                    await ConfirmBranchAsync();
                }
                else if (sessionBranches.Count == 1)
                {
                    selectedBranchId = sessionBranches.First().bh_code;
                    await ConfirmBranchAsync();
                }
                else if (sessionBranches.Any())
                {
                    selectedBranchId = sessionBranches.First().bh_code;
                    await ConfirmBranchAsync();
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[MainLayout] Save branch failed ({response.StatusCode}): {err}");
                Toast.ShowError($"Failed to create branch ({response.StatusCode}): {err}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error creating branch: {ex.Message}");
            Toast.ShowError($"Error creating branch: {ex.Message}");
        }
        finally
        {
            isSavingBranch = false;
            StateHasChanged();
        }
    }

    /* --- CHROME-STYLE PERSISTENT TABS SYSTEM --- */
    public class ChromeTabItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Url { get; set; } = "";
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "bi-window";
    }

    public class TabSaveData
    {
        public List<ChromeTabItem> tabs { get; set; } = new();
        public string activeUrl { get; set; } = "";
    }

    private List<ChromeTabItem> openTabs = new();
    private string activeTabUrl = "";

    private string NormalizeTabUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "home";
        url = url.Trim();
        if (url.StartsWith("/")) url = url.Substring(1);
        int qIdx = url.IndexOf('?');
        if (qIdx >= 0) url = url.Substring(0, qIdx);
        if (string.IsNullOrWhiteSpace(url)) return "home";
        return url.ToLowerInvariant();
    }

    private string GetTabIcon(string normUrl)
    {
        var menuItem = GetAllMenuItems().FirstOrDefault(m => NormalizeTabUrl(m.Href) == normUrl);
        if (menuItem != null && !string.IsNullOrEmpty(menuItem.Icon))
        {
            return menuItem.Icon;
        }
        if (normUrl.Contains("dashboard") || normUrl == "home") return "bi-grid-fill";
        if (normUrl.Contains("patient") || normUrl.Contains("reception")) return "bi-people-fill";
        if (normUrl.Contains("bill") || normUrl.Contains("cash") || normUrl.Contains("due")) return "bi-receipt";
        if (normUrl.Contains("lab") || normUrl.Contains("result") || normUrl.Contains("vital")) return "bi-activity";
        if (normUrl.Contains("pharmacy") || normUrl.Contains("sales")) return "bi-cart-check";
        if (normUrl.Contains("stock") || normUrl.Contains("item") || normUrl.Contains("indent") || normUrl.Contains("purchase")) return "bi-boxes";
        if (normUrl.Contains("doctor")) return "bi-person-badge";
        if (normUrl.Contains("master")) return "bi-folder2";
        if (normUrl.Contains("user")) return "bi-person-lock";
        if (normUrl.Contains("setting")) return "bi-sliders";
        return "bi-window-stack";
    }

    private string GetFriendlyTabTitle(string normUrl)
    {
        var menuItem = GetAllMenuItems().FirstOrDefault(m => NormalizeTabUrl(m.Href) == normUrl);
        if (menuItem != null && !string.IsNullOrEmpty(menuItem.Title))
        {
            return menuItem.Title;
        }
        if (normUrl == "home") return "Dashboard";
        var title = GetFriendlyPageTitle();
        if (title != "Requested") return title;
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(normUrl.Replace("-", " ").Replace("/", " - "));
    }

    private void SyncCurrentPageToTabs(string relativePath)
    {
        var normUrl = NormalizeTabUrl(relativePath);
        if (IsAnonymousPath(normUrl) || !TenantState.IsAuthenticated)
        {
            return;
        }

        var existingTab = openTabs.FirstOrDefault(t => NormalizeTabUrl(t.Url) == normUrl);
        if (existingTab != null)
        {
            activeTabUrl = normUrl;
            var updatedTitle = GetFriendlyTabTitle(normUrl);
            var updatedIcon = GetTabIcon(normUrl);
            if (!string.IsNullOrEmpty(updatedTitle) && updatedTitle != "Requested") existingTab.Title = updatedTitle;
            if (!string.IsNullOrEmpty(updatedIcon)) existingTab.Icon = updatedIcon;
        }
        else
        {
            var title = GetFriendlyTabTitle(normUrl);
            var icon = GetTabIcon(normUrl);
            openTabs.Add(new ChromeTabItem
            {
                Url = normUrl,
                Title = title,
                Icon = icon
            });
            activeTabUrl = normUrl;
        }

        _ = SaveTabsToStorageAsync();
    }

    private void SelectTab(ChromeTabItem tab)
    {
        var targetUrl = NormalizeTabUrl(tab.Url);
        activeTabUrl = targetUrl;
        _ = SaveTabsToStorageAsync();

        var currentNorm = NormalizeTabUrl(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        if (currentNorm != targetUrl)
        {
            NavigationManager.NavigateTo(targetUrl == "home" ? "/home" : "/" + targetUrl);
        }
    }

    private void CloseTab(ChromeTabItem tab)
    {
        var closedNormUrl = NormalizeTabUrl(tab.Url);
        var index = openTabs.FindIndex(t => NormalizeTabUrl(t.Url) == closedNormUrl);
        
        if (index >= 0)
        {
            openTabs.RemoveAt(index);
        }

        if (openTabs.Count == 0)
        {
            var homeTab = new ChromeTabItem { Url = "home", Title = "Dashboard", Icon = "bi-grid-fill" };
            openTabs.Add(homeTab);
            activeTabUrl = "home";
            NavigationManager.NavigateTo("/home");
        }
        else if (NormalizeTabUrl(activeTabUrl) == closedNormUrl)
        {
            var newIndex = Math.Max(0, Math.Min(index - 1, openTabs.Count - 1));
            var nextTab = openTabs[newIndex];
            activeTabUrl = NormalizeTabUrl(nextTab.Url);
            var destUrl = nextTab.Url == "home" ? "/home" : "/" + nextTab.Url;
            NavigationManager.NavigateTo(destUrl);
        }

        _ = SaveTabsToStorageAsync();
        StateHasChanged();
    }

    private void CloseOtherTabsAction()
    {
        var currentNormActive = NormalizeTabUrl(activeTabUrl);
        var currentActive = openTabs.FirstOrDefault(t => NormalizeTabUrl(t.Url) == currentNormActive);
        if (currentActive != null)
        {
            openTabs.Clear();
            openTabs.Add(currentActive);
        }
        _ = SaveTabsToStorageAsync();
        StateHasChanged();
    }

    private void OpenNewTabHome()
    {
        NavigationManager.NavigateTo("/home");
    }

    private async Task SaveTabsToStorageAsync()
    {
        try
        {
            var json = JsonConvert.SerializeObject(openTabs);
            await JS.InvokeVoidAsync("medicoTabs.saveTabs", json, activeTabUrl);
        }
        catch { }
    }

    private async Task RestoreTabsFromStorageAsync()
    {
        try
        {
            var resultJson = await JS.InvokeAsync<string>("medicoTabs.loadTabs");
            if (!string.IsNullOrWhiteSpace(resultJson))
            {
                var data = JsonConvert.DeserializeObject<TabSaveData>(resultJson);
                if (data != null && data.tabs != null && data.tabs.Any())
                {
                    openTabs = data.tabs;
                    if (!string.IsNullOrWhiteSpace(data.activeUrl))
                    {
                        activeTabUrl = data.activeUrl;
                    }
                }
            }
        }
        catch { }
    }

    private async Task ScrollTabs(string direction)
    {
        try
        {
            await JS.InvokeVoidAsync("medicoTabs.scrollStrip", direction);
        }
        catch { }
    }
