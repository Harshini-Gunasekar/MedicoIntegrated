@inherits LayoutComponentBase

<div class="app-container">
    <div class="sidebar-overlay @(isSidebarVisible ? "show" : "")" @onclick="ToggleSidebar"></div>
    
    <aside class="sidebar @(isSidebarCollapsed ? "collapsed" : "") @(isSidebarVisible ? "show" : "")">
        <div class="sidebar-header">
            <div class="logo-container" style="gap: 1rem;">
                <img src="images/logo.png" style="width: 35px; height: 35px; border-radius: 10px;" alt="Medico Logo" />
                <div>
                    <div style="font-size: 1.25rem; font-weight: 900; line-height: 1; letter-spacing: -0.5px;">MEDICO</div>
                    <div style="font-size: 0.7rem; font-weight: 600; opacity: 0.7; letter-spacing: 1px; text-transform: uppercase; margin-top: 2px;">Portal</div>
                </div>
            </div>
            <div class="desktop-toggle" @onclick="ToggleCollapse" style="background: rgba(255,255,255,0.1); width: 24px; height: 24px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; cursor: pointer;">
                @(isSidebarCollapsed ? "»" : "«")
            </div>
        </div>
        
        <div class="sidebar-section-title">MAIN</div>
        <nav>
            <a href="/" class="nav-item">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </a>
        </nav>

        <div class="sidebar-section-title">CLINICAL</div>
        <nav>
            <a href="/doctors" class="nav-item">
                <i class="bi bi-person-badge"></i>
                <span>Doctors</span>
            </a>
            <a href="/slots" class="nav-item">
                <i class="bi bi-calendar-event"></i>
                <span>Slot Master</span>
            </a>
        </nav>

        <div style="margin-top: auto; padding: 1rem;">
            <!-- Bottom spacing or elements -->
        </div>
    </aside>

    <div class="top-header">
        <button class="mobile-nav-toggle" @onclick="ToggleSidebar">
            <i class="bi bi-list"></i>
        </button>

        

        @if (showProfile)
        {
            <div class="profile-card">
                <div style="font-weight: 800; color: #4a74f5; font-size: 0.9rem;">PREM KRISHNA</div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Referral Code : 3198</div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; word-break: break-all;">premkrishna2k1@gmail.com</div>
                <button class="logout-btn">Logout</button>
            </div>
        }
    </div>

    <main class="main-content">
        @Body
    </main>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    private bool showProfile = false;
    private bool isSidebarCollapsed = false;
    private bool isSidebarVisible = false;

    private void ToggleProfile() => showProfile = !showProfile;
    private void ToggleCollapse() => isSidebarCollapsed = !isSidebarCollapsed;
    private void ToggleSidebar() => isSidebarVisible = !isSidebarVisible;

    protected override void OnInitialized()
    {
        // Close sidebar on navigation (optional, but good for mobile)
    }
}
