    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("medicoTheme.getTheme");
                isDarkMode = (theme == "dark");
                StateHasChanged();
            }
            catch {}

            await ValidateAndAuthorizeAsync();
            if (TenantState.IsAuthenticated)
            {
                try
                {
                    await JS.InvokeVoidAsync("medicoPreventBackToLogin");
                }
                catch {}
            }
            await RestoreTabsFromStorageAsync();

            try
            {
                if (!WalkinStateSvc.HasActiveDraft)
                {
                    var res = await _sessionStorage.GetAsync<string>("WalkinDraftState");
                    if (res.Success && !string.IsNullOrWhiteSpace(res.Value))
                    {
                        var model = JsonConvert.DeserializeObject<Booking.Components.Pages.ReceptionBooking.WalkinDraftModel>(res.Value);
                        if (model != null && model.ShowWalkinModal)
                        {
                            WalkinStateSvc.ShowWalkinModal = true;
                            WalkinStateSvc.IsWalkinMinimized = model.IsWalkinMinimized;
                            WalkinStateSvc.PatientSearchQuery = model.PatientSearchQuery ?? "";
                            WalkinStateSvc.WalkinCustid = model.WalkinCustid;
                            WalkinStateSvc.WalkinDate = model.WalkinDate != default ? model.WalkinDate : DateTime.UtcNow.ToIndianTime().Date;
                            WalkinStateSvc.WalkinDcode = model.WalkinDcode;
                            WalkinStateSvc.WalkinNotes = model.WalkinNotes ?? "";
                            WalkinStateSvc.SelectedSlotDetailId = model.SelectedSlotDetailId;
                            WalkinStateSvc.NotifyStateChanged();
                        }
                    }
                }
            }
            catch { }

            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            SyncCurrentPageToTabs(relativePath);
            StateHasChanged();
        }
    }

    private async Task ValidateAndAuthorizeAsync()
    {
        try
        {
            var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");

            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                var rights = rightsResult.Success && rightsResult.Value != null ? rightsResult.Value : new List<SharedComponents.Rcl.Models.User_Rights>();

                var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode))
                {
                    user.BranchCode = savedBranchCode;
                }

                TenantState.SetSession(user.TenantCode ?? "", user.AuthToken ?? "", user.TenantName ?? "", user.UserCode ?? 0, user.BranchCode, user.CounterCode, user, rights);
                await CheckBranchSelectionAsync();
            }
            else
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                var tenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                var authToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                var tenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(authToken) || !string.IsNullOrEmpty(tenantCode))
                {
                    // Parse JWT claims to resolve username and role
                    string resolvedRole = ""; // DO NOT default to Administrator
                    string resolvedUserName = tenantName;
                    int resolvedUserCode = 0;
                    try
                    {
                        var segments = authToken.Split('.');
                        if (segments.Length >= 2)
                        {
                            var payload = segments[1];
                            switch (payload.Length % 4)
                            {
                                case 2: payload += "=="; break;
                                case 3: payload += "="; break;
                            }
                            var jsonBytes = Convert.FromBase64String(payload);
                            var claimsDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                            if (claimsDict != null)
                            {
                                object? rVal = null;
                                if (claimsDict.TryGetValue("role", out rVal) || claimsDict.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                                {
                                    resolvedRole = rVal?.ToString() ?? "";
                                }
                                object? uVal = null;
                                if (claimsDict.TryGetValue("unique_name", out uVal) || claimsDict.TryGetValue("name", out uVal) || claimsDict.TryGetValue("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name", out uVal))
                                {
                                    resolvedUserName = uVal?.ToString() ?? tenantName;
                                }
                                object? ucVal = null;
                                if (claimsDict.TryGetValue("usercode", out ucVal) || claimsDict.TryGetValue("user_code", out ucVal))
                                {
                                    if (int.TryParse(ucVal?.ToString(), out int uc))
                                    {
                                        resolvedUserCode = uc;
                                    }
                                }
                            }
                        }
                    }
                    catch
                    {
                        // Fallback
                    }

                    var user = new SharedComponents.Rcl.Models.UserDetailsModel
                    {
                        UserName = resolvedUserName,
                        Role = (string.Equals(resolvedRole, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(resolvedRole, "Administrator", StringComparison.OrdinalIgnoreCase)) ? "Administrator" : resolvedRole,
                        TenantCode = tenantCode,
                        TenantName = tenantName,
                        AuthToken = authToken,
                        UserCode = resolvedUserCode
                    };

                    TenantState.SetSession(tenantCode, authToken, tenantName, resolvedUserCode, null, null, user, new List<SharedComponents.Rcl.Models.User_Rights>());
                    await CheckBranchSelectionAsync();
                }
                else
                {
                    TenantState.Clear();
                }
            }
        }
        catch
        {
            // Decouple pre-rendering errors
        }

        EvaluateAccess();
        StateHasChanged();
    }

    private string GetUserInitials()
    {
        var name = TenantState.UserData?.UserName ?? "PREM KRISHNA";
        if (string.IsNullOrWhiteSpace(name)) return "M";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
    }

    private bool IsAdminOrPowerUser()
    {
        if (IsAdmin()) return true;

        var role = TenantState.UserData?.Role;
        var userCode = TenantState.UserData?.UserCode;

        if (userCode == 0 || userCode == 1) return true;

        if (!string.IsNullOrEmpty(role) && (
            role.Contains("Power", StringComparison.OrdinalIgnoreCase) ||
            role.Contains("Admin", StringComparison.OrdinalIgnoreCase) ||
            role.Contains("Owner", StringComparison.OrdinalIgnoreCase) ||
            role.Contains("Manager", StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        // Check JWT token claims for power_user flag
        var token = TenantState.AuthToken;
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var segments = token.Split('.');
                if (segments.Length >= 2)
                {
                    var payload = segments[1];
                    switch (payload.Length % 4)
                    {
                        case 2: payload += "=="; break;
                        case 3: payload += "="; break;
                    }
                    var jsonBytes = Convert.FromBase64String(payload);
                    var claimsDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                    if (claimsDict != null)
                    {
                        object? pVal = null;
                        if (claimsDict.TryGetValue("power_user", out pVal) || 
                            claimsDict.TryGetValue("is_power_user", out pVal) || 
                            claimsDict.TryGetValue("poweruser", out pVal))
                        {
                            if (pVal?.ToString()?.ToLower() == "true" || pVal?.ToString() == "1")
                            {
                                return true;
                            }
                        }
                    }
                }
            }
            catch { }
        }

        return false;
    }

    private async Task CheckBranchSelectionAsync()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!TenantState.IsAuthenticated || IsAnonymousPath(relativePath))
        {
            showBranchModal = false;
            return;
        }

        var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
        if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode) && savedBranchCode > 0)
        {
            showBranchModal = false;
            return;
        }

        // Branch code not selected yet, load branches
        await LoadBranchesForSelectionAsync();

        // If there's only 1 branch option available, auto-select it and bypass the modal dialog
        if (sessionBranches.Count == 1)
        {
            selectedBranchId = sessionBranches.First().bh_code;
            await ConfirmBranchAsync();
            return;
        }

        showBranchModal = true;
        StateHasChanged();
    }

    private async Task LoadBranchesForSelectionAsync()
    {
        try
        {
            sessionBranches.Clear();

            // Fetch all active branches from DB
            List<Booking.Models.BranchModel> allDbBranches = new();
            try
            {
                var client = ClientFactory.CreateClient("LabCareUrl");
                if (!string.IsNullOrEmpty(TenantState.TenantCode))
                {
                    client.DefaultRequestHeaders.Remove("tenant_code");
                    client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
                }
                if (!string.IsNullOrEmpty(TenantState.AuthToken))
                {
                    client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
                }

                var response = await client.GetAsync("api/Branch/get");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    allDbBranches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                }
            }
            catch (Exception apiEx)
            {
                Console.WriteLine($"Error fetching branches from DB: {apiEx.Message}");
            }

            // 1. If staff user and has branches assigned (and NOT admin/power user), use them and resolve names from DB list
            if (!IsAdminOrPowerUser() && TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
            {
                foreach (var b in TenantState.UserData.Branches)
                {
                    if (b.bh_code == 21 || string.Equals(b.name?.Trim(), "SAMPLE BRANCH", StringComparison.OrdinalIgnoreCase))
                        continue;

                    var dbBranch = allDbBranches.FirstOrDefault(x => x.bh_code == b.bh_code);
                    string actualName = dbBranch != null && !string.IsNullOrWhiteSpace(dbBranch.name) 
                        ? dbBranch.name 
                        : b.name;

                    sessionBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                    {
                        bh_code = b.bh_code,
                        name = actualName
                    });
                }
            }

            // 2. If no branches are present (e.g. Administrator/Power User), use all active branches from DB
            if (!sessionBranches.Any())
            {
                foreach (var b in allDbBranches.Where(b => !b.deleted && b.bh_code != 21 && !string.Equals(b.name?.Trim(), "SAMPLE BRANCH", StringComparison.OrdinalIgnoreCase)))
                {
                    sessionBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                    {
                        bh_code = b.bh_code,
                        name = b.name
                    });
                }
            }

            if (sessionBranches.Any())
            {
                // Remove duplicate branch options by code and exclude SAMPLE BRANCH (Code: 21)
                sessionBranches = sessionBranches
                    .Where(b => b.bh_code != 21 && !string.Equals(b.name?.Trim(), "SAMPLE BRANCH", StringComparison.OrdinalIgnoreCase))
                    .GroupBy(b => b.bh_code)
                    .Select(g => g.First())
                    .ToList();

                if (sessionBranches.Any())
                {
                    selectedBranchId = 0; // Default to SELECT BRANCH option initially
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session branches: {ex.Message}");
        }
    }

    private async Task ConfirmBranchAsync()
    {
        if (selectedBranchId <= 0) return;

        await _sessionStorage.SetAsync("bhcode", selectedBranchId.ToString());
        
        // Update TenantState session with the branch code
        var user = TenantState.UserData;
        if (user != null)
        {
            user.BranchCode = selectedBranchId;
            TenantState.SetSession(TenantState.TenantCode, TenantState.AuthToken, TenantState.TenantName, TenantState.UserCode, selectedBranchId, TenantState.CounterCode, user, TenantState.UserRightsList.ToList());
        }

        showBranchModal = false;
        StateHasChanged();
        
        // Notify navigation or reload current page to apply default branch
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private bool showQuickBranchModal = false;
    private string newBranchName = "";
    private string newBranchShortName = "";
    private string newBranchAddress = "";
    private string newBranchMobile = "";
    private bool isSavingBranch = false;

    private void OpenAddBranchModal()
    {
        newBranchName = "";
        newBranchShortName = "";
        newBranchAddress = "";
        newBranchMobile = "";
        showQuickBranchModal = true;
    }

    private async Task SaveQuickBranchAsync()
    {
        if (string.IsNullOrWhiteSpace(newBranchName))
        {
            Toast.ShowError("Please enter a Branch Name.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newBranchShortName))
        {
            var trimmed = newBranchName.Trim();
            newBranchShortName = trimmed.Length >= 3 ? trimmed.Substring(0, 3).ToUpper() : trimmed.ToUpper();
        }

        isSavingBranch = true;
        try
        {
            var client = ClientFactory.CreateClient("LabCareUrl");
            if (!string.IsNullOrEmpty(TenantState.TenantCode))
            {
                client.DefaultRequestHeaders.Remove("tenant_code");
                client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
            }
            if (!string.IsNullOrEmpty(TenantState.AuthToken))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
            }

            var newBranchObj = new
            {
                tenant_code = TenantState.TenantCode ?? "",
                name = newBranchName.Trim(),
                short_name = newBranchShortName.Trim(),
                address = newBranchAddress?.Trim(),
                mobile = newBranchMobile?.Trim(),
                user_code = 1,
                computer_code = 1,
                is_main_branch = sessionBranches.Count == 0,
                is_branch = true,
                is_collection_centre = false,
                deleted = false,
                entered_date = DateTime.Now,
                ibs_date = DateTime.Now
            };

            var response = await client.PostAsJsonAsync("api/Branch/insert", newBranchObj);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Branch created successfully!");
                showQuickBranchModal = false;

                // Reload branches to include the newly created branch
                await LoadBranchesForSelectionAsync();

                // Auto select the newly created branch if present
                var createdBranch = sessionBranches.FirstOrDefault(b => string.Equals(b.name?.Trim(), newBranchName.Trim(), StringComparison.OrdinalIgnoreCase));
                if (createdBranch != null)
                {
                    selectedBranchId = createdBranch.bh_code;
                }
                else if (sessionBranches.Count == 1)
                {
                    selectedBranchId = sessionBranches.First().bh_code;
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Failed to create branch ({response.StatusCode}): {err}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error creating branch: {ex.Message}");
        }
        finally
        {
            isSavingBranch = false;
            StateHasChanged();
        }
    }

    /* --- CHROME-STYLE PERSISTENT TABS SYSTEM --- */
    public class ChromeTabItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Url { get; set; } = "";
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "bi-window";
    }

    public class TabSaveData
    {
        public List<ChromeTabItem> tabs { get; set; } = new();
        public string activeUrl { get; set; } = "";
    }

    private List<ChromeTabItem> openTabs = new();
    private string activeTabUrl = "";

    private string NormalizeTabUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "home";
        url = url.Trim();
        if (url.StartsWith("/")) url = url.Substring(1);
        int qIdx = url.IndexOf('?');
        if (qIdx >= 0) url = url.Substring(0, qIdx);
        if (string.IsNullOrWhiteSpace(url)) return "home";
        return url.ToLowerInvariant();
    }

    private string GetTabIcon(string normUrl)
    {
        var menuItem = GetAllMenuItems().FirstOrDefault(m => NormalizeTabUrl(m.Href) == normUrl);
        if (menuItem != null && !string.IsNullOrEmpty(menuItem.Icon))
        {
            return menuItem.Icon;
        }
        if (normUrl.Contains("dashboard") || normUrl == "home") return "bi-grid-fill";
        if (normUrl.Contains("patient") || normUrl.Contains("reception")) return "bi-people-fill";
        if (normUrl.Contains("bill") || normUrl.Contains("cash") || normUrl.Contains("due")) return "bi-receipt";
        if (normUrl.Contains("lab") || normUrl.Contains("result") || normUrl.Contains("vital")) return "bi-activity";
        if (normUrl.Contains("pharmacy") || normUrl.Contains("sales")) return "bi-cart-check";
        if (normUrl.Contains("stock") || normUrl.Contains("item") || normUrl.Contains("indent") || normUrl.Contains("purchase")) return "bi-boxes";
        if (normUrl.Contains("doctor")) return "bi-person-badge";
        if (normUrl.Contains("master")) return "bi-folder2";
        if (normUrl.Contains("user")) return "bi-person-lock";
        if (normUrl.Contains("setting")) return "bi-sliders";
        return "bi-window-stack";
    }

    private string GetFriendlyTabTitle(string normUrl)
    {
        var menuItem = GetAllMenuItems().FirstOrDefault(m => NormalizeTabUrl(m.Href) == normUrl);
        if (menuItem != null && !string.IsNullOrEmpty(menuItem.Title))
        {
            return menuItem.Title;
        }
        if (normUrl == "home") return "Dashboard";
        var title = GetFriendlyPageTitle();
        if (title != "Requested") return title;
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(normUrl.Replace("-", " ").Replace("/", " - "));
    }

    private void SyncCurrentPageToTabs(string relativePath)
    {
        var normUrl = NormalizeTabUrl(relativePath);
        if (IsAnonymousPath(normUrl) || !TenantState.IsAuthenticated)
        {
            return;
        }

        var existingTab = openTabs.FirstOrDefault(t => NormalizeTabUrl(t.Url) == normUrl);
        if (existingTab != null)
        {
            activeTabUrl = normUrl;
            var updatedTitle = GetFriendlyTabTitle(normUrl);
            var updatedIcon = GetTabIcon(normUrl);
            if (!string.IsNullOrEmpty(updatedTitle) && updatedTitle != "Requested") existingTab.Title = updatedTitle;
            if (!string.IsNullOrEmpty(updatedIcon)) existingTab.Icon = updatedIcon;
        }
        else
        {
            var title = GetFriendlyTabTitle(normUrl);
            var icon = GetTabIcon(normUrl);
            openTabs.Add(new ChromeTabItem
            {
                Url = normUrl,
                Title = title,
                Icon = icon
            });
            activeTabUrl = normUrl;
        }

        _ = SaveTabsToStorageAsync();
    }

    private void SelectTab(ChromeTabItem tab)
    {
        var targetUrl = NormalizeTabUrl(tab.Url);
        activeTabUrl = targetUrl;
        _ = SaveTabsToStorageAsync();

        var currentNorm = NormalizeTabUrl(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        if (currentNorm != targetUrl)
        {
            NavigationManager.NavigateTo(targetUrl == "home" ? "/home" : "/" + targetUrl);
        }
    }

    private void CloseTab(ChromeTabItem tab)
    {
        var closedNormUrl = NormalizeTabUrl(tab.Url);
        var index = openTabs.FindIndex(t => NormalizeTabUrl(t.Url) == closedNormUrl);
        
        if (index >= 0)
        {
            openTabs.RemoveAt(index);
        }

        if (openTabs.Count == 0)
        {
            var homeTab = new ChromeTabItem { Url = "home", Title = "Dashboard", Icon = "bi-grid-fill" };
            openTabs.Add(homeTab);
            activeTabUrl = "home";
            NavigationManager.NavigateTo("/home");
        }
        else if (NormalizeTabUrl(activeTabUrl) == closedNormUrl)
        {
            var newIndex = Math.Max(0, Math.Min(index - 1, openTabs.Count - 1));
            var nextTab = openTabs[newIndex];
            activeTabUrl = NormalizeTabUrl(nextTab.Url);
            var destUrl = nextTab.Url == "home" ? "/home" : "/" + nextTab.Url;
            NavigationManager.NavigateTo(destUrl);
        }

        _ = SaveTabsToStorageAsync();
        StateHasChanged();
    }

    private void CloseOtherTabsAction()
    {
        var currentNormActive = NormalizeTabUrl(activeTabUrl);
        var currentActive = openTabs.FirstOrDefault(t => NormalizeTabUrl(t.Url) == currentNormActive);
        if (currentActive != null)
        {
            openTabs.Clear();
            openTabs.Add(currentActive);
        }
        _ = SaveTabsToStorageAsync();
        StateHasChanged();
    }

    private void OpenNewTabHome()
    {
        NavigationManager.NavigateTo("/home");
    }

    private async Task SaveTabsToStorageAsync()
    {
        try
        {
            var json = JsonConvert.SerializeObject(openTabs);
            await JS.InvokeVoidAsync("medicoTabs.saveTabs", json, activeTabUrl);
        }
        catch { }
    }

    private async Task RestoreTabsFromStorageAsync()
    {
        try
        {
            var resultJson = await JS.InvokeAsync<string>("medicoTabs.loadTabs");
            if (!string.IsNullOrWhiteSpace(resultJson))
            {
                var data = JsonConvert.DeserializeObject<TabSaveData>(resultJson);
                if (data != null && data.tabs != null && data.tabs.Any())
                {
                    openTabs = data.tabs;
                    if (!string.IsNullOrWhiteSpace(data.activeUrl))
                    {
                        activeTabUrl = data.activeUrl;
                    }
                }
            }
        }
        catch { }
    }

    private async Task ScrollTabs(string direction)
    {
        try
        {
            await JS.InvokeVoidAsync("medicoTabs.scrollStrip", direction);
        }
        catch { }
    }

    private bool showNavEndShiftModal = false;
    private bool isEndingNavShift = false;
    private string navShiftEndCounterName = "";
    private Guid selectedNavShiftCnttid = Guid.Empty;
    private List<Booking.Models.CounterTimingDto> navOpenShiftsList = new();

    private async Task PromptEndShiftInNav()
    {
        CloseSidebar();
        try
        {
            navOpenShiftsList = await HmsBillingService.GetOpenCountersAsync() ?? new();
            if (!navOpenShiftsList.Any())
            {
                Toast.ShowError("No active open counter shift found.");
                return;
            }

            int savedCntCode = 0;
            try
            {
                var cntCodeRes = await _sessionStorage.GetAsync<string>("cntcode");
                if (cntCodeRes.Success && !string.IsNullOrEmpty(cntCodeRes.Value))
                {
                    int.TryParse(cntCodeRes.Value, out savedCntCode);
                }
            }
            catch { }

            var active = navOpenShiftsList.FirstOrDefault(s => savedCntCode > 0 && s.cntcode == savedCntCode) 
                         ?? navOpenShiftsList.First();

            selectedNavShiftCnttid = active.cnttid;
            navShiftEndCounterName = $"Counter {active.cntcode}";
            showNavEndShiftModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error checking active shifts: {ex.Message}");
        }
    }

    private void CancelNavEndShift()
    {
        showNavEndShiftModal = false;
    }

    private async Task ConfirmNavEndShiftAsync()
    {
        if (selectedNavShiftCnttid == Guid.Empty) return;

        isEndingNavShift = true;
        StateHasChanged();

        try
        {
            int userCode = TenantState.UserCode > 0 ? TenantState.UserCode : 10;
            var req = new Booking.Models.CloseShiftRequest
            {
                cnttid = selectedNavShiftCnttid.ToString(),
                usercode = userCode
            };

            var responseStr = await HmsBillingService.CloseShiftAsync(req);
            if (!string.IsNullOrEmpty(responseStr) && 
                (responseStr.Contains("safely shut down", StringComparison.OrdinalIgnoreCase) || 
                 responseStr.Contains("success", StringComparison.OrdinalIgnoreCase) || 
                 responseStr.Contains("cnttid")))
            {
                Toast.ShowSuccess($"Counter shift ended successfully! Logging out...");
                try
                {
                    await _sessionStorage.DeleteAsync("cntcode");
                }
                catch { }
                showNavEndShiftModal = false;
                StateHasChanged();
                await Task.Delay(1000);
                await HandleLogout();
            }
            else
            {
                Toast.ShowError($"Failed to end shift: {responseStr}");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error ending shift: {ex.Message}");
        }
        finally
        {
            isEndingNavShift = false;
            showNavEndShiftModal = false;
            StateHasChanged();
        }
    }
