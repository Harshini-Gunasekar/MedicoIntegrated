    private void CloseSidebar()
    {
        if (isSidebarVisible)
        {
            isSidebarVisible = false;
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        TenantState.OnSessionChanged += HandleSessionChanged;
        ExpandSubmenuForCurrentUri();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            ExpandSubmenuForCurrentUri();
            EvaluateAccess();
            await CheckBranchSelectionAsync();
            StateHasChanged();
        });
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            EvaluateAccess();
            await CheckBranchSelectionAsync();
            StateHasChanged();
        });
    }

    private void EvaluateAccess()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        hasAccess = CheckPathPermission(relativePath);
        isCheckingAccess = false;

        if (hasAccess)
        {
            SyncActivePageRights(relativePath);
        }

        if (!hasAccess && !TenantState.IsAuthenticated && !IsAnonymousPath(relativePath))
        {
            // Not authenticated and trying to access a private path -> Redirect to login page
            NavigationManager.NavigateTo("/login");
        }
    }

