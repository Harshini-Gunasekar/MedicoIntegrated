    <div class="app-main-wrapper">
        @if (TenantState.IsAuthenticated && !IsAnonymousPath(NavigationManager.ToBaseRelativePath(NavigationManager.Uri)))
        {
            <div class="chrome-tab-header">
                <button class="mobile-nav-toggle" @onclick="ToggleSidebar" title="Toggle Sidebar Menu">
                    <i class="bi bi-list"></i>
                </button>

                <div class="chrome-tabs-container">
                    <button type="button" class="tab-scroll-btn left" @onclick='() => ScrollTabs("left")' title="Scroll tabs left">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="chrome-tab-strip" id="chromeTabStrip">
                        @foreach (var tab in openTabs)
                        {
                            var normTabUrl = NormalizeTabUrl(tab.Url);
                            var normActiveUrl = NormalizeTabUrl(activeTabUrl);
                            var isTabActive = normTabUrl == normActiveUrl;
                            
                            <div class="chrome-tab @(isTabActive ? "active" : "")" @onclick="() => SelectTab(tab)" title="@GetTabDisplayTitle(tab)">
                                <i class="bi @tab.Icon tab-icon"></i>
                                <span class="tab-title">@GetTabDisplayTitle(tab)</span>
                                <button type="button" class="tab-close-btn" @onclick:stopPropagation="true" @onclick="() => CloseTab(tab)" title="Close tab">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <button type="button" class="tab-scroll-btn right" @onclick='() => ScrollTabs("right")' title="Scroll tabs right">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                <div class="chrome-header-actions">
                    @if (openTabs.Count > 1)
                    {
                        <button type="button" class="chrome-action-btn" @onclick="CloseOtherTabsAction" title="Close all tabs except active tab">
                            <i class="bi bi-intersect"></i>
                            <span class="d-none d-xl-inline">Close Others</span>
                        </button>
                    }
                </div>
            </div>
        }

        <main class="main-content">
            @if (isCheckingAccess)
            {
                <div class="access-loading-container">
                    <div class="premium-spinner"></div>
                    <p class="loading-text">Verifying security parameters...</p>
                </div>
            }
            else if (!hasAccess)
            {
                <div class="access-denied-container">
                    <div class="access-denied-card">
                        <div class="lock-icon-wrapper">
                            <i class="bi bi-shield-lock lock-icon" style="font-size: 38px;"></i>
                        </div>
                        <h2 class="denied-title">Access Restricted</h2>
                        <p class="denied-message">You do not have the required permissions to view the <strong>@GetFriendlyPageTitle()</strong> module. Please contact your administrator if you believe this is an error.</p>
                        <div class="denied-actions">
                            <button class="btn-denied-primary" @onclick="GoToDashboard">
                                <i class="bi bi-grid-fill me-1"></i> Dashboard
                            </button>
                            <button class="btn-denied-secondary" @onclick="GoBack">
                                <i class="bi bi-arrow-left me-1"></i> Go Back
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </main>
        <Booking.Components.Shared.ToastContainer />
    </div>
</div>

@if (showBranchModal)
{
    <div class="operating-branch-modal-overlay">
        <div class="operating-branch-card" style="position: relative;">
            @if (!sessionBranches.Any())
            {
                <div style="position: absolute; top: 16px; right: 16px;">
                    <button type="button" @onclick="OpenAddBranchModal" title="Add New Branch" style="background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); color: #ffffff; border: none; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35); transition: transform 0.2s;">
                        <i class="bi bi-plus-lg" style="font-size: 1.2rem;"></i>
                    </button>
                </div>
            }

            <div class="operating-branch-icon-container">
                <i class="bi bi-building-check"></i>
            </div>
            
            <h2 class="operating-branch-title">Select Operating Branch</h2>
            <p class="operating-branch-subtitle">Choose your active working branch for this session.</p>

            @if (sessionBranches.Any())
            {
                <div class="operating-branch-list">
                    @foreach (var br in sessionBranches)
                    {
                        var isSelected = selectedBranchId == br.bh_code;
                        <div class="branch-list-item @(isSelected ? "selected" : "")" @onclick="() => SelectBranchCard(br.bh_code)">
                            <div class="branch-item-icon">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div class="branch-item-content">
                                <span class="branch-item-title">@br.name.ToUpper()</span>
                                <span class="branch-item-sub">Code: @br.bh_code</span>
                            </div>
                            <div class="branch-item-radio">
                                <i class="bi @(isSelected ? "bi-check-circle-fill" : "bi-circle")"></i>
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="operating-branch-btn" @onclick="ConfirmBranchAsync" disabled="@(selectedBranchId == 0)">
                    <span>Confirm Branch</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            }
            else
            {
                <div style="text-align: center; padding: 24px 16px; background: rgba(241, 245, 249, 0.6); border-radius: 12px; margin: 16px 0; border: 1.5px dashed #cbd5e1;">
                    <i class="bi bi-exclamation-circle" style="font-size: 2.2rem; color: #f59e0b; margin-bottom: 8px; display: block;"></i>
                    <h4 style="margin: 0 0 6px 0; font-size: 1rem; font-weight: 700; color: #1e293b;">No Operating Branches Found</h4>
                    <p style="margin: 0 0 16px 0; font-size: 0.85rem; color: #64748b;">There are no active branches available in this system yet.</p>
                    <button type="button" @onclick="OpenAddBranchModal" style="padding: 10px 20px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Add New Branch</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (showQuickBranchModal)
{
    <div class="modal-overlay" style="z-index: 12000; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center;">
        <div class="modal-form-card" style="background: white; border-radius: 16px; width: 440px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); border: 1px solid #e2e8f0; overflow: hidden;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
