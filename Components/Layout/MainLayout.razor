@inherits LayoutComponentBase
@using Newtonsoft.Json
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@implements IDisposable

<div class="app-container">
    <div class="sidebar-overlay @(isSidebarVisible ? "show" : "")" @onclick="ToggleSidebar"></div>
    
    <aside class="sidebar @(isSidebarCollapsed ? "collapsed" : "") @(isSidebarVisible ? "show" : "")">
        <div class="sidebar-header">
            <div class="logo-container" style="gap: 1rem;">
                <img src="images/logo.png" style="width: 35px; height: 35px; border-radius: 10px;" alt="Medico Logo" />
                <div>
                    <div class="logo-title">MEDICO</div>
                    <div class="logo-subtitle">Portal</div>
                </div>
            </div>
            <div class="desktop-toggle" @onclick="ToggleCollapse" title="@(isSidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                @if (isSidebarCollapsed)
                {
                    <i class="bi bi-chevron-right"></i>
                }
                else
                {
                    <i class="bi bi-chevron-left"></i>
                }
            </div>
        </div>

        <div class="sidebar-search-container">
            <div class="sidebar-search-wrapper">
                <i class="bi bi-search sidebar-search-icon"></i>
                <input type="text" class="sidebar-search-input" placeholder="Search menu items..." @bind="menuSearchQuery" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(menuSearchQuery))
                {
                    <button class="sidebar-search-clear" type="button" @onclick="ClearMenuSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
        </div>
        
        <div class="sidebar-menu">
            @if (!string.IsNullOrWhiteSpace(menuSearchQuery))
            {
                <div class="sidebar-search-results">
                    @{
                        var matches = GetFilteredMenuItems().ToList();
                    }
                    <div class="d-flex justify-content-between align-items-center px-1 mb-2">
                        <span class="sidebar-section-title p-0" style="font-size: 0.65rem;">SEARCH RESULTS</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill fw-bold" style="font-size: 0.65rem;">@matches.Count FOUND</span>
                    </div>
                    @if (!matches.Any())
                    {
                        <div class="text-muted p-3 text-center rounded-3 bg-white border" style="font-size: 0.8rem;">
                            <i class="bi bi-search d-block mb-1 text-secondary opacity-50" style="font-size: 1.2rem;"></i>
                            No pages found matching "<strong>@menuSearchQuery</strong>"
                        </div>
                    }
                    else
                    {
                        @foreach (var item in matches)
                        {
                            <NavLink href="@item.Href" class="nav-item sidebar-search-item d-flex justify-content-between align-items-center text-decoration-none" @onclick="OnSearchItemClick">
                                <span class="d-flex align-items-center gap-2">
                                    <i class="bi @item.Icon text-primary opacity-75"></i>
                                    <span style="font-size: 0.82rem; font-weight: 600; color: #1e293b;">@item.Title</span>
                                </span>
                                <span class="sidebar-search-badge">@item.Category</span>
                            </NavLink>
                        }
                    }
                </div>
            }
            else
            {
                <!-- DASHBOARD SECTION -->
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleDashboardSection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-grid-1x2-fill section-icon"></i>
                        <span>Dashboard</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isDashboardSectionOpen ? "open" : "")"></i>
                </div>
                @if (isDashboardSectionOpen)
                {
                    <nav>
                        <NavLink href="/home" class="nav-item" @onclick="CloseSidebar" title="Overview of Medico Portal metrics, bookings, and activities">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </NavLink>
                    </nav>
                }

                <!-- OP PORTAL SECTION -->
                @if (HasRight("Reception", "Refferal Case & Collection") || HasRight("OP", "Patient Registration OP") || HasRight("IP", "Patient Registration IP"))
                {
                    <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleOpPortalSection">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-heart-pulse-fill section-icon"></i>
                            <span>OP portal</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon @(isOpPortalSectionOpen ? "open" : "")"></i>
                    </div>
                    @if (isOpPortalSectionOpen)
                    {
                        <nav>
                            @if (HasRight("Reception", "Refferal Case & Collection"))
                            {
                                <NavLink href="/booking/reception" class="nav-item" @onclick="CloseSidebar" title="Manage patient arrivals, walk-ins, and appointments">
                                    <i class="bi bi-people-fill"></i>
                                    <span>Patient Check-In</span>
                                </NavLink>
                                <NavLink href="/booking/outpatient" class="nav-item" @onclick="CloseSidebar" title="Track and manage outpatient consultations and queues">
                                    <i class="bi bi-hospital"></i>
                                    <span>Outpatient Visiting</span>
                                </NavLink>
                                <NavLink href="/booking/customer" class="nav-item" @onclick="CloseSidebar" title="View historic logs, bookings, and customer billing records">
                                    <i class="bi bi-person-lines-fill"></i>
                                    <span>Customer History</span>
                                </NavLink>
                                <NavLink href="/slots" class="nav-item" @onclick="CloseSidebar" title="Configure and schedule doctor availability slots">
                                    <i class="bi bi-calendar-range"></i>
                                    <span>Slot Master</span>
                                </NavLink>
                            }

                            @if (HasRight("OP", "Patient Registration OP") || HasRight("IP", "Patient Registration IP"))
                            {
                                <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleReceptionMasters" style="cursor: pointer;">
                                    <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                        <i class="bi bi-folder2"></i>
                                        <span>Reception Masters</span>
                                    </span>
                                    <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isReceptionMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                                </button>
                                @if (isReceptionMastersOpen)
                                {
                                    <div class="nav-submenu">
                                        <NavLink href="/patientmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Manage central patient registrations and demographics">
                                            <span>Patient Master</span>
                                        </NavLink>
                                        <NavLink href="/country-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure country records">
                                            <span>Country Master</span>
                                        </NavLink>
                                        <NavLink href="/state-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure state records">
                                            <span>State Master</span>
                                        </NavLink>
                                        <NavLink href="/city-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure city records">
                                            <span>City Master</span>
                                        </NavLink>
                                        <NavLink href="/area-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure geographical areas and pin codes">
                                            <span>Area Master</span>
                                        </NavLink>
                                    </div>
                                }
                            }
                        </nav>
                    }
                }

                <!-- IP PORTAL SECTION -->
                @if (HasRight("Configuration", "General"))
                {
                    <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleIpPortalSection">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-hospital-fill section-icon"></i>
                            <span>IP portal</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon @(isIpPortalSectionOpen ? "open" : "")"></i>
                    </div>
                    @if (isIpPortalSectionOpen)
                    {
                        <nav>
                            <NavLink href="/booking/ip-registration" class="nav-item" @onclick="CloseSidebar" title="Inpatient IPD Registration">
                                <i class="bi bi-hospital"></i>
                                <span>IP Registration</span>
                            </NavLink>
                            <NavLink href="/booking/available-beds" class="nav-item" @onclick="CloseSidebar" title="Available Beds Status">
                                <i class="bi bi-door-open"></i>
                                <span>Available Beds</span>
                            </NavLink>
                            <NavLink href="/bed-transfer-master" class="nav-item" @onclick="CloseSidebar" title="Inpatient Bed Transfer">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Bed Transfer</span>
                            </NavLink>
                            <NavLink href="/discharge-summary" class="nav-item" @onclick="CloseSidebar" title="Discharge Summary">
                                <i class="bi bi-file-earmark-medical"></i>
                                <span>Discharge Summary</span>
                            </NavLink>

                            <!-- IPD Masters Dropdown -->
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleIpdMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>IP Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isIpdMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isIpdMastersOpen)
                            {
                                <div class="nav-submenu">
                                    <NavLink href="/bed-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Bed Master">
                                        <span>Bed Master</span>
                                    </NavLink>
                                    <NavLink href="/ward-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Ward Master">
                                        <span>Ward Master</span>
                                    </NavLink>
                                    <NavLink href="/room-type-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Room Type Master">
                                        <span>Room Type Master</span>
                                    </NavLink>
                                    <NavLink href="/floor-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Floor Master">
                                        <span>Floor Master</span>
                                    </NavLink>
                                    <NavLink href="/block-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Block Master">
                                        <span>Block Master</span>
                                    </NavLink>
                                    <NavLink href="/nurse-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Nurse Master">
                                        <span>Nurse Master</span>
                                    </NavLink>
                                    <NavLink href="/summary-templates" class="nav-submenu-item" @onclick="CloseSidebar" title="Summary Templates">
                                        <span>Summary Templates</span>
                                    </NavLink>
                                </div>
                            }
                        </nav>
                    }
                }

                <!-- BILLING PORTAL SECTION -->
                @if (HasRight("Reception", "Billing") || HasRight("Reception", "Due Collection") || HasRight("Lab", "Print Lab Result"))
                {
                    <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleBillingPortalSection">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-credit-card-2-front-fill section-icon"></i>
                            <span>Billing Portal</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon @(isBillingPortalSectionOpen ? "open" : "")"></i>
                    </div>
                    @if (isBillingPortalSectionOpen)
                    {
                        <nav>
                            @if (HasRight("Reception", "Billing"))
                            {
                                <NavLink href="/billing" class="nav-item" @onclick="CloseSidebar" title="Process payments, billing counters, and print invoices">
                                    <i class="bi bi-receipt"></i>
                                    <span>Billing Portal</span>
                                </NavLink>
                            }
                            @if (HasRight("Reception", "Due Collection"))
                            {
                                <NavLink href="/due-collection" class="nav-item" @onclick="CloseSidebar" title="Manage pending due balances and patient statement ledger">
                                    <i class="bi bi-cash-coin"></i>
                                    <span>Due Collection</span>
                                </NavLink>
                            }
                            <NavLink href="/bills" class="nav-item" @onclick="CloseSidebar" title="Search, track, and manage all patient invoices and payments logs">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Bills List</span>
                            </NavLink>
                            <NavLink href="/cash-counter" class="nav-item" @onclick="CloseSidebar" title="View cash drawer history, shift balance audits, and cash logs">
                                <i class="bi bi-wallet2"></i>
                                <span>Cash Counter</span>
                            </NavLink>
                            <NavLink href="/counter-shift" class="nav-item" @onclick="CloseSidebar" title="Manage billing counter shifts and balances">
                                <i class="bi bi-clock-history"></i>
                                <span>Counter Shift</span>
                            </NavLink>

                            <!-- Billing Masters Dropdown -->
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleBillingMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>Billing Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isBillingMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isBillingMastersOpen)
                            {
                                <div class="nav-submenu">
                                    <NavLink href="/billno-sequence" class="nav-submenu-item" @onclick="CloseSidebar" title="Bill No Sequence">
                                        <span>Bill No Sequence</span>
                                    </NavLink>
                                    <NavLink href="/feetype-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Fee Type Master">
                                        <span>Fee Type Master</span>
                                    </NavLink>
                                    <NavLink href="/counter-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Counter Master">
                                        <span>Counter Master</span>
                                    </NavLink>
                                    <NavLink href="/paymode-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Paymode Master">
                                        <span>Paymode Master</span>
                                    </NavLink>
                                    <NavLink href="/test-fee-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Test Fee Master">
                                        <span>Test Fee Master</span>
                                    </NavLink>
                                    
                                    <NavLink href="/reimbursementcompanymaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Reimbursement Company">
                                        <span>Reimbursement Co</span>
                                    </NavLink>
                                </div>
                            }
                        </nav>
                    }
                }

                <!-- LABORATORY SECTION -->
                @if (HasRight("Lab", "Lab Study") || HasRight("Configuration", "General"))
                {
                    <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleLaboratorySection">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-clipboard-pulse section-icon"></i>
                            <span>Laboratory</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon @(isLaboratorySectionOpen ? "open" : "")"></i>
                    </div>
                    @if (isLaboratorySectionOpen)
                    {
                        <nav>
                            <NavLink href="/lab-result-search" class="nav-item" @onclick="CloseSidebar" title="Result Search">
                                <i class="bi bi-search"></i>
                                <span>Result Search</span>
                            </NavLink>
                            <NavLink href="/result-entry" class="nav-item" @onclick="CloseSidebar" title="Result Entry">
                                <i class="bi bi-file-earmark-medical"></i>
                                <span>Result Entry</span>
                            </NavLink>
                            
                            <!-- Lab Masters Dropdown -->
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleLabMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>Lab Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isLabMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isLabMastersOpen)
                            {
                                <div class="nav-submenu">
                                    <NavLink href="/test-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure individual diagnostic tests, reference intervals, units, and options">
                                        <span>Test Master</span>
                                    </NavLink>
                                    <NavLink href="/test-fee-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure test prices, corporate pricing, and discounts">
                                        <span>Test Fee Master</span>
                                    </NavLink>
                                    <NavLink href="/test-type-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure test groups, departments, and categories">
                                        <span>Test Type Master</span>
                                    </NavLink>
                                    <NavLink href="/group-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure nested profiles, panels, templates, and group packages">
                                        <span>Group Master</span>
                                    </NavLink>
                                    <NavLink href="/reportmethodmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure reporting formats and methods">
                                        <span>Report Methods</span>
                                    </NavLink>
                                    <NavLink href="/sample-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure specimen/sample collection types">
                                        <span>Specimen Master</span>
                                    </NavLink>
                                    <NavLink href="/uommaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure units of measurement for lab results">
                                        <span>UOM Master</span>
                                    </NavLink>
                                    <NavLink href="/machine-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure medical analyzers and device connections">
                                        <span>Machine Master</span>
                                    </NavLink>
                                </div>
                            }
                        </nav>
                    }
                }

                <!-- PHARMACY SECTION -->
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="TogglePharmacySection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-droplet-half section-icon"></i>
                        <span>Pharmacy</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isPharmacySectionOpen ? "open" : "")"></i>
                </div>
                @if (isPharmacySectionOpen)
                {
                    <nav>
                        <NavLink href="/salesmaster" class="nav-item" @onclick="CloseSidebar" title="Pharmacy Billing">
                            <i class="bi bi-cart-check"></i>
                            <span>Pharmacy Billing</span>
                        </NavLink>
                        <NavLink href="/salesreturn" class="nav-item" @onclick="CloseSidebar" title="Sales Return">
                            <i class="bi bi-arrow-return-left"></i>
                            <span>Sales Return</span>
                        </NavLink>
                    </nav>
                }

                <!-- INVENTORY SECTION -->
                <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleInventorySection">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-boxes section-icon"></i>
                        <span>Inventory</span>
                    </span>
                    <i class="bi bi-chevron-down dropdown-arrow-icon @(isInventorySectionOpen ? "open" : "")"></i>
                </div>
                @if (isInventorySectionOpen)
                {
                    <nav>
                        <NavLink href="/purchasemaster" class="nav-item" @onclick="CloseSidebar" title="Purchase">
                            <i class="bi bi-bag-plus"></i>
                            <span>Purchase</span>
                        </NavLink>
                        <NavLink href="/purchasereturn" class="nav-item" @onclick="CloseSidebar" title="Purchase Return">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Purchase Return</span>
                        </NavLink>
                        <NavLink href="/indentrequest" class="nav-item" @onclick="CloseSidebar" title="Indent Request">
                            <i class="bi bi-file-earmark-plus"></i>
                            <span>Indent Request</span>
                        </NavLink>
                        <NavLink href="/indentapproval" class="nav-item" @onclick="CloseSidebar" title="Indent Approval">
                            <i class="bi bi-file-earmark-check"></i>
                            <span>Indent Approval</span>
                        </NavLink>
                        <NavLink href="/stock" class="nav-item" @onclick="CloseSidebar" title="Stock">
                            <i class="bi bi-boxes"></i>
                            <span>Stock</span>
                        </NavLink>

                        <!-- Inventory Masters Dropdown -->
                        <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleInventoryMasters" style="cursor: pointer;">
                            <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                <i class="bi bi-folder2"></i>
                                <span>Masters</span>
                            </span>
                            <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isInventoryMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                        </button>
                        @if (isInventoryMastersOpen)
                        {
                            <div class="nav-submenu">
                                <NavLink href="/itemmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Item Master">
                                    <span>Item Master</span>
                                </NavLink>
                                <NavLink href="/parentcategorymaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Category Master">
                                    <span>Category Master</span>
                                </NavLink>
                                <NavLink href="/categorymaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Sub Category Master">
                                    <span>Sub Category Master</span>
                                </NavLink>
                                <NavLink href="/vendormaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Vendor Master">
                                    <span>Vendor Master</span>
                                </NavLink>
                                <NavLink href="/unitmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Unit Master">
                                    <span>Unit Master</span>
                                </NavLink>
                            <NavLink href="/warehousemaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Store Master">
                                <span>Store Master</span>
                            </NavLink>
                            <NavLink href="/manufacturermaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Manufacturer Master">
                                <span>Manufacturer Master</span>
                            </NavLink>
                            <NavLink href="/ledgergroup" class="nav-submenu-item" @onclick="CloseSidebar" title="Ledger Group">
                                <span>Ledger Group</span>
                            </NavLink>
                            <NavLink href="/ledgertype" class="nav-submenu-item" @onclick="CloseSidebar" title="Ledger Type">
                                <span>Ledger Type</span>
                            </NavLink>
                        </div>
                    }
                </nav>
                }

                <!-- DOCTOR PORTAL SECTION -->
                @if (HasRight("Lab", "Lab Study") || HasRight("Configuration", "General"))
                {
                    <div class="sidebar-section-header d-flex justify-content-between align-items-center" @onclick="ToggleDoctorPortalSection">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-heart section-icon"></i>
                            <span>Doctor Portal</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon @(isDoctorPortalSectionOpen ? "open" : "")"></i>
                    </div>
                    @if (isDoctorPortalSectionOpen)
                    {
                        <nav>
                            <NavLink href="/booking/doctor" class="nav-item" @onclick="CloseSidebar" title="View and manage doctor appointments and active patient files">
                                <i class="bi bi-person-check-fill"></i>
                                <span>Doctor Patient List</span>
                            </NavLink>
                            <NavLink href="/doctor-status" class="nav-item" @onclick="CloseSidebar" title="Doctor Current Status">
                                <i class="bi bi-person-badge"></i>
                                <span>Doctor Status</span>
                            </NavLink>
                            <NavLink href="/slots" class="nav-item" @onclick="CloseSidebar" title="Configure and schedule doctor availability slots">
                                <i class="bi bi-clock"></i>
                                <span>Slot Master</span>
                            </NavLink>

                            <!-- Doctor Masters Dropdown -->
                            <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleDoctorMasters" style="cursor: pointer;">
                                <span class="d-flex align-items-center" style="gap: 0.5rem;">
                                    <i class="bi bi-folder2"></i>
                                    <span>Doctor Masters</span>
                                </span>
                                <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isDoctorMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                            </button>
                            @if (isDoctorMastersOpen)
                            {
                                <div class="nav-submenu">
