@inherits LayoutComponentBase

<div class="app-container">
    <div class="sidebar-overlay @(isSidebarVisible ? "show" : "")" @onclick="ToggleSidebar"></div>
    
    <aside class="sidebar @(isSidebarCollapsed ? "collapsed" : "") @(isSidebarVisible ? "show" : "")">
        <div class="sidebar-header">
            <div class="logo-container" style="gap: 1rem;">
                <img src="images/logo.png" style="width: 35px; height: 35px; border-radius: 10px;" alt="Medico Logo" />
                <div>
                    <div class="logo-title">MEDICO</div>
                    <div class="logo-subtitle">Portal</div>
                </div>
            </div>
            <div class="desktop-toggle" @onclick="ToggleCollapse" title="@(isSidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                @if (isSidebarCollapsed)
                {
                    <i class="bi bi-chevron-right"></i>
                }
                else
                {
                    <i class="bi bi-chevron-left"></i>
                }
            </div>
        </div>
        
        <div class="sidebar-menu">
            <div class="sidebar-section-title">MAIN</div>
            <nav>
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-item" @onclick="CloseSidebar" title="Overview of Medico Portal metrics, bookings, and activities">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </NavLink>
            </nav>

            <div class="sidebar-section-title">CLINICAL</div>
            <nav>
                <NavLink href="/doctors" class="nav-item" @onclick="CloseSidebar" title="Manage doctor profiles, specializations, and details">
                    <i class="bi bi-person-badge"></i>
                    <span>Doctors</span>
                </NavLink>
                <NavLink href="/slots" class="nav-item" @onclick="CloseSidebar" title="Configure and schedule doctor availability slots">
                    <i class="bi bi-calendar-event"></i>
                    <span>Slot Master</span>
                </NavLink>
                <NavLink href="/slot-types" class="nav-item" @onclick="CloseSidebar" title="Define and configure slot categories and templates">
                    <i class="bi bi-tags"></i>
                    <span>Slot Type Master</span>
                </NavLink>
                <NavLink href="/counter-master" class="nav-item" @onclick="CloseSidebar" title="Configure POS counters and billing details">
                    <i class="bi bi-display"></i>
                    <span>Counter Master</span>
                </NavLink>
                <NavLink href="/feetype-master" class="nav-item" @onclick="CloseSidebar" title="Configure billing fee types and commission rules">
                    <i class="bi bi-cash-stack"></i>
                    <span>Fee Type Master</span>
                </NavLink>
                <NavLink href="/test-fee-master" class="nav-item" @onclick="CloseSidebar" title="Configure test fees and pricing margins">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Test Fee Master</span>
                </NavLink>
                <NavLink href="/area-master" class="nav-item" @onclick="CloseSidebar" title="Configure geographical areas and pin codes">
                    <i class="bi bi-geo-alt"></i>
                    <span>Area Master</span>
                </NavLink>
                <NavLink href="/country-master" class="nav-item" @onclick="CloseSidebar" title="Configure country records">
                    <i class="bi bi-globe"></i>
                    <span>Country Master</span>
                </NavLink>
                <NavLink href="/state-master" class="nav-item" @onclick="CloseSidebar" title="Configure state records">
                    <i class="bi bi-map"></i>
                    <span>State Master</span>
                </NavLink>
                <NavLink href="/city-master" class="nav-item" @onclick="CloseSidebar" title="Configure city records">
                    <i class="bi bi-building"></i>
                    <span>City Master</span>
                </NavLink>
            </nav>

            <div class="sidebar-section-title">RECEPTIONIST</div>
            <nav>
                <NavLink href="/booking/reception" class="nav-item" @onclick="CloseSidebar" title="Manage patient arrivals, walk-ins, and appointments">
                    <i class="bi bi-people-fill"></i>
                    <span>Reception Portal</span>
                </NavLink>
                <NavLink href="/booking/outpatient" class="nav-item" @onclick="CloseSidebar" title="Track and manage outpatient consultations and queues">
                    <i class="bi bi-hospital"></i>
                    <span>Outpatient Visiting</span>
                </NavLink>
                <NavLink href="/billing" class="nav-item" @onclick="CloseSidebar" title="Process payments, billing counters, and print invoices">
                    <i class="bi bi-receipt"></i>
                    <span>Billing Portal</span>
                </NavLink>
                <NavLink href="/due-collection" class="nav-item" @onclick="CloseSidebar" title="Manage pending dues and patient advance accounts">
                    <i class="bi bi-cash-coin"></i>
                    <span>Due Collection</span>
                </NavLink>
                <a href="/bills" class="nav-item" @onclick="CloseSidebar">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Bills List</span>
                </a>
            </nav>

            <div class="sidebar-section-title">DOCTOR PORTAL</div>
            <nav>
                <NavLink href="/booking/doctor" class="nav-item" @onclick="CloseSidebar" title="View and manage doctor appointments and active patient files">
                    <i class="bi bi-person-check-fill"></i>
                    <span>Doctor Patient List</span>
                </NavLink>
            </nav>

            <div class="sidebar-section-title">PATIENT PORTAL</div>
            <nav>
                <NavLink href="/booking/patient" class="nav-item" @onclick="CloseSidebar" title="Book new doctor appointments for patients">
                    <i class="bi bi-calendar2-check-fill"></i>
                    <span>Patient Booking</span>
                </NavLink>
                <NavLink href="/booking/customer" class="nav-item" @onclick="CloseSidebar" title="View historic logs, bookings, and customer billing records">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Customer History</span>
                </NavLink>
            </nav>
        </div>
    </aside>

    <div class="top-header">
        <button class="mobile-nav-toggle" @onclick="ToggleSidebar">
            <i class="bi bi-list"></i>
        </button>

        

        @if (showProfile)
        {
            <div class="profile-card">
                <div style="font-weight: 800; color: #4a74f5; font-size: 0.9rem;">PREM KRISHNA</div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Referral Code : 3198</div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; word-break: break-all;">premkrishna2k1@gmail.com</div>
                <button class="logout-btn">Logout</button>
            </div>
        }
    </div>

    <main class="main-content">
        @Body
    </main>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    private bool isDueDropdownOpen = true;
    private bool showProfile = false;
    private bool isSidebarCollapsed = false;
    private bool isSidebarVisible = false;

    private void ToggleDueDropdown() => isDueDropdownOpen = !isDueDropdownOpen;
    private void ToggleProfile() => showProfile = !showProfile;
    private void ToggleCollapse() => isSidebarCollapsed = !isSidebarCollapsed;
    private void ToggleSidebar() => isSidebarVisible = !isSidebarVisible;

    private void CloseSidebar()
    {
        if (isSidebarVisible)
        {
            isSidebarVisible = false;
        }
    }

    protected override void OnInitialized()
    {
        // Close sidebar on navigation (optional, but good for mobile)
    }
}
