    private async Task ValidateAndAuthorizeAsync()
    {
        try
        {
            var userResult = await _sessionStorage.GetAsync<SharedComponents.Rcl.Models.UserDetailsModel>("UserDetails");
            var rightsResult = await _sessionStorage.GetAsync<List<SharedComponents.Rcl.Models.User_Rights>>("UserRights");

            if (userResult.Success && userResult.Value != null)
            {
                var user = userResult.Value;
                var rights = rightsResult.Success && rightsResult.Value != null ? rightsResult.Value : new List<SharedComponents.Rcl.Models.User_Rights>();

                var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
                if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode))
                {
                    user.BranchCode = savedBranchCode;
                }

                TenantState.SetSession(user.TenantCode ?? "", user.AuthToken ?? "", user.TenantName ?? "", user.UserCode ?? 0, user.BranchCode, user.CounterCode, user, rights);
                await CheckBranchSelectionAsync();
            }
            else
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                var tenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                var authToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                var tenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(authToken) || !string.IsNullOrEmpty(tenantCode))
                {
                    // Parse JWT claims to resolve username and role
                    string resolvedRole = ""; // DO NOT default to Administrator
                    string resolvedUserName = tenantName;
                    int resolvedUserCode = 0;
                    try
                    {
                        var segments = authToken.Split('.');
                        if (segments.Length >= 2)
                        {
                            var payload = segments[1];
                            switch (payload.Length % 4)
                            {
                                case 2: payload += "=="; break;
                                case 3: payload += "="; break;
                            }
                            var jsonBytes = Convert.FromBase64String(payload);
                            var claimsDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                            if (claimsDict != null)
                            {
                                object? rVal = null;
                                if (claimsDict.TryGetValue("role", out rVal) || claimsDict.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                                {
                                    resolvedRole = rVal?.ToString() ?? "";
                                }
                                object? uVal = null;
                                if (claimsDict.TryGetValue("unique_name", out uVal) || claimsDict.TryGetValue("name", out uVal) || claimsDict.TryGetValue("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name", out uVal))
                                {
                                    resolvedUserName = uVal?.ToString() ?? tenantName;
                                }
                                object? ucVal = null;
                                if (claimsDict.TryGetValue("usercode", out ucVal) || claimsDict.TryGetValue("user_code", out ucVal))
                                {
                                    if (int.TryParse(ucVal?.ToString(), out int uc))
                                    {
                                        resolvedUserCode = uc;
                                    }
                                }
                            }
                        }
                    }
                    catch
                    {
                        // Fallback
                    }

                    var user = new SharedComponents.Rcl.Models.UserDetailsModel
                    {
                        UserName = resolvedUserName,
                        Role = (string.Equals(resolvedRole, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(resolvedRole, "Administrator", StringComparison.OrdinalIgnoreCase)) ? "Administrator" : resolvedRole,
                        TenantCode = tenantCode,
                        TenantName = tenantName,
                        AuthToken = authToken,
                        UserCode = resolvedUserCode
                    };

                    TenantState.SetSession(tenantCode, authToken, tenantName, resolvedUserCode, null, null, user, new List<SharedComponents.Rcl.Models.User_Rights>());
                    await CheckBranchSelectionAsync();
                }
                else
                {
                    TenantState.Clear();
                }
            }
        }
        catch
        {
            // Decouple pre-rendering errors
        }

        EvaluateAccess();
        StateHasChanged();
    }

    private string GetUserInitials()
    {
        var name = TenantState.UserData?.UserName ?? "PREM KRISHNA";
        if (string.IsNullOrWhiteSpace(name)) return "M";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
    }

    private bool IsAdminOrPowerUser()
    {
        if (IsAdmin()) return true;

        var role = TenantState.UserData?.Role;
        var userCode = TenantState.UserData?.UserCode;

        if (userCode == 0 || userCode == 1) return true;

        if (!string.IsNullOrEmpty(role) && (
            role.Contains("Power", StringComparison.OrdinalIgnoreCase) ||
            role.Contains("Admin", StringComparison.OrdinalIgnoreCase) ||
            role.Contains("Owner", StringComparison.OrdinalIgnoreCase) ||
            role.Contains("Manager", StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        // Check JWT token claims for power_user flag
        var token = TenantState.AuthToken;
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var segments = token.Split('.');
                if (segments.Length >= 2)
                {
                    var payload = segments[1];
                    switch (payload.Length % 4)
                    {
                        case 2: payload += "=="; break;
                        case 3: payload += "="; break;
                    }
                    var jsonBytes = Convert.FromBase64String(payload);
                    var claimsDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                    if (claimsDict != null)
                    {
                        object? pVal = null;
                        if (claimsDict.TryGetValue("power_user", out pVal) || 
                            claimsDict.TryGetValue("is_power_user", out pVal) || 
                            claimsDict.TryGetValue("poweruser", out pVal))
                        {
                            if (pVal?.ToString()?.ToLower() == "true" || pVal?.ToString() == "1")
                            {
                                return true;
                            }
                        }
                    }
                }
            }
            catch { }
        }

        return false;
    }

    private async Task CheckBranchSelectionAsync()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!TenantState.IsAuthenticated || IsAnonymousPath(relativePath))
        {
            showBranchModal = false;
            return;
        }

        var bhCodeResult = await _sessionStorage.GetAsync<string>("bhcode");
        if (bhCodeResult.Success && !string.IsNullOrEmpty(bhCodeResult.Value) && int.TryParse(bhCodeResult.Value, out int savedBranchCode) && savedBranchCode > 0)
        {
            showBranchModal = false;
            return;
        }

        // Branch code not selected yet, load branches
        await LoadBranchesForSelectionAsync();

        // If there's only 1 branch option available, auto-select it and bypass the modal dialog
        if (sessionBranches.Count == 1)
        {
            selectedBranchId = sessionBranches.First().bh_code;
            await ConfirmBranchAsync();
            return;
        }

        showBranchModal = true;
        StateHasChanged();
    }

    private async Task LoadBranchesForSelectionAsync()
    {
        try
        {
            sessionBranches.Clear();

            // Fetch all active branches from DB
            List<Booking.Models.BranchModel> allDbBranches = new();
            try
            {
                var client = ClientFactory.CreateClient("LabCareUrl");
                if (!string.IsNullOrEmpty(TenantState.TenantCode))
                {
                    client.DefaultRequestHeaders.Remove("tenant_code");
                    client.DefaultRequestHeaders.Add("tenant_code", TenantState.TenantCode);
                }
                if (!string.IsNullOrEmpty(TenantState.AuthToken))
                {
                    client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TenantState.AuthToken);
                }

                var response = await client.GetAsync("api/Branch/get");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    allDbBranches = JsonConvert.DeserializeObject<List<Booking.Models.BranchModel>>(json) ?? new();
                }
            }
            catch (Exception apiEx)
            {
                Console.WriteLine($"Error fetching branches from DB: {apiEx.Message}");
            }

            // 1. If staff user and has branches assigned (and NOT admin/power user), use them and resolve names from DB list
            if (!IsAdminOrPowerUser() && TenantState.UserData?.Branches != null && TenantState.UserData.Branches.Any())
            {
                foreach (var b in TenantState.UserData.Branches)
                {
                    var dbBranch = allDbBranches.FirstOrDefault(x => x.bh_code == b.bh_code);
                    string actualName = dbBranch != null && !string.IsNullOrWhiteSpace(dbBranch.name) 
                        ? dbBranch.name 
                        : b.name;

                    sessionBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                    {
                        bh_code = b.bh_code,
                        name = actualName
                    });
                }
            }

            // 2. If no branches are present (e.g. Administrator/Power User), use all active branches from DB
            if (!sessionBranches.Any())
            {
                foreach (var b in allDbBranches.Where(b => !b.deleted))
                {
                    sessionBranches.Add(new SharedComponents.Rcl.Models.BranchModel
                    {
                        bh_code = b.bh_code,
                        name = b.name
                    });
                }
            }

            if (sessionBranches.Any())
            {
                // Remove duplicate branch options by code
                sessionBranches = sessionBranches
                    .GroupBy(b => b.bh_code)
                    .Select(g => g.First())
                    .ToList();

                if (sessionBranches.Any())
                {
                    selectedBranchId = 0; // Default to SELECT BRANCH option initially
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session branches: {ex.Message}");
        }
    }

    private async Task ConfirmBranchAsync()
    {
        if (selectedBranchId <= 0) return;

        await _sessionStorage.SetAsync("bhcode", selectedBranchId.ToString());
        
        // Update TenantState session with the branch code
        var user = TenantState.UserData;
        if (user != null)
        {
            user.BranchCode = selectedBranchId;
            TenantState.SetSession(TenantState.TenantCode, TenantState.AuthToken, TenantState.TenantName, TenantState.UserCode, selectedBranchId, TenantState.CounterCode, user, TenantState.UserRightsList.ToList());
        }

        showBranchModal = false;
        StateHasChanged();
        
        // Notify navigation or reload current page to apply default branch
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
