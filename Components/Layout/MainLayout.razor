@inherits LayoutComponentBase
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="app-container">
    <div class="sidebar-overlay @(isSidebarVisible ? "show" : "")" @onclick="ToggleSidebar"></div>
    
    <aside class="sidebar @(isSidebarCollapsed ? "collapsed" : "") @(isSidebarVisible ? "show" : "")">
        <div class="sidebar-header">
            <div class="logo-container" style="gap: 1rem;">
                <img src="images/logo.png" style="width: 35px; height: 35px; border-radius: 10px;" alt="Medico Logo" />
                <div>
                    <div class="logo-title">MEDICO</div>
                    <div class="logo-subtitle">Portal</div>
                </div>
            </div>
            <div class="desktop-toggle" @onclick="ToggleCollapse" title="@(isSidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
                @if (isSidebarCollapsed)
                {
                    <i class="bi bi-chevron-right"></i>
                }
                else
                {
                    <i class="bi bi-chevron-left"></i>
                }
            </div>
        </div>
        
        <div class="sidebar-menu">
            <div class="sidebar-section-title">Dashboard</div>
            <nav>
                <NavLink href="/home" class="nav-item" @onclick="CloseSidebar" title="Overview of Medico Portal metrics, bookings, and activities">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </NavLink>
            </nav>

            @if (HasRight("Reception", "Refferal Case & Collection") || HasRight("OP", "Patient Registration OP") || HasRight("IP", "Patient Registration IP"))
            {
                <div class="sidebar-section-title">Reception & Patients</div>
                <nav>
                    @if (HasRight("Reception", "Refferal Case & Collection"))
                    {
                        <NavLink href="/booking/reception" class="nav-item" @onclick="CloseSidebar" title="Manage patient arrivals, walk-ins, and appointments">
                            <i class="bi bi-people-fill"></i>
                            <span>Reception Portal</span>
                        </NavLink>
                    }
                    @if (HasRight("OP", "Patient Registration OP") || HasRight("IP", "Patient Registration IP"))
                    {
                        <NavLink href="/booking/patient" class="nav-item" @onclick="CloseSidebar" title="Book new doctor appointments for patients">
                            <i class="bi bi-calendar2-check-fill"></i>
                            <span>Patient Booking</span>
                        </NavLink>
                    }
                    @if (HasRight("Reception", "Refferal Case & Collection"))
                    {
                        <NavLink href="/booking/outpatient" class="nav-item" @onclick="CloseSidebar" title="Track and manage outpatient consultations and queues">
                            <i class="bi bi-hospital"></i>
                            <span>Outpatient Visiting</span>
                        </NavLink>
                    }
                    @if (HasRight("OP", "Patient Registration OP") || HasRight("IP", "Patient Registration IP"))
                    {
                        <NavLink href="/patientmaster" class="nav-item" @onclick="CloseSidebar" title="Manage central patient registrations and demographics">
                            <i class="bi bi-person-circle"></i>
                            <span>Patient Master</span>
                        </NavLink>
                    }
                    @if (HasRight("Reception", "Refferal Case & Collection"))
                    {
                        <NavLink href="/booking/customer" class="nav-item" @onclick="CloseSidebar" title="View historic logs, bookings, and customer billing records">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Customer History</span>
                        </NavLink>
                    }
                </nav>
            }

            @if (HasRight("Reception", "Billing") || HasRight("Reception", "Due Collection") || HasRight("Lab", "Print Lab Result"))
            {
                <div class="sidebar-section-title">Billing & Finance</div>
                <nav>
                    @if (HasRight("Reception", "Billing"))
                    {
                        <NavLink href="/billing" class="nav-item" @onclick="CloseSidebar" title="Process payments, billing counters, and print invoices">
                            <i class="bi bi-receipt"></i>
                            <span>Billing Portal</span>
                        </NavLink>
                    }
                    @if (HasRight("Reception", "Due Collection"))
                    {
                        <NavLink href="/due-collection" class="nav-item" @onclick="CloseSidebar" title="Manage pending dues and patient collection">
                            <i class="bi bi-cash-coin"></i>
                            <span>Due Collection</span>
                        </NavLink>
                    }
                    @if (HasRight("Lab", "Print Lab Result"))
                    {
                        <NavLink href="/bills" class="nav-item" @onclick="CloseSidebar" title="View generated invoices list and print options">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Bills List</span>
                        </NavLink>
                        <NavLink href="/billno-sequence" class="nav-item" @onclick="CloseSidebar" title="Configure prefix and numbering sequence for invoices">
                            <i class="bi bi-sort-numeric-down"></i>
                            <span>Bill No Sequence</span>
                        </NavLink>
                    }
                </nav>
            }

            @if (HasRight("Lab", "Lab Study"))
            {
                <div class="sidebar-section-title">Doctors & Clinical</div>
                <nav>
                    <NavLink href="/booking/doctor" class="nav-item" @onclick="CloseSidebar" title="View and manage doctor appointments and active patient files">
                        <i class="bi bi-person-check-fill"></i>
                        <span>Doctor Patient List</span>
                    </NavLink>
                </nav>
            }

            @if (HasRight("Configuration", "General"))
            {
                <div class="sidebar-section-title">Masters</div>
                <nav>
                    <!-- Doctor Masters -->
                    <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleDoctorMasters" style="cursor: pointer;">
                        <span class="d-flex align-items-center" style="gap: 0.5rem;">
                            <i class="bi bi-person-badge"></i>
                            <span>Doctor Masters</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isDoctorMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                    </button>
                    @if (isDoctorMastersOpen)
                    {
                        <div class="nav-submenu">
                            <NavLink href="/doctors" class="nav-submenu-item" @onclick="CloseSidebar" title="Manage doctor profiles, specializations, and details">
                                <span>Doctors Master</span>
                            </NavLink>
                            <NavLink href="/doctor-specialties" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure doctor medical specializations">
                                <span>Doctor Specialties</span>
                            </NavLink>
                            <NavLink href="/doctor-types" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure doctor types and categories">
                                <span>Doctor Types</span>
                            </NavLink>
                            <NavLink href="/slots" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure and schedule doctor availability slots">
                                <span>Slot Master</span>
                            </NavLink>
                            <NavLink href="/slot-types" class="nav-submenu-item" @onclick="CloseSidebar" title="Define and configure slot categories and templates">
                                <span>Slot Type Master</span>
                            </NavLink>
                        </div>
                    }

                    <!-- Lab Masters -->
                    <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleLabMasters" style="cursor: pointer;">
                        <span class="d-flex align-items-center" style="gap: 0.5rem;">
                            <i class="bi bi-folder2"></i>
                            <span>Lab Masters</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isLabMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                    </button>
                    @if (isLabMastersOpen)
                    {
                        <div class="nav-submenu">
                            <NavLink href="/test-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure pathology/radiology laboratory tests and parameters">
                                <span>Test Master</span>
                            </NavLink>
                            <NavLink href="/test-fee-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure test fees and pricing margins">
                                <span>Test Fee Master</span>
                            </NavLink>
                            <NavLink href="/test-type-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Define test categories and departments">
                                <span>Test Type Master</span>
                            </NavLink>
                            <NavLink href="/group-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure laboratory test grouping options">
                                <span>Group Master</span>
                            </NavLink>
                            <NavLink href="/reportmethodmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure reporting formats and methods">
                                <span>Report Methods</span>
                            </NavLink>
                            <NavLink href="/sample-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure specimen/sample collection types">
                                <span>Specimen Master</span>
                            </NavLink>
                            <NavLink href="/uom-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure units of measurement for lab results">
                                <span>UOM Master</span>
                            </NavLink>
                            <NavLink href="/machine-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure medical analyzers and device connections">
                                <span>Machine Master</span>
                            </NavLink>
                        </div>
                    }

                    <!-- Org Masters -->
                    <button type="button" class="nav-item w-100 text-start bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick="ToggleOrgMasters" style="cursor: pointer;">
                        <span class="d-flex align-items-center" style="gap: 0.5rem;">
                            <i class="bi bi-building"></i>
                            <span>Org Masters</span>
                        </span>
                        <i class="bi bi-chevron-down dropdown-arrow-icon" style="transform: @(isOrgMastersOpen ? "rotate(180deg)" : "rotate(0deg)")"></i>
                    </button>
                    @if (isOrgMastersOpen)
                    {
                        <div class="nav-submenu">
                            <NavLink href="/branchmaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure organizational branch offices and details">
                                <span>Branch Master</span>
                            </NavLink>
                            <NavLink href="/counter-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure POS counters and billing details">
                                <span>Counter Master</span>
                            </NavLink>
                            <NavLink href="/counter-shift" class="nav-submenu-item" @onclick="CloseSidebar" title="Manage shifts and cash declarations for POS counters">
                                <span>Counter Shift</span>
                            </NavLink>
                            <NavLink href="/feetype-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure billing fee types and commission rules">
                                <span>Fee Type Master</span>
                            </NavLink>
                            <NavLink href="/reimbursementcompanymaster" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure insurance and reimbursement sponsor companies">
                                <span>Reimbursement Co</span>
                            </NavLink>
                            <NavLink href="/country-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure country records">
                                <span>Country Master</span>
                            </NavLink>
                            <NavLink href="/state-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure state records">
                                <span>State Master</span>
                            </NavLink>
                            <NavLink href="/city-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure city records">
                                <span>City Master</span>
                            </NavLink>
                            <NavLink href="/area-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure geographical areas and pin codes">
                                <span>Area Master</span>
                            </NavLink>
                            <NavLink href="/user-master" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure portal user accounts and role permissions">
                                <span>User Master</span>
                            </NavLink>
                            <NavLink href="/UserRights" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure user rights and permissions">
                                <span>User Rights</span>
                            </NavLink>
                            <NavLink href="/settings" class="nav-submenu-item" @onclick="CloseSidebar" title="Configure report layouts, branding, and tenant settings">
                                <span>Report Settings</span>
                            </NavLink>
                        </div>
                    }
                </nav>
            }
        </div>
    </aside>

    <div class="top-header">
        <button class="mobile-nav-toggle" @onclick="ToggleSidebar">
            <i class="bi bi-list"></i>
        </button>

        @if (showProfile)
        {
            <div class="profile-card">
                <div style="font-weight: 800; color: #4a74f5; font-size: 0.9rem;">@(TenantState.UserData?.UserName ?? "PREM KRISHNA")</div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Role : @(TenantState.UserData?.Role ?? "Administrator")</div>
                @if (TenantState.UserData != null && !string.IsNullOrEmpty(TenantState.TenantCode))
                {
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Tenant : @TenantState.TenantCode</div>
                }
                <button class="logout-btn" @onclick="HandleLogout">Logout</button>
            </div>
        }
    </div>

    <main class="main-content">
        @if (isCheckingAccess)
        {
            <div class="access-loading-container">
                <div class="premium-spinner"></div>
                <p class="loading-text">Verifying security parameters...</p>
            </div>
        }
        else if (!hasAccess)
        {
            <div class="access-denied-container">
                <div class="access-denied-card">
                    <div class="lock-icon-wrapper">
                        <i class="bi bi-shield-lock lock-icon" style="font-size: 38px;"></i>
                    </div>
                    <h2 class="denied-title">Access Restricted</h2>
                    <p class="denied-message">You do not have the required permissions to view the <strong>@GetFriendlyPageTitle()</strong> module. Please contact your administrator if you believe this is an error.</p>
                    <div class="denied-actions">
                        <button class="btn-denied-primary" @onclick="GoToDashboard">
                            <i class="bi bi-grid-fill me-1"></i> Dashboard
                        </button>
                        <button class="btn-denied-secondary" @onclick="GoBack">
                            <i class="bi bi-arrow-left me-1"></i> Go Back
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @Body
        }
    </main>
    <Booking.Components.Shared.ToastContainer />
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool isCheckingAccess = true;
    private bool hasAccess = false;
    private bool isDisposed = false;

    private bool isDueDropdownOpen = true;
    private bool showProfile = false;
    private bool isSidebarCollapsed = false;
    private bool isSidebarVisible = false;

    private bool isDoctorMastersOpen = false;
    private bool isLabMastersOpen = false;
    private bool isOrgMastersOpen = false;

    private void ToggleDueDropdown() => isDueDropdownOpen = !isDueDropdownOpen;
    private void ToggleProfile() => showProfile = !showProfile;
    private void ToggleCollapse() => isSidebarCollapsed = !isSidebarCollapsed;
    private void ToggleSidebar() => isSidebarVisible = !isSidebarVisible;

    private void ToggleDoctorMasters() => isDoctorMastersOpen = !isDoctorMastersOpen;
    private void ToggleLabMasters() => isLabMastersOpen = !isLabMastersOpen;
    private void ToggleOrgMasters() => isOrgMastersOpen = !isOrgMastersOpen;

    private void CloseSidebar()
    {
        if (isSidebarVisible)
        {
            isSidebarVisible = false;
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        TenantState.OnSessionChanged += HandleSessionChanged;
        ExpandSubmenuForCurrentUri();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ExpandSubmenuForCurrentUri();
        EvaluateAccess();
        StateHasChanged();
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (isDisposed) return;
            EvaluateAccess();
            StateHasChanged();
        });
    }

    private void EvaluateAccess()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        hasAccess = CheckPathPermission(relativePath);
        isCheckingAccess = false;

        if (hasAccess)
        {
            SyncActivePageRights(relativePath);
        }

        if (!hasAccess && !TenantState.IsAuthenticated && !IsAnonymousPath(relativePath))
        {
            // Not authenticated and trying to access a private path -> Redirect to login page
            NavigationManager.NavigateTo("/login");
        }
    }

    private void SyncActivePageRights(string relativePath)
    {
        var path = NormalizePath(relativePath);
        string? targetModule = null;
        string department = "Configuration";
        string genericModule = "General";

        switch (path)
        {
            // Configuration General
            case "test-master":
            case "test-masters":
                targetModule = "Test_Master";
                break;
            case "machine-master":
                targetModule = "Machine_Master";
                break;
            case "uom-master":
            case "uoms":
            case "unit-master":
                targetModule = "Uom_Master";
                break;
            case "group-master":
            case "groups":
                targetModule = "Group Master";
                break;
            case "state-master":
                targetModule = "State_Master";
                break;
            case "branchmaster":
                targetModule = "Branch_Master";
                break;
            case "counter-master":
                targetModule = "Counter Master";
                break;
            case "counter-shift":
                targetModule = "Counter_Shift";
                break;
            case "feetype-master":
                targetModule = "Fee_Type_Master";
                break;
            case "reimbursementcompanymaster":
            case "reimbursements":
                targetModule = "Reimbursement_Co";
                break;
            case "country-master":
                targetModule = "Country_Master";
                break;
            case "city-master":
                targetModule = "City_Master ";
                break;
            case "area-master":
                targetModule = "Area_Master";
                break;
            case "user-master":
                targetModule = "User_Master";
                break;
            case "userrights":
                targetModule = "User_Rights";
                break;
            case "settings":
                targetModule = "Report_Settings";
                break;
            case "reportmethodmaster":
            case "report-methods":
                targetModule = "Report_Methods";
                break;
            case "sample-master":
            case "samples":
                targetModule = "Specimen_Master";
                break;
            case "test-fee-master":
                targetModule = "Test_Fee_Master";
                break;
            case "slot-types":
                targetModule = "Slot_Type_Master";
                break;
            case "test-type-master":
            case "test-types":
                targetModule = "Test_Type_Master";
                break;
            case "doctor-specialties":
                targetModule = "Doctor_Specialties";
                break;
            case "doctor-types":
            case "doctortypemaster":
                targetModule = "Doctor_Types";
                break;
            case "slots":
                targetModule = "Slot_Master";
                break;

            // Reception Portal
            case "booking/reception":
                targetModule = "Reception_Portal";
                department = "Reception";
                genericModule = "Refferal Case & Collection";
                break;
            case "booking/customer":
                targetModule = "Customer_History";
                department = "Reception";
                genericModule = "Refferal Case & Collection";
                break;
            case "booking/outpatient":
                targetModule = "Outpatient_Visiting";
                department = "Reception";
                genericModule = "Refferal Case & Collection";
                break;

            // Billing Portal
            case "billing":
                targetModule = "Billing_Portal";
                department = "Reception";
                genericModule = "Billing";
                break;

            // Due Collection
            case "due-collection":
            case "due-collection-history":
                targetModule = "Due_Collection";
                department = "Reception";
                genericModule = "Due Collection";
                break;

            // Lab Print Result
            case "bills":
                targetModule = "Bill_List ";
                department = "Lab";
                genericModule = "Print Lab Result";
                break;
            case "billno-sequence":
                targetModule = "Bill_No_Sequence";
                department = "Lab";
                genericModule = "Print Lab Result";
                break;

            // Lab Study
            case "booking/doctor":
                targetModule = "Doctor_Patient_List";
                department = "Lab";
                genericModule = "Lab Study";
                break;

            // OP Patient Master
            case "booking/patient":
            case "patientmaster":
                targetModule = "Patient_master";
                department = "OP";
                genericModule = "Patient Registration OP";
                break;
        }

        if (targetModule != null && TenantState.UserRightsList != null)
        {
            var targetRight = TenantState.UserRightsList.FirstOrDefault(x => 
                string.Equals(x.ModuleName, targetModule, StringComparison.OrdinalIgnoreCase));

            var generalRight = TenantState.UserRightsList.FirstOrDefault(x => 
                string.Equals(x.Department, department, StringComparison.OrdinalIgnoreCase) && 
                string.Equals(x.ModuleName, genericModule, StringComparison.OrdinalIgnoreCase));

            if (generalRight == null)
            {
                generalRight = new SharedComponents.Rcl.Models.User_Rights
                {
                    Department = department,
                    ModuleName = genericModule
                };
                TenantState.UserRightsList.Add(generalRight);
            }

            if (targetRight != null)
            {
                generalRight.ToAdd = targetRight.ToAdd;
                generalRight.ToEdit = targetRight.ToEdit;
                generalRight.ToDelete = targetRight.ToDelete;
                generalRight.ToView = targetRight.ToView;
            }
            else
            {
                generalRight.ToAdd = false;
                generalRight.ToEdit = false;
                generalRight.ToDelete = false;
                generalRight.ToView = false;
            }
        }
    }

    private bool IsAnonymousPath(string path)
    {
        path = NormalizePath(path);
        return string.IsNullOrEmpty(path) || 
               path == "login" || 
               path == "user-login" || 
               path == "forgot-password" ||
               path == "register";
    }

    private string NormalizePath(string path)
    {
        path = path.Trim().ToLower();
        if (path.StartsWith("/"))
        {
            path = path.Substring(1);
        }
        int queryIndex = path.IndexOf('?');
        if (queryIndex >= 0)
        {
            path = path.Substring(0, queryIndex);
        }
        return path;
    }

    private bool CheckPathPermission(string path)
    {
        path = NormalizePath(path);

        if (IsAnonymousPath(path))
        {
            return true;
        }

        if (!TenantState.IsAuthenticated)
        {
            return false;
        }

        // Administrator bypass
        if (IsAdmin())
        {
            return true;
        }

        switch (path)
        {
            // Reception & Patients
            case "booking/reception":
                return HasRight("Reception", "Reception_Portal");
            case "booking/customer":
                return HasRight("Reception", "Customer_History");
            case "booking/outpatient":
                return HasRight("Reception", "Outpatient_Visiting");

            case "booking/patient":
            case "patientmaster":
                return HasRight("OP", "Patient_master");

            // Billing & Finance
            case "billing":
                return HasRight("Reception", "Billing_Portal");

            case "due-collection":
            case "due-collection-history":
                return HasRight("Reception", "Due_Collection");

            case "bills":
                return HasRight("Lab", "Bill_List ");
            case "billno-sequence":
                return HasRight("Lab", "Bill_No_Sequence");

            // Doctors & Clinical
            case "booking/doctor":
                return HasRight("Lab", "Doctor_Patient_List");

            // Configuration / General / Admin Master Modules (Requires Configuration/General)
            case "doctors":
            case "doctorspecialtymaster":
                return HasRight("Configuration", "Doctors_Master");
            case "doctor-specialties":
                return HasRight("Configuration", "Doctor_Specialties");
            case "doctor-types":
            case "doctortypemaster":
                return HasRight("Configuration", "Doctor_Types");
            case "slots":
                return HasRight("Configuration", "Slot_Master");
            case "slot-types":
                return HasRight("Configuration", "Slot_Type_Master");
            case "test-master":
            case "test-masters":
                return HasRight("Configuration", "Test_Master");
            case "test-fee-master":
                return HasRight("Configuration", "Test_Fee_Master");
            case "test-type-master":
            case "test-types":
                return HasRight("Configuration", "Test_Type_Master");
            case "group-master":
            case "groups":
                return HasRight("Configuration", "Group Master");
            case "reportmethodmaster":
            case "report-methods":
                return HasRight("Configuration", "Report_Methods");
            case "sample-master":
            case "samples":
                return HasRight("Configuration", "Specimen_Master");
            case "uom-master":
            case "uoms":
            case "unit-master":
                return HasRight("Configuration", "Uom_Master");
            case "machine-master":
                return HasRight("Configuration", "Machine_Master");
            case "branchmaster":
                return HasRight("Configuration", "Branch_Master");
            case "counter-master":
                return HasRight("Configuration", "Counter Master");
            case "counter-shift":
                return HasRight("Configuration", "Counter_Shift");
            case "feetype-master":
                return HasRight("Configuration", "Fee_Type_Master");
            case "reimbursementcompanymaster":
            case "reimbursements":
                return HasRight("Configuration", "Reimbursement_Co");
            case "country-master":
                return HasRight("Configuration", "Country_Master");
            case "state-master":
                return HasRight("Configuration", "State_Master");
            case "city-master":
                return HasRight("Configuration", "City_Master ");
            case "area-master":
                return HasRight("Configuration", "Area_Master");
            case "user-master":
                return HasRight("Configuration", "User_Master");
            case "userrights":
                return HasRight("Configuration", "User_Rights");
            case "settings":
                return HasRight("Configuration", "Report_Settings");

            default:
                // Unmapped internal pages require at least basic authentication
                return true;
        }
    }

    private bool IsAdmin()
    {
        var role = TenantState.UserData?.Role;
        if (string.IsNullOrEmpty(role))
        {
            var token = TenantState.AuthToken;
            if (!string.IsNullOrEmpty(token))
            {
                try
                {
                    var segments = token.Split('.');
                    if (segments.Length >= 2)
                    {
                        var payload = segments[1];
                        switch (payload.Length % 4)
                        {
                            case 2: payload += "=="; break;
                            case 3: payload += "="; break;
                        }
                        var jsonBytes = Convert.FromBase64String(payload);
                        var claimsDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                        if (claimsDict != null)
                        {
                            object? rVal = null;
                            if (claimsDict.TryGetValue("role", out rVal) || claimsDict.TryGetValue("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out rVal))
                            {
                                role = rVal?.ToString();
                            }
                        }
                    }
                }
                catch { }
            }
        }

        if (string.IsNullOrEmpty(role)) return false;
        return string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(role, "Tenant", StringComparison.OrdinalIgnoreCase);
    }

    private bool HasRight(string department, string moduleName)
    {
        if (IsAdmin())
        {
            return true;
        }
        if (TenantState.UserRightsList == null || TenantState.UserRightsList.Count == 0)
        {
            return false;
        }
        return TenantState.UserRightsList.Any(r => 
            string.Equals(r.Department, department, StringComparison.OrdinalIgnoreCase) && 
            string.Equals(r.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase) &&
            r.ToView);
    }

