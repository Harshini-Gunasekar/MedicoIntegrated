                            <i class="bi bi-arrow-left me-1"></i> Go Back
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @Body
        }
    </main>
    <Booking.Components.Shared.ToastContainer />
</div>

@if (showBranchModal)
{
    <div class="operating-branch-modal-overlay">
