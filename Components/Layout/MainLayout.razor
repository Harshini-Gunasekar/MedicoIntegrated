    private void ExpandSubmenuForCurrentUri()
    {
        var uri = new Uri(NavigationManager.Uri);
        var path = uri.AbsolutePath.ToLowerInvariant();
        
        if (path.Contains("doctors") || path.Contains("doctor-specialties") || path.Contains("doctor-types") || path.Contains("slots") || path.Contains("slot-types"))
        {
            isDoctorMastersOpen = true;
        }
        if (path.Contains("test-master") || path.Contains("test-fee") || path.Contains("test-type") || path.Contains("group-master") || path.Contains("reportmethod") || path.Contains("sample-master") || path.Contains("uom-master") || path.Contains("machine-master"))
        {
            isLabMastersOpen = true;
        }
        if (path.Contains("branchmaster") || path.Contains("counter-master") || path.Contains("counter-shift") || path.Contains("feetype") || path.Contains("reimbursement") || path.Contains("country-master") || path.Contains("state-master") || path.Contains("city-master") || path.Contains("area-master") || path.Contains("user-master") || path.Contains("userrights") || path.Contains("settings"))
        {
            isOrgMastersOpen = true;
        }
    }

