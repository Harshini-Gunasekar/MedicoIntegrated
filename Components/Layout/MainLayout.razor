            <div style="padding: 20px 24px; display: flex; flex-direction: column; gap: 14px;">
                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-weight: 600; font-size: 13px; color: #334155;">Branch Name <span style="color: #ef4444;">*</span></label>
                    <input type="text" class="form-control" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: 9px 12px; font-size: 14px;" @bind="newBranchName" placeholder="e.g. Main Branch / City Clinic" />
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-weight: 600; font-size: 13px; color: #334155;">Short Code</label>
                    <input type="text" class="form-control" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: 9px 12px; font-size: 14px;" @bind="newBranchShortName" placeholder="e.g. MB (Auto-generated if empty)" />
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-weight: 600; font-size: 13px; color: #334155;">Address</label>
                    <input type="text" class="form-control" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: 9px 12px; font-size: 14px;" @bind="newBranchAddress" placeholder="Location / Address" />
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; gap: 6px;">
                    <label style="font-weight: 600; font-size: 13px; color: #334155;">Mobile / Contact</label>
                    <input type="text" class="form-control" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: 9px 12px; font-size: 14px;" @bind="newBranchMobile" placeholder="Mobile Number" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0;">
                <button type="button" @onclick="() => showQuickBranchModal = false" style="padding: 9px 18px; border: 1px solid #cbd5e1; background: white; color: #475569; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer;">Cancel</button>
                <button type="button" @onclick="SaveQuickBranchAsync" disabled="@isSavingBranch" style="padding: 9px 20px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);">
                    @if (isSavingBranch)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i>
                        <span>Save Branch</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showNavEndShiftModal)
{
    <div class="operating-branch-modal-overlay" style="z-index: 12000; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center;" @onclick="CancelNavEndShift">
        <div class="operating-branch-card" style="z-index: 12001; max-width: 440px; background: white; border-radius: 16px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.2);" @onclick:stopPropagation="true">
            <div class="operating-branch-icon-container" style="background: #fef2f2; color: #ef4444; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 16px auto;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            
            <h2 class="operating-branch-title" style="text-align: center; margin: 0 0 4px 0; font-size: 1.25rem; font-weight: 700; color: #0f172a;">Confirm End Shift</h2>
            <p class="operating-branch-subtitle" style="text-align: center; margin: 0 0 20px 0; font-size: 0.85rem; color: #64748b;">Close active billing counter session</p>

            @if (navOpenShiftsList != null && navOpenShiftsList.Count > 1)
            {
                <div style="margin-bottom: 16px; text-align: left;">
                    <label style="font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 6px; display: block;">Select Counter Shift to Close:</label>
                    <select class="form-select" style="font-size: 0.9rem; border-radius: 8px; width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1;" @bind="selectedNavShiftCnttid">
                        @foreach (var s in navOpenShiftsList)
                        {
                            <option value="@s.cnttid">Counter @s.cntcode (Shift #@s.shiftsno)</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <p style="font-size: 0.9rem; color: #334155; margin-bottom: 16px; text-align: center;">
                    Are you sure you want to end and close active counter shift <strong style="color: #0f172a;">'@navShiftEndCounterName'</strong>?
                </p>
            }

            <div style="background: #fff1f2; border: 1px solid #fecdd3; border-radius: 8px; padding: 12px; color: #991b1b; font-size: 0.82rem; display: flex; align-items: center; gap: 8px; margin-bottom: 20px; text-align: left;">
                <i class="bi bi-info-circle-fill" style="font-size: 1.1rem; flex-shrink: 0;"></i>
                <span>Closing this shift will finalize all active billing transactions for this counter session.</span>
            </div>

            <div style="display: flex; gap: 12px; width: 100%;">
                <button type="button" class="btn-denied-secondary" style="flex: 1; justify-content: center; padding: 10px 16px; border-radius: 8px; font-weight: 600; border: 1px solid #cbd5e1; background: white; color: #475569; cursor: pointer;" @onclick="CancelNavEndShift">Cancel</button>
                <button type="button" class="btn-denied-primary" style="flex: 1; justify-content: center; padding: 10px 16px; border-radius: 8px; font-weight: 600; border: none; background: linear-gradient(135deg, #ef4444, #dc2626); color: white; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;" @onclick="ConfirmNavEndShiftAsync" disabled="@isEndingNavShift">
                    @if (isEndingNavShift)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Ending...</span>
                    }
                    else
                    {
                        <i class="bi bi-stop-circle-fill me-1"></i>
                        <span>End Shift Now</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- GLOBAL WALK-IN DRAFT FLOATING CAPSULE ACCESSIBLE ACROSS ALL PAGES -->
@if (WalkinStateSvc.HasActiveDraft && WalkinStateSvc.IsWalkinMinimized)
{
    <div class="walkin-minimized-floating-pill" @onclick="ExpandWalkinFromLayout" title="Click to expand Walk-in Appointment Draft" style="position: fixed; bottom: 28px; right: 28px; z-index: 10000; background: linear-gradient(135deg, #026aa7 0%, #0284c7 100%); color: white; padding: 10px 18px; border-radius: 50px; box-shadow: 0 10px 25px rgba(2, 106, 167, 0.4); display: flex; align-items: center; gap: 12px; cursor: pointer; border: 2px solid #ffffff; transition: transform 0.2s ease, box-shadow 0.2s ease;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div style="display: flex; flex-direction: column; text-align: left;">
            <span style="font-size: 0.85rem; font-weight: 700; line-height: 1.2;">@WalkinStateSvc.Title</span>
            <span style="font-size: 0.75rem; opacity: 0.9; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @(string.IsNullOrWhiteSpace(WalkinStateSvc.PatientSearchQuery) ? "Draft in progress" : WalkinStateSvc.PatientSearchQuery)
            </span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; margin-left: 4px;">
            <button type="button" @onclick:stopPropagation="true" @onclick="ExpandWalkinFromLayout" style="background: rgba(255,255,255,0.25); border: none; color: white; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;" title="Expand Card">
                <i class="bi bi-arrows-angle-expand" style="font-size: 0.8rem;"></i>
            </button>
            <button type="button" @onclick:stopPropagation="true" @onclick="DiscardWalkinFromLayout" style="background: rgba(255,255,255,0.25); border: none; color: white; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;" title="Close & Discard">
                <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
            </button>
        </div>
    </div>
}

