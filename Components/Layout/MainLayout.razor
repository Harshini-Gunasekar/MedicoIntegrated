    private void EvaluateAccess()
    {
        var relativePath = NormalizePath(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

        if (TenantState.IsAuthenticated && (relativePath == "login" || relativePath == "user-login" || relativePath == "admin-login"))
        {
            NavigationManager.NavigateTo("/home", replace: true);
            return;
        }

        hasAccess = CheckPathPermission(relativePath);
        isCheckingAccess = false;

        if (hasAccess)
        {
            SyncActivePageRights(relativePath);
        }

        if (!hasAccess && !TenantState.IsAuthenticated && !IsAnonymousPath(relativePath))
        {
            // Not authenticated and trying to access a private path -> Redirect to login page
            NavigationManager.NavigateTo("/user-login", replace: true);
        }
    }

