@inherits LayoutComponentBase
@using Newtonsoft.Json
@using Booking.Helpers
@using SharedComponents.Rcl.Models
@using Booking.Models
@using Booking.Services
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage _sessionStorage
@inject SharedComponents.Rcl.Services.TenantSessionState TenantState
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject Booking.Services.ToastService Toast
@inject Booking.Services.HmsBillingService HmsBillingService
@inject Booking.Services.WalkinStateService WalkinStateSvc
@inject Booking.Services.BillingStateService BillingStateSvc
@inject Booking.Services.NetworkInfoService NetworkInfoService
@inject Booking.Services.CounterMasterService CounterMasterService
@inject Booking.Services.LabSettingService LabSettingService
@inject Booking.Services.RoleMasterService RoleService
@inject LabCare.Services.UserService UserService
@implements IDisposable

<div class="app-container">
    <NavMenu @ref="_navMenuRef" @bind-IsSidebarVisible="isSidebarVisible" />

    <div class="app-main-wrapper">
        @if (TenantState.IsAuthenticated && !IsAnonymousPath(NavigationManager.ToBaseRelativePath(NavigationManager.Uri)))
        {
            <div class="chrome-tab-header">
                <button class="mobile-nav-toggle" @onclick="ToggleSidebar" title="Toggle Sidebar Menu">
                    <i class="bi bi-list"></i>
                </button>

                <div class="chrome-tabs-container">
                    <button type="button" class="tab-scroll-btn left" @onclick='() => ScrollTabs("left")' title="Scroll tabs left">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="chrome-tab-strip" id="chromeTabStrip">
                        @foreach (var tab in openTabs)
                        {
                            var normTabUrl = NormalizeTabUrl(tab.Url);
                            var normActiveUrl = NormalizeTabUrl(activeTabUrl);
                            var isTabActive = normTabUrl == normActiveUrl;
                            
                            <div class="chrome-tab @(isTabActive ? "active" : "")" @onclick="() => SelectTab(tab)" title="@GetTabDisplayTitle(tab)">
                                <i class="bi @tab.Icon tab-icon"></i>
                                <span class="tab-title">@GetTabDisplayTitle(tab)</span>
                                <button type="button" class="tab-close-btn" @onclick:stopPropagation="true" @onclick="() => CloseTab(tab)" title="Close tab">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <button type="button" class="tab-scroll-btn right" @onclick='() => ScrollTabs("right")' title="Scroll tabs right">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                <div class="chrome-header-actions">
                    @if (openTabs.Count > 1)
                    {
                        <button type="button" class="chrome-action-btn" @onclick="CloseOtherTabsAction" title="Close all tabs except active tab">
                            <i class="bi bi-intersect"></i>
                            <span class="d-none d-xl-inline">Close Others</span>
                        </button>
                    }

                    <!-- Wi-Fi Status Button in Top Bar (Next to Close Others) -->
                    <button type="button" class="chrome-wifi-btn @(currentNetworkInfo.isOnline ? (currentNetworkInfo.downlinkMbps >= 50 ? "ultra-fast" : (currentNetworkInfo.downlinkMbps >= 15 ? "fast" : (currentNetworkInfo.downlinkMbps > 0 ? "normal" : "testing"))) : "offline")"
                            @onclick="ToggleNetworkPopover" title="Network Connection & Speed Diagnostics">
                        <i class="bi @(currentNetworkInfo.isOnline ? "bi-wifi" : "bi-wifi-off")"></i>
                        <span class="wifi-btn-dot @(currentNetworkInfo.isTesting || currentNetworkInfo.downlinkMbps <= 0 ? "testing-pulse" : "")"></span>
                        <span class="wifi-btn-text">
                            @if (!currentNetworkInfo.isOnline)
                            {
                                <text>Offline</text>
                            }
                            else if (currentNetworkInfo.downlinkMbps > 0)
                            {
                                <text>@($"{currentNetworkInfo.downlinkMbps:0.#} Mbps")</text>
                            }
                            else
                            {
                                <text>Testing...</text>
                            }
                        </span>
                    </button>

                    <!-- Dark / Bright Mode Toggle in Top Right Bar -->
                    <button type="button" class="chrome-theme-btn" @onclick="ToggleTheme" title="@(isDarkMode ? "Switch to Bright Mode" : "Switch to Dark Mode")">
                        <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                    </button>
                </div>
            </div>
        }

        <main class="main-content">
            @if (isCheckingAccess)
            {
                <div class="access-loading-container">
                    <div class="premium-spinner"></div>
                    <p class="loading-text">Verifying security parameters...</p>
                </div>
            }
            else if (!hasAccess)
            {
                <div class="access-denied-container">
                    <div class="access-denied-card">
                        <div class="lock-icon-wrapper">
                            <i class="bi bi-shield-lock lock-icon" style="font-size: 38px;"></i>
                        </div>
                        <h2 class="denied-title">Access Restricted</h2>
                        <p class="denied-message">You do not have the required permissions to view the <strong>@GetFriendlyPageTitle()</strong> module. Please contact your administrator if you believe this is an error.</p>
                        <div class="denied-actions">
                            <button class="btn-denied-primary" @onclick="GoToDashboard">
                                <i class="bi bi-grid-fill me-1"></i> Dashboard
                            </button>
                            <button class="btn-denied-secondary" @onclick="GoBack">
                                <i class="bi bi-arrow-left me-1"></i> Go Back
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <CascadingValue Value="@TenantState" IsFixed="false">
                    <div @key="sessionRenderVersion" style="display: contents;">
                        @Body
                    </div>
                </CascadingValue>
            }
        </main>
        <Booking.Components.Shared.ToastContainer />
    </div>
</div>

<!-- NETWORK STATUS & LIVE SPEED DIAGNOSTICS MODAL POPUP -->
@if (showNetworkPopover)
{
    <div class="network-modal-overlay" @onclick="CloseNetworkPopover">
        <div class="network-modal-card" @onclick:stopPropagation="true">
            <!-- Header (Seamless white/clean theme, no solid blue) -->
            <div class="network-modal-header">
                <div class="network-modal-title">
                    <div class="network-header-icon-badge @(currentNetworkInfo.isOnline ? (currentNetworkInfo.downlinkMbps >= 50 ? "badge-ultra" : "badge-online") : "badge-offline")">
                        <i class="bi @(currentNetworkInfo.isOnline ? "bi-wifi" : "bi-wifi-off")"></i>
                    </div>
                    <div class="modal-title-wrap">
                        <div class="modal-main-title">Network Diagnostics</div>
                        <div class="modal-sub-title">Live Speed & Workstation Info</div>
                    </div>
                </div>
                <button type="button" class="network-modal-close" @onclick="CloseNetworkPopover" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="network-modal-body">
                <!-- Speed Hero Card -->
                <div class="speed-hero-card @(currentNetworkInfo.isOnline ? (currentNetworkInfo.downlinkMbps >= 50 ? "hero-ultra" : (currentNetworkInfo.downlinkMbps >= 15 ? "hero-fast" : "hero-normal")) : "hero-offline")">
                    <div class="speed-hero-row">
                        <div class="speed-number-display">
                            @if (!currentNetworkInfo.isOnline)
                            {
                                <span class="speed-main-val text-danger">Offline</span>
                            }
                            else if (currentNetworkInfo.isTesting && currentNetworkInfo.downlinkMbps <= 0)
                            {
                                <span class="speed-main-val">Testing...</span>
                            }
                            else
                            {
                                <span class="speed-main-val">@($"{currentNetworkInfo.downlinkMbps:0.#}")</span>
                                <span class="speed-unit">Mbps</span>
                            }
                        </div>

                        <div class="speed-hero-right-col">
                            <div class="speed-status-pill">
                                <span class="speed-pulse-dot @(currentNetworkInfo.isTesting ? "testing-pulse" : "")"></span>
                                <span>@(currentNetworkInfo.isOnline ? (currentNetworkInfo.isTesting ? "Testing" : (currentNetworkInfo.downlinkMbps >= 50 ? "Ultra Fast" : (currentNetworkInfo.downlinkMbps >= 15 ? "High Speed" : "Normal"))) : "Offline")</span>
                            </div>
                            <div class="signal-bars-indicator" title="Signal Strength">
                                <div class="signal-bar bar-1 @(currentNetworkInfo.isOnline ? "active" : "")"></div>
                                <div class="signal-bar bar-2 @(currentNetworkInfo.isOnline && (currentNetworkInfo.downlinkMbps >= 5 || currentNetworkInfo.isTesting) ? "active" : "")"></div>
                                <div class="signal-bar bar-3 @(currentNetworkInfo.isOnline && (currentNetworkInfo.downlinkMbps >= 15 || currentNetworkInfo.isTesting) ? "active" : "")"></div>
                                <div class="signal-bar bar-4 @(currentNetworkInfo.isOnline && (currentNetworkInfo.downlinkMbps >= 50 || currentNetworkInfo.isTesting) ? "active" : "")"></div>
                            </div>
                        </div>
                    </div>

                    <div class="speed-hero-stats">
                        <div class="hero-stat-pill">
                            <span class="hero-stat-label"><i class="bi bi-activity me-1"></i>Ping</span>
                            <span class="hero-stat-val">@(currentNetworkInfo.rttMs > 0 ? $"{currentNetworkInfo.rttMs} ms" : (currentNetworkInfo.isOnline ? "< 20 ms" : "--"))</span>
                        </div>
                        <div class="hero-stat-pill">
                            <span class="hero-stat-label"><i class="bi bi-broadcast me-1"></i>Type</span>
                            <span class="hero-stat-val">@(currentNetworkInfo.isOnline ? "Wi-Fi (5GHz)" : "Offline")</span>
                        </div>
                    </div>
                </div>

                <!-- 2x2 Diagnostics Grid -->
                <div class="network-details-grid">
                    <div class="network-detail-item" title="@deviceNetworkInfo.WifiName">
                        <div class="detail-item-icon icon-wifi">
                            <i class="bi bi-router"></i>
                        </div>
                        <div class="detail-item-content">
                            <span class="detail-item-label">Wi-Fi</span>
                            <span class="detail-item-val">
                                @(string.IsNullOrWhiteSpace(deviceNetworkInfo.WifiName) ? "Local Network" : deviceNetworkInfo.WifiName)
                            </span>
                        </div>
                    </div>

                    <div class="network-detail-item" title="@deviceNetworkInfo.DeviceName">
                        <div class="detail-item-icon icon-device">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div class="detail-item-content">
                            <span class="detail-item-label">Client PC</span>
                            <span class="detail-item-val">
                                @(string.IsNullOrEmpty(deviceNetworkInfo.DeviceName) ? Environment.MachineName : deviceNetworkInfo.DeviceName)
                            </span>
                        </div>
                    </div>

                    <div class="network-detail-item" title="@deviceNetworkInfo.LocalIp">
                        <div class="detail-item-icon icon-ip">
                            <i class="bi bi-hdd-network"></i>
                        </div>
                        <div class="detail-item-content">
                            <span class="detail-item-label">Local IP</span>
                            <span class="detail-item-val font-mono">
                                @(string.IsNullOrEmpty(deviceNetworkInfo.LocalIp) ? "192.168.1.1" : deviceNetworkInfo.LocalIp)
                            </span>
                        </div>
                    </div>

                    <div class="network-detail-item" title="Connection Status">
                        <div class="detail-item-icon icon-status">
                            <i class="bi @(currentNetworkInfo.isOnline ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                        </div>
                        <div class="detail-item-content">
                            <span class="detail-item-label">State</span>
                            <span class="detail-item-val font-semibold @(currentNetworkInfo.isOnline ? "text-emerald" : "text-danger")">
                                @(currentNetworkInfo.isOnline ? "Connected" : "Disconnected")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="network-modal-footer">
                <div class="network-footer-info">
                    <i class="bi bi-info-circle text-muted"></i>
                    <span>Realtime diagnostic speed test</span>
                </div>
                <button type="button" class="btn-network-modal-retest @(currentNetworkInfo.isTesting ? "is-testing" : "")" @onclick="RefreshNetworkSpeed" disabled="@currentNetworkInfo.isTesting">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>@(currentNetworkInfo.isTesting ? "Testing..." : "Test Speed")</span>
                </button>
            </div>
        </div>
    </div>
}

@if (showBranchModal)
{
    <div class="operating-branch-modal-overlay">
        <div class="operating-branch-card">
            <div class="operating-branch-icon-container">
                <i class="bi bi-buildings"></i>
            </div>
            
            <h2 class="operating-branch-title">Select Operating Branch</h2>
            <p class="operating-branch-subtitle">Choose your active working branch for this session.</p>

            <div class="operating-branch-list">
                @{
                    var validDisplayBranches = sessionBranches?.Where(b => !IsSampleBranch(b.name, null, b.bh_code)).ToList() ?? new();
                }
                @if (!validDisplayBranches.Any())
                {
                    <div class="operating-branch-empty">
                        <i class="bi bi-building-exclamation mb-2" style="font-size: 1.8rem; color: #94a3b8; display: block;"></i>
                        <p class="mb-1" style="font-size: 0.95rem; font-weight: 700; color: #1e293b;">No Operating Branches Available</p>
                        <p class="text-muted mb-3" style="font-size: 0.78rem;">Please add a new branch to begin operations.</p>
                        <button type="button" class="btn-add-quick-branch" @onclick="OpenAddBranchModal">
                            <i class="bi bi-plus-circle me-1"></i>
                            <span>+ Add New Branch</span>
                        </button>
                    </div>
                }
                else
                {
                    @foreach (var branch in validDisplayBranches)
                    {
                        var isSelected = (selectedBranchId == branch.bh_code);
                        <div class="branch-list-item @(isSelected ? "selected" : "")" 
                             @onclick="() => SelectBranchCard(branch.bh_code)">
                            <div class="branch-item-lead-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <div class="branch-item-details">
                                <div class="branch-item-name">@(branch.name?.ToUpperInvariant())</div>
                                <div class="branch-item-code">Code: @branch.bh_code</div>
                            </div>
                            <div class="branch-item-selection-indicator">
                                @if (isSelected)
                                {
                                    <div class="branch-selected-pill">
                                        <i class="bi bi-check2"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="branch-unselected-radio"></div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <button type="button" class="btn-operating-branch-confirm" @onclick="ConfirmBranchAsync" disabled="@(selectedBranchId <= 0)">
                <span>Confirm Branch</span>
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
}

@if (showQuickBranchModal)
{
    <div class="operating-branch-modal-overlay" style="z-index: 10001;">
        <div class="operating-branch-card quick-branch-modal-card">
            <div class="quick-branch-header">
                <div class="quick-branch-header-info">
                    <div class="quick-branch-icon-badge">
                        <i class="bi bi-building-add"></i>
                    </div>
                    <div class="quick-branch-title-group">
                        <h4 class="quick-branch-title">Add New Branch</h4>
                        <span class="quick-branch-subtitle">Quickly register a facility branch location</span>
                    </div>
                </div>
                <button type="button" class="quick-branch-close-btn" @onclick="() => showQuickBranchModal = false" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="quick-branch-form-grid">
                <div class="quick-branch-field">
                    <label class="quick-branch-label">Branch Name <span class="quick-branch-required">*</span></label>
                    <div class="quick-branch-input-wrapper">
                        <i class="bi bi-building quick-branch-input-icon"></i>
                        <input type="text" class="quick-branch-input" placeholder="e.g. Main Hospital Branch" @bind="newBranchName" />
                    </div>
                </div>
                <div class="quick-branch-field">
                    <label class="quick-branch-label">Short Code / Abbreviation</label>
                    <div class="quick-branch-input-wrapper">
                        <i class="bi bi-tag quick-branch-input-icon"></i>
                        <input type="text" class="quick-branch-input" placeholder="e.g. MHB" @bind="newBranchShortName" maxlength="10" />
                    </div>
                </div>
                <div class="quick-branch-field">
                    <label class="quick-branch-label">Address</label>
                    <div class="quick-branch-input-wrapper">
                        <i class="bi bi-geo-alt quick-branch-input-icon"></i>
                        <input type="text" class="quick-branch-input" placeholder="Branch address location" @bind="newBranchAddress" />
                    </div>
                </div>
                <div class="quick-branch-field">
                    <label class="quick-branch-label">Mobile / Contact</label>
                    <div class="quick-branch-input-wrapper">
                        <i class="bi bi-telephone quick-branch-input-icon"></i>
                        <input type="text" class="quick-branch-input" placeholder="Contact phone number" @bind="newBranchMobile" />
                    </div>
                </div>
            </div>

            <div class="quick-branch-actions">
                <button type="button" class="quick-branch-btn-cancel" @onclick="() => showQuickBranchModal = false">Cancel</button>
                <button type="button" class="quick-branch-btn-save" @onclick="SaveQuickBranchAsync" disabled="@isSavingBranch">
                    @if (isSavingBranch)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <span>Save Branch</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- GLOBAL WALK-IN DRAFT FLOATING CAPSULE ACCESSIBLE ACROSS ALL PAGES -->
@if (WalkinStateSvc.HasActiveDraft && WalkinStateSvc.IsWalkinMinimized)
{
    <div class="walkin-minimized-floating-pill" @onclick="ExpandWalkinFromLayout" title="Click to expand Walk-in Appointment Draft" style="position: fixed; bottom: 28px; right: 28px; z-index: 10000; background: linear-gradient(135deg, #026aa7 0%, #0284c7 100%); color: white; padding: 10px 18px; border-radius: 50px; box-shadow: 0 10px 25px rgba(2, 106, 167, 0.4); display: flex; align-items: center; gap: 12px; cursor: pointer; border: 2px solid #ffffff; transition: transform 0.2s ease, box-shadow 0.2s ease;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div style="display: flex; flex-direction: column; text-align: left;">
            <span style="font-size: 0.85rem; font-weight: 700; line-height: 1.2;">@WalkinStateSvc.Title</span>
            <span style="font-size: 0.75rem; opacity: 0.9; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @(string.IsNullOrWhiteSpace(WalkinStateSvc.PatientSearchQuery) ? "Draft in progress" : WalkinStateSvc.PatientSearchQuery)
            </span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; margin-left: 4px;">
            <button type="button" @onclick:stopPropagation="true" @onclick="ExpandWalkinFromLayout" style="background: rgba(255,255,255,0.25); border: none; color: white; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;" title="Expand Card">
                <i class="bi bi-arrows-angle-expand" style="font-size: 0.8rem;"></i>
            </button>
            <button type="button" @onclick:stopPropagation="true" @onclick="DiscardWalkinFromLayout" style="background: rgba(255,255,255,0.25); border: none; color: white; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;" title="Close & Discard">
                <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
            </button>
        </div>
    </div>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    public class NetworkSpeedInfo
    {
        public bool isOnline { get; set; } = true;
        public double downlinkMbps { get; set; } = 0.0;
        public int rttMs { get; set; } = 0;
        public string effectiveType { get; set; } = "wifi";
        public string connectionType { get; set; } = "wifi";
        public bool isTesting { get; set; } = true;
    }

    private NetworkSpeedInfo currentNetworkInfo = new();
    private Booking.Services.DeviceNetworkDetails deviceNetworkInfo = new();
    private DotNetObjectReference<MainLayout>? dotNetHelper;

    [JSInvokable]
    public void OnNetworkSpeedUpdated(NetworkSpeedInfo info)
    {
        if (isDisposed) return;
        currentNetworkInfo = info;
        StateHasChanged();
    }

    private async Task RefreshNetworkSpeed()
    {
        try
        {
            deviceNetworkInfo = await NetworkInfoService.GetDeviceNetworkDetailsAsync(forceRefresh: true);
            await JS.InvokeVoidAsync("networkSpeedMonitor.runFullSpeedTest");
            StateHasChanged();
        }
        catch { }
    }

    private bool showNetworkPopover = false;

    private void ToggleNetworkPopover()
    {
        showNetworkPopover = !showNetworkPopover;
    }

    private void CloseNetworkPopover()
    {
        showNetworkPopover = false;
    }

    private bool isDarkMode = false;

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JS.InvokeAsync<string>("medicoTheme.toggleTheme");
            isDarkMode = (newTheme == "dark");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling theme: {ex.Message}");
        }
    }

    private bool isCheckingAccess = false;
    private bool hasAccess = true;
    private bool isDisposed = false;
    private bool _hasSessionValidated = false;
    private bool _isCircuitAborted = false;
    private bool _isAdminSession = false;   // sticky: once true stays true for the lifetime of this circuit
    private NavMenu? _navMenuRef;
    private bool isSidebarVisible = false;
    private int sessionRenderVersion = 0;

    private void ToggleSidebar() => isSidebarVisible = !isSidebarVisible;

    private List<SharedComponents.Rcl.Models.BranchModel> sessionBranches = new();
    private int selectedBranchId = 0;
    private bool showBranchModal = false;

    private void SelectBranchCard(int bhCode)
    {
        if (IsSampleBranch(null, null, bhCode)) return;
        selectedBranchId = bhCode;
    }

    public class SidebarMenuItemModel
    {
        public string Title { get; set; } = "";
        public string Href { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Category { get; set; } = "";
    }

    private List<SidebarMenuItemModel> GetAllMenuItems()
    {
        return new List<SidebarMenuItemModel>
        {
            new SidebarMenuItemModel { Title = "Dashboard", Href = "/home", Icon = "bi-grid-fill", Category = "Dashboard" },
            new SidebarMenuItemModel { Title = "Patient Check-In", Href = "/booking/reception", Icon = "bi-people-fill", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Outpatient Visiting", Href = "/booking/outpatient", Icon = "bi-hospital", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "OP Token Display", Href = "/op-token-display", Icon = "bi-display", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Customer History", Href = "/booking/customer", Icon = "bi-person-lines-fill", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Slot Master", Href = "/slots", Icon = "bi-calendar-range", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Patient Master", Href = "/patientmaster", Icon = "bi-person-circle", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Country Master", Href = "/country-master", Icon = "bi-globe", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "State Master", Href = "/state-master", Icon = "bi-map", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "City Master", Href = "/city-master", Icon = "bi-building-fill", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Area Master", Href = "/area-master", Icon = "bi-geo-alt", Category = "OP portal" },
            new SidebarMenuItemModel { Title = "Vitals Dashboard", Href = "/vitals-dashboard", Icon = "bi-activity", Category = "vital page" },
            new SidebarMenuItemModel { Title = "Vitals Entry", Href = "/vitals", Icon = "bi-heart-pulse", Category = "vital page" },
