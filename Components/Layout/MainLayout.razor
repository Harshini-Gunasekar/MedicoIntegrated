                return IsAdmin() || HasRight("Admin Portal", "Settings");

            default:
                return IsAdmin();
        }
    }

    /// <summary>
    /// Returns true when the current circuit has been confirmed as an administrator session.
    /// Uses a sticky flag (_isAdminSession) so the check is cheap after the first resolution.
    /// Admin is determined ONLY from trusted sources: the stored Role string, or the JWT role
    /// claim. A failed/missing user_code read never grants admin.
    /// </summary>
    private bool IsAdmin()
    {
        if (_isAdminSession) return true;

        var role = TenantState.UserData?.Role;
        if (!string.IsNullOrEmpty(role) && IsAdminRole(role))
        {
            _isAdminSession = true;
            return true;
        }

        var name = TenantState.UserData?.UserName;
        if (string.Equals(name, "admin", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(name, "administrator", StringComparison.OrdinalIgnoreCase))
        {
            _isAdminSession = true;
            return true;
        }

        var token = TenantState.AuthToken ?? TenantState.UserData?.AuthToken;
        if (IsAdminRoleFromJwt(token))
        {
            _isAdminSession = true;
            return true;
        }

        return false;
    }

    /// <summary>
    /// Reads a value from ProtectedSessionStorage with up to <paramref name="maxAttempts"/> retries
    /// on transient failures. JSDisconnectedException / OperationCanceledException bubble up
    /// immediately so the caller can abort the circuit.
    /// </summary>
    private async Task<Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedBrowserStorageResult<T>>
        ReadSessionAsync<T>(string key, int maxAttempts = 2)
    {
        for (int attempt = 1; attempt <= maxAttempts; attempt++)
        {
            try
            {
                return await _sessionStorage.GetAsync<T>(key);
            }
            catch (OperationCanceledException) { throw; }
            catch (Microsoft.JSInterop.JSDisconnectedException) { throw; }
            catch
            {
                if (attempt == maxAttempts)
                    return default;   // return empty result after last attempt
                await Task.Delay(80 * attempt);
            }
        }
        return default;
    }

