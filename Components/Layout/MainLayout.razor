    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        TenantState.OnSessionChanged += HandleSessionChanged;
        WalkinStateSvc.OnChange += HandleWalkinStateChanged;
        BillingStateSvc.OnChange += HandleBillingStateChanged;
    }

    private void HandleWalkinStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (isDisposed) return;
            StateHasChanged();
        });
    }

    private void HandleBillingStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (isDisposed) return;
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            EvaluateAccess();
            await CheckBranchSelectionAsync();
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            SyncCurrentPageToTabs(relativePath);
            StateHasChanged();
        });
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            EvaluateAccess();
            await CheckBranchSelectionAsync();
            StateHasChanged();
        });
    }

    private void EvaluateAccess()
    {
        if (isDisposed || _isCircuitAborted) return;
        var relativePath = NormalizePath(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

        if (TenantState.IsAuthenticated && (relativePath == "login" || relativePath == "user-login" || relativePath == "admin-login"))
        {
            isCheckingAccess = false;
            try { NavigationManager.NavigateTo("/home", replace: true); } catch { }
            return;
        }

        hasAccess = CheckPathPermission(relativePath);
        isCheckingAccess = false;

        if (!isDisposed && !_isCircuitAborted && _hasSessionValidated && !hasAccess && !TenantState.IsAuthenticated && !IsAnonymousPath(relativePath))
        {
            try
            {
                NavigationManager.NavigateTo("/user-login", replace: true);
            }
            catch { }
        }
    }

    private bool IsAnonymousPath(string path)
    {
        path = NormalizePath(path);
        return string.IsNullOrEmpty(path) || 
               path == "login" || 
               path == "user-login" || 
               path == "admin-login" ||
               path == "forgot-password" ||
               path == "register" ||
               path == "user-register" ||
               path == "token-display";
    }

    private string NormalizePath(string path)
    {
        path = path.Trim().ToLower();
        if (path.StartsWith("/"))
        {
            path = path.Substring(1);
        }
        int queryIndex = path.IndexOf('?');
        if (queryIndex >= 0)
        {
            path = path.Substring(0, queryIndex);
        }
        return path;
    }

    private bool CheckPathPermission(string path)
    {
        path = NormalizePath(path);

        if (IsAnonymousPath(path))
        {
            return true;
        }

        if (!_hasSessionValidated)
        {
            return true;
        }

        // Administrator bypass
        if (IsAdmin())
        {
            return true;
        }

        if (!TenantState.IsAuthenticated)
        {
            return false;
        }

        switch (path)
        {
            case "home":
            case "dashboard":
                return true;

            // Reception & OP Portal
            case "op-dashboard":
                return HasRight("OP Portal", "OP Dashboard");
