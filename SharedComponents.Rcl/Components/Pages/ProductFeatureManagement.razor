@page "/ProductFeatures"
@using SharedComponents.Rcl.Models
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceProvider ServiceProvider

<div class="feature-registry-container">
    <div class="page-header glass-morphic">
        <div class="header-main">
            <div class="title-area">
                <i class="bi bi-gear-wide-connected title-icon"></i>
                <div class="title-text">
                    <h1>Product &amp; Feature Registry</h1>
                    <p>Register applications and define their permission structures</p>
                </div>
            </div>
        </div>
    </div>

    <div class="management-grid mt-3">
        <!-- Product List Sidebar -->
        <div class="product-sidebar glass-morphic">
            <div class="sidebar-header">
                <h3>Applications</h3>
                <button class="btn-icon-only" @onclick="PrepareNewProduct" title="Add New Product">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
            
            <div class="product-pills mt-3">
                @foreach (var prod in products)
                {
                    <div class="product-pill @(selectedProductId == prod.ProductId ? "active" : "")" @onclick="() => SelectProduct(prod)">
                        <i class="bi @(string.IsNullOrEmpty(prod.IconCss) ? "bi-app" : prod.IconCss)"></i>
                        <div class="prod-info">
                            <span class="prod-name">@prod.ProductName</span>
                            <span class="prod-id">@prod.ProductId</span>
                        </div>
                        @if (!prod.IsActive)
                        {
                            <span class="badge bg-danger ms-auto">Inactive</span>
                        }
                    </div>
                }
            </div>

            @if (isEditingProduct)
            {
                <div class="product-editor-form mt-4 animate-slide-up">
                    <div class="form-group mb-3">
                        <label>Product ID</label>
                        <input type="text" class="form-control-premium" @bind="editingProduct.ProductId" placeholder="e.g. CMS" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Display Name</label>
                        <input type="text" class="form-control-premium" @bind="editingProduct.ProductName" placeholder="e.g. Content Manager" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Icon CSS (Bootstrap Icon)</label>
                        <input type="text" class="form-control-premium" @bind="editingProduct.IconCss" placeholder="bi-cpu" />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" @bind="editingProduct.IsActive" id="prodActive">
                        <label class="form-check-label" for="prodActive">Is Active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn-premium flex-grow-1" @onclick="SaveProduct">Save Product</button>
                        <button class="btn-premium-outline" @onclick="() => isEditingProduct = false">Cancel</button>
                    </div>
                </div>
            }
        </div>

        <!-- Feature Matrix -->
        <div class="feature-workspace glass-morphic">
            @if (string.IsNullOrEmpty(selectedProductId))
            {
                <div class="empty-selection">
                    <i class="bi bi-arrow-left-circle"></i>
                    <h4>Select a product to manage its features</h4>
                    <p>You can define granular permissions (View, Create, Edit, Delete, Export, Chart) for each module.</p>
                </div>
            }
            else
            {
                <div class="workspace-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="app-badge">@selectedProductId</div>
                        <h3>Feature Matrix: @selectedProductName</h3>
                    </div>
                    <button class="btn-premium-sm" @onclick="PrepareNewFeature">
                        <i class="bi bi-plus-circle me-1"></i> Add Feature
                    </button>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table feature-table">
                        <thead>
                            <tr>
                                <th style="width: 250px;">Feature Identity</th>
                                <th class="text-center">View</th>
                                <th class="text-center">Create</th>
                                <th class="text-center">Edit</th>
                                <th class="text-center">Delete</th>
                                <th class="text-center">Export</th>
                                <th class="text-center">Chart</th>
                                <th class="text-center">Order</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var feature in features)
                            {
                                <tr>
                                    <td>
                                        <div class="feature-info">
                                            <span class="f-key">@feature.FeatureKey</span>
                                            <span class="f-name">@feature.FeatureName</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="custom-toggle">
                                             <input type="checkbox" checked="@feature.HasView" @onchange='(e) => ToggleFeature(feature, "View", (bool)e.Value)' />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="custom-toggle">
                                             <input type="checkbox" checked="@feature.HasCreate" @onchange='(e) => ToggleFeature(feature, "Create", (bool)e.Value)' />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="custom-toggle">
                                             <input type="checkbox" checked="@feature.HasEdit" @onchange='(e) => ToggleFeature(feature, "Edit", (bool)e.Value)' />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="custom-toggle">
                                             <input type="checkbox" checked="@feature.HasDelete" @onchange='(e) => ToggleFeature(feature, "Delete", (bool)e.Value)' />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="custom-toggle">
                                             <input type="checkbox" checked="@feature.HasExport" @onchange='(e) => ToggleFeature(feature, "Export", (bool)e.Value)' />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="custom-toggle">
                                             <input type="checkbox" checked="@feature.HasChart" @onchange='(e) => ToggleFeature(feature, "Chart", (bool)e.Value)' />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <input type="number" class="order-input" @bind="feature.DisplayOrder" @bind:after="() => SaveQuickFeature(feature)" />
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn-table-action edit" @onclick="() => EditFeature(feature)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn-table-action delete" @onclick="() => ConfirmDeleteFeature(feature)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (isEditingFeature)
{
    <div class="modal-overlay">
        <div class="feature-modal animate-slide-up">
            <div class="modal-header">
                <h3>@(editingFeature.FeatureId == 0 ? "Add New Feature" : "Edit Feature")</h3>
                <button class="btn-close-modal" @onclick="() => isEditingFeature = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Feature Key (Internal)</label>
                        <input type="text" class="form-control-premium" @bind="editingFeature.FeatureKey" placeholder="e.g. referal_master" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Display Name</label>
                        <input type="text" class="form-control-premium" @bind="editingFeature.FeatureName" placeholder="e.g. Referral Management" />
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control-premium" @bind="editingFeature.FeatureDescription" rows="2"></textarea>
                    </div>
                </div>
                <div class="access-switches mt-3">
                    <label class="form-label d-block mb-2">Available Actions</label>
                    <div class="d-flex flex-wrap gap-4">
                        <label class="switch-wrap"><input type="checkbox" @bind="editingFeature.HasView" /><span>View</span></label>
                        <label class="switch-wrap"><input type="checkbox" @bind="editingFeature.HasCreate" /><span>Create</span></label>
                        <label class="switch-wrap"><input type="checkbox" @bind="editingFeature.HasEdit" /><span>Edit</span></label>
                        <label class="switch-wrap"><input type="checkbox" @bind="editingFeature.HasDelete" /><span>Delete</span></label>
                        <label class="switch-wrap"><input type="checkbox" @bind="editingFeature.HasExport" /><span>Export</span></label>
                        <label class="switch-wrap"><input type="checkbox" @bind="editingFeature.HasChart" /><span>Chart</span></label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-premium-outline" @onclick="() => isEditingFeature = false">Cancel</button>
                <button class="btn-premium" @onclick="SaveFullFeature">Save Feature</button>
            </div>
        </div>
    </div>
}

<style>
    .feature-registry-container { padding: 1rem 1.5rem; background: #f8fafc; min-height: 100vh; color: #0f172a; font-family: 'Inter', system-ui, sans-serif; }
    .glass-morphic { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); }
    
    .page-header { padding: 0.75rem 1.25rem; border-radius: 12px; }
    .title-area { display: flex; align-items: center; gap: 1rem; }
    .title-icon { font-size: 1.4rem; color: #8b5cf6; background: rgba(139, 92, 246, 0.1); padding: 0.5rem; border-radius: 8px; }
    .title-text h1 { margin: 0; font-size: 1.25rem; font-weight: 700; color: #0f172a; }
    .title-text p { margin: 0; color: #64748b; font-size: 0.8rem; }
    
    .management-grid { display: grid; grid-template-columns: 320px 1fr; gap: 1.5rem; align-items: start; }
    
    .product-sidebar { padding: 1.5rem; }
    .sidebar-header { display: flex; justify-content: space-between; align-items: center; }
    .sidebar-header h3 { font-size: 0.9rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 1px; margin: 0; }
    
    .product-pills { display: flex; flex-direction: column; gap: 0.8rem; }
    .product-pill { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; cursor: pointer; transition: all 0.3s; }
    .product-pill:hover { background: #f1f5f9; transform: translateX(5px); }
    .product-pill.active { background: linear-gradient(135deg, #8b5cf6, #6366f1); border-color: #8b5cf6; }
    .product-pill i { font-size: 1.4rem; color: #8b5cf6; }
    .product-pill.active i, .product-pill.active .prod-name { color: #fff; }
    .prod-info { display: flex; flex-direction: column; }
    .prod-name { font-weight: 600; font-size: 0.95rem; color: #1e293b; }
    .product-pill.active .prod-name { color: #ffffff; }
    .prod-id { font-size: 0.75rem; color: #64748b; }
    .product-pill.active .prod-id { color: rgba(255,255,255,0.8); }
    
    .feature-workspace { padding: 2rem; min-height: 600px; }
    .workspace-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
    .app-badge { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; padding: 0.4rem 1rem; border-radius: 8px; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; }
    .workspace-header h3 { font-size: 1.25rem; font-weight: 700; color: #0f172a; margin: 0; }
    
    .feature-table { border-collapse: separate; border-spacing: 0 8px; }
    .feature-table thead th { border: none; color: #475569; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; padding: 1rem; font-weight: 700; }
    .feature-table tbody tr { background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; transition: background 0.2s; }
    .feature-table tbody tr:hover { background: #f1f5f9; }
    .feature-table tbody td { padding: 1.2rem 1rem; border: none; vertical-align: middle; }
    .feature-table tbody tr td:first-child { border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
    .feature-table tbody tr td:last-child { border-top-right-radius: 12px; border-bottom-right-radius: 12px; }
    
    .feature-info { display: flex; flex-direction: column; }
    .f-key { font-weight: 700; color: #0f172a; font-size: 0.95rem; }
    .f-name { font-size: 0.8rem; color: #475569; }
    
    .order-input { width: 60px; background: #ffffff; border: 1px solid #cbd5e1; color: #0f172a; border-radius: 6px; padding: 0.3rem; text-align: center; font-weight: 600; }
    .order-input:focus { border-color: #8b5cf6; outline: none; }
    
    .form-control-premium { background: #ffffff; border: 1px solid #cbd5e1; color: #0f172a; padding: 0.8rem 1rem; border-radius: 10px; width: 100%; transition: all 0.2s; }
    .form-control-premium:focus { border-color: #8b5cf6; outline: none; box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1); }
    .form-control-premium::placeholder { color: #94a3b8; }
    
    .btn-premium { background: linear-gradient(135deg, #8b5cf6, #6366f1); border: none; color: white; padding: 0.8rem 1.5rem; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.3s; }
    .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(139, 92, 246, 0.3); }
    .btn-premium-outline { background: transparent; border: 1px solid #8b5cf6; color: #8b5cf6; padding: 0.8rem 1.5rem; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-premium-outline:hover { background: rgba(139, 92, 246, 0.05); }
    
    .btn-premium-sm { background: rgba(139, 92, 246, 0.05); border: 1px solid #8b5cf6; color: #8b5cf6; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; }
    .btn-premium-sm:hover { background: #8b5cf6; color: #fff; }
    
    .btn-icon-only { background: #f1f5f9; border: 1px solid #e2e8f0; color: #475569; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; }
    .btn-icon-only:hover { background: #8b5cf6; color: #fff; border-color: #8b5cf6; }
    
    .btn-table-action { border: none; border-radius: 8px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
    .btn-table-action.edit { background: rgba(99, 102, 241, 0.08); color: #6366f1; }
    .btn-table-action.edit:hover { background: #6366f1; color: #fff; }
    .btn-table-action.delete { background: rgba(239, 68, 68, 0.08); color: #ef4444; }
    .btn-table-action.delete:hover { background: #ef4444; color: #fff; }
    
    .empty-selection { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 400px; gap: 1rem; color: #64748b; }
    .empty-selection i { font-size: 3rem; color: #94a3b8; }
    .empty-selection h4 { font-size: 1.2rem; color: #475569; }
    
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 10000; }
    .feature-modal { background: #ffffff; border: 1px solid #e2e8f0; width: 620px; border-radius: 24px; padding: 2.5rem; color: #0f172a; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 1rem; }
    .modal-header h3 { margin: 0; font-size: 1.4rem; color: #0f172a; font-weight: 700; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #f1f5f9; }
    
    .switch-wrap { display: flex; align-items: center; gap: 0.6rem; cursor: pointer; padding: 0.5rem 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; transition: all 0.2s; }
    .switch-wrap:hover { background: #f1f5f9; border-color: #cbd5e1; }
    .switch-wrap input { width: 18px; height: 18px; accent-color: #8b5cf6; cursor: pointer; }
    .switch-wrap span { color: #334155; font-weight: 600; font-size: 0.9rem; }
    
    /* Toggle Checkboxes Custom Styling */
    .custom-toggle input[type="checkbox"] { width: 1.2rem; height: 1.2rem; cursor: pointer; accent-color: #8b5cf6; }
    
    .animate-slide-up { animation: slideUp 0.4s ease-out; }
    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>

@code {
    private List<ProductList> products = new();
    private List<ProductFeature> features = new();
    private string selectedProductId = "";
    private string selectedProductName = "";
    
    private ProductList editingProduct = new() { IsActive = true };
    private ProductFeature editingFeature = new() { HasView = true };
    
    private bool isEditingProduct = false;
    private bool isEditingFeature = false;

    private TrackAdmin.Data.PageMetadataService? Metadata => ServiceProvider.GetService(typeof(TrackAdmin.Data.PageMetadataService)) as TrackAdmin.Data.PageMetadataService;

    protected override async Task OnInitializedAsync()
    {
        Metadata?.UpdatePage("Product & Feature Registry", "Register applications and define permission structures", "bi-gear-wide-connected");

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var isAdmin = user.FindFirst("IsAdmin")?.Value == "true" || user.IsInRole("Administrator") || user.IsInRole("Admin");

        if (!isAdmin)
        {
            NavManager.NavigateTo("/");
            return;
        }

        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await Http.GetFromJsonAsync<List<ProductList>>("User/GetAllProducts") ?? new();
        StateHasChanged();
    }

    private async Task SelectProduct(ProductList prod)
    {
        selectedProductId = prod.ProductId;
        selectedProductName = prod.ProductName;
        await LoadFeatures();
    }

    private async Task LoadFeatures()
    {
        features = await Http.GetFromJsonAsync<List<ProductFeature>>($"User/GetProductFeatures?productId={selectedProductId}") ?? new();
        StateHasChanged();
    }

    private void PrepareNewProduct()
    {
        editingProduct = new ProductList { IsActive = true };
        isEditingProduct = true;
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(editingProduct.ProductId)) return;
        var response = await Http.PostAsJsonAsync("User/SaveProduct", editingProduct);
        if (response.IsSuccessStatusCode)
        {
            await LoadProducts();
            isEditingProduct = false;
        }
    }

    private void PrepareNewFeature()
    {
        editingFeature = new ProductFeature {
            ProductId = selectedProductId,
            HasView = true,
            DisplayOrder = features.Any() ? features.Max(f => f.DisplayOrder) + 10 : 10
        };
        isEditingFeature = true;
    }

    private void EditFeature(ProductFeature f)
    {
        editingFeature = new ProductFeature
        {
            FeatureId = f.FeatureId,
            ProductId = f.ProductId,
            FeatureKey = f.FeatureKey,
            FeatureName = f.FeatureName,
            FeatureDescription = f.FeatureDescription,
            HasView = f.HasView,
            HasCreate = f.HasCreate,
            HasEdit = f.HasEdit,
            HasDelete = f.HasDelete,
            HasExport = f.HasExport,
            HasChart = f.HasChart,
            DisplayOrder = f.DisplayOrder
        };
        isEditingFeature = true;
    }

    private async Task ToggleFeature(ProductFeature f, string action, bool val)
    {
        switch (action)
        {
            case "View": f.HasView = val; break;
            case "Create": f.HasCreate = val; break;
            case "Edit": f.HasEdit = val; break;
            case "Delete": f.HasDelete = val; break;
            case "Export": f.HasExport = val; break;
            case "Chart": f.HasChart = val; break;
        }
        await SaveQuickFeature(f);
    }

    private async Task SaveQuickFeature(ProductFeature f)
    {
        await Http.PostAsJsonAsync("User/SaveProductFeature", f);
    }

    private async Task SaveFullFeature()
    {
        if (string.IsNullOrWhiteSpace(editingFeature.FeatureKey)) return;
        var response = await Http.PostAsJsonAsync("User/SaveProductFeature", editingFeature);
        if (response.IsSuccessStatusCode)
        {
            await LoadFeatures();
            isEditingFeature = false;
        }
    }

    private async Task ConfirmDeleteFeature(ProductFeature f)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the feature '{f.FeatureName}'? This may affect assigned user rights.");
        if (confirmed)
        {
            var response = await Http.PostAsync($"User/DeleteProductFeature?featureId={f.FeatureId}", null);
            if (response.IsSuccessStatusCode) await LoadFeatures();
        }
    }
}
