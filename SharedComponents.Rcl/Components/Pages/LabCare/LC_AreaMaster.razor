@page "/areamaster"
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between">
        <div class="header-left-content">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">near_me</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Area Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Neighborhood Directory</span>
                </div>
            </div>
        </div>
        <div class="header-controls">
            <div class="search-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search areas..." @bind="SearchQuery" @bind:event="oninput" class="search-input-field" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewArea">+ Add New</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Area" : "New Area Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    <div class="modal-body">
                        
                        <div class="form-section mb-0">

                            <!-- Group 1: Area Details -->
                            <div class="lc-section-divider mt-24 mb-16">
                                <span class="lc-divider-label">AREA DETAILS</span>
                                <div class="lc-divider-line"></div>
                            </div>
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group position-relative">
                                        <div class="lc-flex-between-center lc-mb-4">
                                            <label class="lc-mb-0">Area Name</label>
                                            @if (isSubmitted && string.IsNullOrEmpty(current.areaname))
                                            {
                                                <span class="text-danger lc-font-11 lc-font-500">This field is required</span>
                                            }
                                        </div>
                                        <div class="input-with-icon">
                                            <span class="prefix-icon material-symbols-rounded text-primary">location_on</span>
                                            <input type="text" class="lab-input pl-36" @bind="current.areaname" @bind:event="oninput" @onfocus="() => showAreaDropdown = true" @onblur="HideAreaDropdown" placeholder="e.g. Perundurai" @(isSubmitted && string.IsNullOrEmpty(current.areaname) ? "is-invalid" : "") required />
                                        </div>
                                        @if (showAreaDropdown && !string.IsNullOrWhiteSpace(current.areaname) && !isEditMode)
                                        {
                                            var matchedAreas = areas
                                                .Where(a => a.areaname != null && a.areaname.Contains(current.areaname, StringComparison.OrdinalIgnoreCase))
                                                .ToList();

                                            if (matchedAreas.Any())
                                            {
                                                <div class="master-search-dropdown show">
                                                    @foreach (var a in matchedAreas)
                                                    {
                                                        <button type="button" class="master-search-item" @onmousedown="() => SelectExistingArea(a)">
                                                            <span class="material-symbols-rounded">history</span>
                                                            @a.areaname
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Order no</label>
                                        <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                    </div>
                                    <div class="form-group">
                                        <label>Short Name</label>
                                        <input type="text" class="lab-input" @bind="current.shortname" />
                                    </div>
                                    <div class="form-group">
                                        <label>Narration</label>
                                        <input type="text" class="lab-input" @bind="current.description" placeholder="" />
                                    </div>
                                </div>
                            </div>
                             <!-- Group 2: Location Mapping -->
                            <div class="lc-section-divider mt-24 mb-16">
                                <span class="lc-divider-label">LOCATION MAPPING</span>
                                <div class="lc-divider-line"></div>
                            </div>
                            <div class="form-row form-cols-5">
                                <div class="form-group">
                                    <label>Country</label>
                                    <div class="lc-select-wrapper">
                                        <select class="lab-input" @bind="current.countrycode">
                                            <option value="0">Select Country</option>
                                            @foreach (CountryModel c in countries)
                                            {
                                                <option value="@c.countrycode">@c.countryname</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>State</label>
                                    <div class="lc-select-wrapper">
                                        <select class="lab-input" @bind="current.statecode">
                                            <option value="0">Select State</option>
                                            @foreach (StateModel s in states)
                                            {
                                                <option value="@s.statecode">@s.statename</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>City</label>
                                    <div class="lc-select-wrapper">
                                        <select class="lab-input" @bind="current.citycode">
                                            <option value="0">Select City</option>
                                            @foreach (CityModel c in cities)
                                            {
                                                <option value="@c.citycode">@c.cityname</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Pincode</label>
                                    <input type="text" class="lab-input" @bind="current.areapincode" placeholder="e.g. 638052" maxlength="10" />
                                </div>
                                <div class="form-group">
                                    <label>Home Collection Charge</label>
                                    <div class="input-with-icon">
                                        <span class="prefix-icon material-symbols-rounded">payments</span>
                                        <input type="number" step="0.01" class="lab-input pl-36" @bind="current.homecollectioncharge" placeholder="50.00" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-bar">
                        <button type="button" class="btn-delete" @onclick="() => SoftDeleteArea(current.areacode)" disabled="@(current.areacode == 0)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SaveArea">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="btn-icon-mr">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                            </svg>
                            Save Area
                        </button>
                    </div>
                </div>
            </div>
        }
    
    <div class="directory-section directory-section-connected">

        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th class="th-order-no">ORDER NO</th>
                        <th>CITY / PINCODE</th>
                        <th>AREA NAME</th>
                        <th>SHORT NAME</th>
                        <th>NARRATION</th>
                        <th class="text-center">CHARGE</th>
                        <th>ENTERED DATE</th>
                        <th>MODIFIED DATE</th>
                        <th class="text-center th-actions">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (areas != null && areas.Any())
                    {
                        @foreach (var co in FilteredAreasBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@($"{co.orderno:00}")</span></td>
                                <td>
                                    <div class="font-12 font-bold text-primary">@(cities.FirstOrDefault(c => c.citycode == co.citycode)?.cityname ?? "N/A")</div>
                                    <div class="font-11 text-slate-400"># @co.areapincode</div>
                                </td>
                                <td><span class="td-name">@co.areaname</span></td>
                                <td class="td-shortname">@co.shortname</td>
                                <td><span class="td-narration">@co.description</span></td>
                                <td class="text-center"><span class="badge bg-success-subtle text-success border">@co.homecollectioncharge?.ToString("N2")</span></td>
                                <td>@($"{co.entereddate:M/d/yyyy}")</td>
                                <td>@($"{co.ibsdate:M/d/yyyy}")</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditArea(co)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteArea(co.areacode)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="td-narration p-24 text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<AreaModel> areas = new();
    private IEnumerable<AreaModel> FilteredAreas =>
        displayActiveOnly ? areas.Where(c => c.deleted != true) : areas;

    private IEnumerable<AreaModel> FilteredAreasBySearch =>
        FilteredAreas.Where(a => 
            string.IsNullOrWhiteSpace(SearchQuery) || 
            (a.areaname != null && a.areaname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (a.shortname != null && a.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (a.areapincode != null && a.areapincode.Contains(SearchQuery)) ||
            (cities.Any(c => c.citycode == a.citycode && c.cityname != null && c.cityname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));


    private List<CityModel> cities = new();
    private List<StateModel> states = new();
    private List<CountryModel> countries = new();

    private AreaModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool showAreaDropdown = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    // Ensure the global state container is updated so HttpClient headers are injected
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);

                    await LoadCountries();
                    await LoadStates();
                    await LoadCities();
                    await LoadAreas();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session Load Error: {ex.Message}";
                /* Console.WriteLine($"Error getting tenant data: {ex.Message}") */;
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient() 
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private string? errorMessage;

    private async Task LoadAreas()
    {
        if (string.IsNullOrEmpty(TenantCode)) 
        {
            errorMessage = "Unauthorized: Missing tenant code.";
            return;
        }
        try
        {
            errorMessage = null;
            using var client = CreateClient();
            var url = $"{BaseUrl}Area/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                areas = await response.Content.ReadFromJsonAsync<List<AreaModel>>() ?? new List<AreaModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading areas ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading areas: {ex.Message}";
        }
    }
    private async Task LoadCities()
    {
        if (string.IsNullOrEmpty(TenantCode)) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}City/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                cities = await response.Content.ReadFromJsonAsync<List<CityModel>>() ?? new List<CityModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error loading cities ({response.StatusCode}): {errorBody}";
                /* Console.WriteLine($"Error loading cities: {response.StatusCode} - {errorBody}") */;
            }
        }
        catch (Exception)
        {
        }
    }
    private async Task LoadStates()
    {
        if (string.IsNullOrEmpty(TenantCode)) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}State/getall";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                states = await response.Content.ReadFromJsonAsync<List<StateModel>>() ?? new List<StateModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception)
        {
        }
    }
    private async Task LoadCountries()
    {
        if (string.IsNullOrEmpty(TenantCode)) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Country/get";
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                countries = await response.Content.ReadFromJsonAsync<List<CountryModel>>() ?? new List<CountryModel>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception)
        {
        }
    }

    private void NewArea()
    {
        current = new AreaModel();
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditArea(AreaModel co)
    {
        if (co == null) return;
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}Area/getbyid?areacode={co.areacode}";
            current = await client.GetFromJsonAsync<AreaModel>(url) ?? new AreaModel();
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<AreaModel>(JsonConvert.SerializeObject(co)) ?? new AreaModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }
    private async Task SaveArea()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded. Please refresh the page and try again.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(current.areaname))
        {
            errorMessage = "Error: Area Name is required.";
            StateHasChanged();
            return;
        }

        // Duplicate check
        if (areas.Any(a => a.areaname?.Trim().Equals(current.areaname?.Trim(), StringComparison.OrdinalIgnoreCase) == true && a.areacode != current.areacode))
        {
            errorMessage = $"Error: An area with the name '{current.areaname}' already exists.";
            StateHasChanged();
            return;
        }
        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}Area/update", current);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}Area/insert", current);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadAreas();
                errorMessage = isEditMode ? "Area updated successfully." : "Area added successfully.";
                NewArea();
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {body}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving area: {ex.Message}";
            Console.Error.WriteLine($"Error saving area: {ex.Message}");
            StateHasChanged();
        }
    }

    private async Task SoftDeleteArea(int? areacode = null)
    {
        if (!areacode.HasValue && current != null)
        {
            areacode = current.areacode;
        }
        if (!areacode.HasValue || areacode.Value == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this area?"))
        {
            try
            {
                using var client = CreateClient();
                var url = $"{BaseUrl}Area/softdelete?areacode={areacode.Value}";
                var response = await client.GetAsync(url);
                response.EnsureSuccessStatusCode();
                await LoadAreas();
                
                if (current != null && current.areacode == areacode)
                {
                    showForm = false;
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error deleting area: {ex.Message}");
            }
        }
    }

    private void CloseForm()
    {
        current = new AreaModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }

    private async Task HideAreaDropdown()
    {
        await Task.Delay(200);
        showAreaDropdown = false;
        StateHasChanged();
    }

    private void SelectExistingArea(AreaModel existingArea)
    {
        showAreaDropdown = false;
        _ = EditArea(existingArea);
    }
}
