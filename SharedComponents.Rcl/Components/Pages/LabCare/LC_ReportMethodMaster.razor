@page "/report-method-master"
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState

<div class="referral-page" style="position: relative;">
    <div class="lab-header-card flex-between">
        <div class="display-flex align-center gap-16">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">science</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Report Method Master</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Reporting Methods</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search methods..." @bind="SearchQuery" @bind:event="oninput"
                       style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 220px;" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewMethod">+ Add New</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: @(errorMessage.Contains("success", StringComparison.OrdinalIgnoreCase) ? "#dcfce7" : "#fee2e2");
                    border: 1px solid @(errorMessage.Contains("success", StringComparison.OrdinalIgnoreCase) ? "#86efac" : "#fca5a5");
                    color: @(errorMessage.Contains("success", StringComparison.OrdinalIgnoreCase) ? "#15803d" : "#b91c1c");
                    padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; font-weight: 500;">
            @errorMessage
        </div>
    }

    @if (showForm)
    {
        <div style="position: absolute; inset: 0; background: rgba(15,23,42,0.55); z-index: 200;
                    display: flex; align-items: center; justify-content: center;
                    backdrop-filter: blur(3px); border-radius: inherit;">
            <div class="modal-form-card">
                <div class="modal-header-bar">
                    <h3>@(isEditMode ? "Edit Method" : "New Method Entry")</h3>
                    <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-0 form-section">
                        <div class="mt-0">
                            <!-- Method Name (full-width with live dropdown) -->
                            <div class="um-grid-row">
                                <div class="form-group position-relative">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                        <label style="margin-bottom: 0;">Method Name <span class="text-danger">*</span></label>
                                        @if (isSubmitted && string.IsNullOrEmpty(current.name))
                                        {
                                            <span class="text-danger" style="font-size: 11px; font-weight: 500;">This field is required</span>
                                        }
                                    </div>
                                    <input type="text" class="lab-input"
                                           @bind="current.name"
                                           @bind:event="oninput"
                                           @onfocus="() => showMethodDropdown = true"
                                           @onblur="HideMethodDropdown"
                                           placeholder="Search or enter method name"
                                           required />
                                    @if (showMethodDropdown && !string.IsNullOrWhiteSpace(current.name) && !isEditMode)
                                    {
                                        var matched = allMethods
                                            .Where(m => m.name != null && m.name.Contains(current.name, StringComparison.OrdinalIgnoreCase))
                                            .ToList();
                                        if (matched.Any())
                                        {
                                            <div class="master-search-dropdown show">
                                                @foreach (var m in matched)
                                                {
                                                    <button type="button" class="master-search-item" @onmousedown="() => SelectExistingMethod(m)">
                                                        @m.name
                                                        @if (m.isculture)
                                                        {
                                                            <span style="margin-left: 6px; background: #dcfce7; color: #15803d; padding: 1px 6px; border-radius: 10px; font-size: 10px; font-weight: 700;">Culture</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Order No, Short Name, Duration Type -->
                            <div class="um-grid-cols-3">
                                <div class="form-group">
                                    <label>Order No</label>
                                    <input type="number" class="lab-input" @bind="current.orderno" placeholder="01" />
                                </div>
                                <div class="form-group">
                                    <label>Short Name</label>
                                    <input type="text" class="lab-input" @bind="current.shortname" placeholder="e.g. AC" />
                                </div>
                                <div class="form-group">
                                    <label>Duration Type</label>
                                    <select class="lab-input" @bind="current.duration">
                                        <option value="">Select</option>
                                        <option value="Minutes">Minutes</option>
                                        <option value="Hours">Hours</option>
                                        <option value="Days">Days</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Duration Time, Description -->
                            <div class="um-grid-cols-3 mt-4">
                                <div class="form-group">
                                    <label>Duration Time</label>
                                    <input type="number" class="lab-input" @bind="current.durationtime" placeholder="0" />
                                </div>
                                <div class="form-group" style="grid-column: span 2;">
                                    <label>Narration / Description</label>
                                    <input type="text" class="lab-input" @bind="current.description" placeholder="Optional notes..." />
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="um-grid-row mt-4">
                                <div class="form-group">
                                    <label>Footer Text</label>
                                    <textarea class="lab-input" style="height: 60px; resize: vertical;" @bind="current.footer"
                                              placeholder="Footer text to print on reports..."></textarea>
                                </div>
                            </div>

                            <!-- Is Culture checkbox -->
                            <div class="um-grid-row mt-4">
                                <div class="form-group display-flex align-center gap-8" style="padding-top: 10px;">
                                    <input type="checkbox" id="isculture_rm" @bind="current.isculture"
                                           style="width: 16px; height: 16px; cursor: pointer;" />
                                    <label for="isculture_rm" style="margin: 0; cursor: pointer; user-select: none;">
                                        Is Culture Method
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer-bar">
                    <button type="button" class="btn-delete"
                            @onclick="() => SoftDeleteMethod(current.rtmcode)"
                            disabled="@(current.rtmcode == 0)">
                        Delete
                    </button>
                    <button type="button" class="btn-save" @onclick="SaveMethod">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z" />
                        </svg>
                        @(isEditMode ? "Update Method" : "Save Method")
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">
        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">ORDER NO</th>
                        <th>SHORT NAME</th>
                        <th>METHOD NAME</th>
                        <th>DURATION</th>
                        <th>NARRATION</th>
                        <th class="text-center" style="width: 100px;">CULTURE</th>
                        <th>MODIFIED DATE</th>
                        <th class="text-center" style="width: 128px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredMethodsBySearch.Any())
                    {
                        @foreach (var m in FilteredMethodsBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@($"{m.orderno:00}")</span></td>
                                <td style="color: #64748b; font-family: monospace;">@m.shortname</td>
                                <td><span class="td-name">@m.name</span></td>
                                <td>
                                    @if (m.durationtime > 0 || !string.IsNullOrEmpty(m.duration))
                                    {
                                        <span>@m.durationtime @m.duration</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="td-narration">@m.description</span></td>
                                <td class="text-center">
                                    @if (m.isculture)
                                    {
                                        <span style="background: #dcfce7; color: #15803d; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700;">Yes</span>
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8; font-size: 11px;">No</span>
                                    }
                                </td>
                                <td>@($"{m.ibsdate:MM/dd/yyyy hh:mm tt}")</td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditMethod(m)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteMethod(m.rtmcode)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="td-narration p-24 text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    // ─── Data ────────────────────────────────────────────────────────────────
    private List<ReportMethodModel> allMethods = new();   // all (routine + culture) for dropdown
    private List<ReportMethodModel> displayMethods = new(); // currently shown in table

    private IEnumerable<ReportMethodModel> FilteredMethodsBySearch =>
        displayMethods.Where(m =>
            m.deleted != true &&
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             (m.name != null && m.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
             (m.shortname != null && m.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))));

    private ReportMethodModel current = new();
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;

    private bool isEditMode = false;
    private bool showForm = false;
    private bool isSubmitted = false;
    private bool showMethodDropdown = false;
    private string SearchQuery = "";
    private string? errorMessage;

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";

    // ─── Lifecycle ───────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantResult.Success ? tenantResult.Value ?? "" : "";

                var nameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = nameResult.Success ? nameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);
                    await LoadAllMethods();
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    // ─── HTTP client ─────────────────────────────────────────────────────────
    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        if (!string.IsNullOrEmpty(AuthToken))
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        return client;
    }

    // ─── Load ─────────────────────────────────────────────────────────────────
    /// <summary>
    /// Loads both routine (get) and culture (get-culture) lists.
    /// Routine list is shown in the table; combined list drives the name dropdown.
    /// </summary>
    private async Task LoadAllMethods()
    {
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Unauthorized access. Missing tenant context.";
            return;
        }
        try
        {
            errorMessage = null;
            using var client = CreateClient();

            // Routine (non-culture)
            var routineTask = client.GetAsync($"{BaseUrl}ReportMethod/get");
            // Culture
            var cultureTask = client.GetAsync($"{BaseUrl}ReportMethod/get-culture");

            await Task.WhenAll(routineTask, cultureTask);

            var routineList = new List<ReportMethodModel>();
            var cultureList = new List<ReportMethodModel>();

            if (routineTask.Result.IsSuccessStatusCode)
                routineList = await routineTask.Result.Content.ReadFromJsonAsync<List<ReportMethodModel>>() ?? new();

            if (cultureTask.Result.IsSuccessStatusCode)
                cultureList = await cultureTask.Result.Content.ReadFromJsonAsync<List<ReportMethodModel>>() ?? new();

            // Merge for dropdown (de-dup by rtmcode)
            allMethods = routineList
                .Concat(cultureList)
                .GroupBy(m => m.rtmcode)
                .Select(g => g.First())
                .OrderBy(m => m.orderno)
                .ToList();

            // Table shows both
            displayMethods = allMethods;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading methods: {ex.Message}";
        }
    }

    // ─── CRUD ─────────────────────────────────────────────────────────────────
    private void NewMethod()
    {
        current = new ReportMethodModel
        {
            orderno = allMethods.Any() ? allMethods.Max(m => m.orderno) + 1 : 1,
            duration = "Hours",
            usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1,
            computercode = TenantState.BranchCode ?? 1
        };
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditMethod(ReportMethodModel row)
    {
        if (row == null) return;
        // Use the in-memory record (already fully loaded from both endpoints)
        current = JsonConvert.DeserializeObject<ReportMethodModel>(
                      JsonConvert.SerializeObject(row)) ?? new ReportMethodModel();

        // Parse combined duration string (e.g. "24 Hours") back into durationtime + unit
        // so the form's number input and dropdown bind correctly.
        if (!string.IsNullOrWhiteSpace(current.duration))
        {
            var parts = current.duration.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2 && int.TryParse(parts[0], out var parsedTime))
            {
                current.durationtime = parsedTime;
                current.duration = parts[1]; // unit only: "Hours", "Days", "Minutes"
            }
        }

        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveMethod()
    {
        isSubmitted = true;

        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            StateHasChanged();
            return;
        }
        if (string.IsNullOrWhiteSpace(current.name))
        {
            errorMessage = "Error: Method Name is required.";
            StateHasChanged();
            return;
        }
        // Duplicate check (same name, different key)
        if (allMethods.Any(m =>
            m.name?.Trim().Equals(current.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true
            && m.rtmcode != current.rtmcode))
        {
            errorMessage = $"Error: A method named '{current.name}' already exists.";
            StateHasChanged();
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            current.ibsdate = DateTimeOffset.Now;

            // Build combined duration string expected by the API, e.g. "24 Hours"
            if (current.durationtime > 0 && !string.IsNullOrWhiteSpace(current.duration))
                current.duration = $"{current.durationtime} {current.duration.Trim()}";

            // Ensure usercode / computercode are populated from session
            if (current.usercode == 0)
                current.usercode = TenantState.UserCode > 0 ? TenantState.UserCode : 1;
            if (current.computercode == 0)
                current.computercode = TenantState.BranchCode ?? 1;

            using var client = CreateClient();

            // ✅ Correctly branch insert vs update
            var endpoint = isEditMode
                ? $"{BaseUrl}ReportMethod/update"
                : $"{BaseUrl}ReportMethod/insert";

            var response = await client.PostAsJsonAsync(endpoint, current);

            if (response.IsSuccessStatusCode)
            {
                await LoadAllMethods();
                errorMessage = isEditMode ? "Method updated successfully." : "Method added successfully.";
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {body}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SoftDeleteMethod(long rtmcode)
    {
        if (rtmcode == 0) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this method?"))
            return;

        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}ReportMethod/softdelete?rtmcode={rtmcode}");

            if (!response.IsSuccessStatusCode)
            {
                // Fallback: hard delete
                var delResponse = await client.DeleteAsync($"{BaseUrl}ReportMethod/delete?rtmcode={rtmcode}");
                if (!delResponse.IsSuccessStatusCode)
                {
                    var body = await delResponse.Content.ReadAsStringAsync();
                    errorMessage = $"Delete failed: {body}";
                    StateHasChanged();
                    return;
                }
            }

            await LoadAllMethods();
            if (current.rtmcode == rtmcode)
                showForm = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting: {ex.Message}";
            StateHasChanged();
        }
    }

    // ─── UI helpers ──────────────────────────────────────────────────────────
    private void CloseForm()
    {
        current = new ReportMethodModel();
        isEditMode = false;
        showForm = false;
        isSubmitted = false;
    }

    private async Task HideMethodDropdown()
    {
        await Task.Delay(200);
        showMethodDropdown = false;
        StateHasChanged();
    }

    private void SelectExistingMethod(ReportMethodModel existing)
    {
        showMethodDropdown = false;
        _ = EditMethod(existing);
    }
}
