@page "/reimbursementcompanymaster"
@using Newtonsoft.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState

<div class="referral-page">
    <div class="lab-header-card flex-between" style="padding: 12px 24px; margin-bottom: 0px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div class="bg-indigo-50 p-2 rounded-lg shadow-sm flex-center icon-box-container">
                <span class="material-symbols-outlined text-indigo-600 icon-lg">business</span>
            </div>
            <div>
                <h2 class="lab-title-text m-0">Reimbursement Company</h2>
                <div class="flex-start gap-8 mt-2px">
                    <span class="status-pulse-dot"></span>
                    <span class="status-text">Partner Management</span>
                </div>
            </div>
        </div>
        <div class="display-flex align-center gap-12">
            <div class="relative-positioned">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16" class="search-icon">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                <input type="text" placeholder="Search companies..." @bind="SearchQuery" @bind:event="oninput" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 8px 16px 8px 36px; font-size: 13px; color: #1e293b; outline: none; width: 220px;" />
            </div>
            <div class="search-controls">
                <button class="btn-new-entry" @onclick="NewCompany">+ Add New</button>
            </div>
        </div>
    </div>

    

    @if (showForm)
    {
            <div class="modal-overlay">
                <div class="modal-form-card" style="max-width: 900px; width: 90%;">
                    <div class="modal-header-bar">
                        <h3>@(isEditMode ? "Edit Company" : "New Company Entry")</h3>
                        <button type="button" class="modal-close-btn" @onclick="CloseForm" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </div>
                    
                    <div class="modal-body">
                        <div class="mb-0 form-section">
                            <div class="mt-0">
                                <div class="um-grid-row">
                                    <div class="form-group">
                                        <label>Company Name <span class="text-danger">*</span></label>
                                        <input type="text" class="lab-input @(isSubmitted && string.IsNullOrWhiteSpace(current.name) ? "error-input" : "")" @bind="current.name" placeholder="Company Name" />
                                        @if (isSubmitted && string.IsNullOrWhiteSpace(current.name))
                                        {
                                            <div class="error-text" style="font-size: 11px; margin-top: 4px;">Company Name is required</div>
                                        }
                                    </div>
                                </div>

                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Order No</label>
                                        <input type="number" class="lab-input" @bind="current.orderno" placeholder="1" />
                                    </div>
                                    <div class="form-group">
                                        <label>Short Name <span class="text-danger">*</span></label>
                                        <input type="text" class="lab-input @(isSubmitted && string.IsNullOrWhiteSpace(current.shortname) ? "error-input" : "")" @bind="current.shortname" placeholder="Short Name" />
                                        @if (isSubmitted && string.IsNullOrWhiteSpace(current.shortname))
                                        {
                                            <div class="error-text" style="font-size: 11px; margin-top: 4px;">Short Name is required</div>
                                        }
                                    </div>
                                </div>

                                <div class="um-grid-row">
                                    <div class="form-group">
                                        <label>Address</label>
                                        <input type="text" class="lab-input" @bind="current.address" placeholder="Address" />
                                    </div>
                                </div>

                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Area</label>
                                        <select class="lab-input" value="@current.areacode" @onchange="OnAreaChanged">
                                            <option value="0">Select Area</option>
                                            @foreach (var a in areas)
                                            {
                                                <option value="@a.areacode">@a.areaname</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>City</label>
                                        <input type="text" class="lab-input" @bind="current.city" placeholder="City" />
                                    </div>
                                    <div class="form-group">
                                        <label>Pin Code</label>
                                        <input type="text" class="lab-input" @bind="current.pincode" placeholder="Pin Code" />
                                    </div>
                                </div>

                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>State</label>
                                        <input type="text" class="lab-input" @bind="current.state" placeholder="State" />
                                    </div>
                                    <div class="form-group">
                                        <label>Country</label>
                                        <input type="text" class="lab-input" @bind="current.country" placeholder="Country" />
                                    </div>
                                    <div class="form-group">
                                        <label>Branch</label>
                                        <select class="lab-input" @bind="current.bhcode">
                                            <option value="0">Select Branch</option>
                                            @foreach (var b in branches)
                                            {
                                                <option value="@b.bhcode">@b.name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>Phone Number</label>
                                        <input type="text" class="lab-input" @bind="current.phone" placeholder="Phone" />
                                    </div>
                                    <div class="form-group">
                                        <label>Mobile Number</label>
                                        <input type="text" class="lab-input" @bind="current.mobile" placeholder="Mobile" />
                                    </div>
                                    <div class="form-group">
                                        <label>Fax</label>
                                        <input type="text" class="lab-input" @bind="current.fax" placeholder="Fax" />
                                    </div>
                                </div>

                                <div class="um-grid-cols-3">
                                    <div class="form-group">
                                        <label>E-mail</label>
                                        <input type="email" class="lab-input" @bind="current.email" placeholder="Email" />
                                    </div>
                                    <div class="form-group">
                                        <label>Website</label>
                                        <input type="text" class="lab-input" @bind="current.website" placeholder="Website" />
                                    </div>
                                </div>

                                <div class="um-grid-row">
                                    <div class="form-group">
                                        <label>Narration / Description</label>
                                        <input type="text" class="lab-input" @bind="current.description" placeholder="Narration" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer-bar">
                        <button type="button" class="btn-delete" @onclick="() => SoftDeleteCompany(current.ricode)" disabled="@(current.ricode == 0)">
                            Delete
                        </button>
                        <button type="button" class="btn-save" @onclick="SaveCompany">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 8px;">
                                <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                            </svg>
                            Save Company
                        </button>
                    </div>
                </div>
            </div>
        }

    <!-- Index Table -->
    <div class="directory-section" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -4px;">

        <div class="table-wrapper">
            <table class="directory-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ORDER NO</th>
                        <th>COMPANY NAME</th>
                        <th>SHORT NAME</th>
                        <th>ADDRESS</th>
                        <th>AREA</th>
                        <th>CITY</th>
                        <th class="text-center" style="width: 80px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (companies != null && companies.Any())
                    {
                        @foreach (var co in FilteredCompaniesBySearch)
                        {
                            <tr>
                                <td><span class="td-order-no">@co.orderno</span></td>
                                <td><span class="td-name">@co.name</span></td>
                                <td><span style="color: #64748b; font-family: monospace;">@co.shortname</span></td>
                                <td><span style="font-size: 12px; color: #64748b; display: block; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@co.address</span></td>
                                <td><span class="td-narration">@(areas.FirstOrDefault(a => a.areacode == co.areacode)?.areaname ?? "N/A")</span></td>
                                <td><span class="td-narration">@co.city</span></td>
                                <td class="text-center">
                                    <button type="button" class="btn-action btn-edit" @onclick="() => EditCompany(co)" title="Edit">
                                        <span class="material-symbols-outlined" style="font-size:16px;">edit</span>
                                    </button>
                                    <button type="button" class="btn-action btn-delete-action" @onclick="() => SoftDeleteCompany(co.ricode)" title="Delete">
                                        <span class="material-symbols-outlined" style="font-size:16px;">delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center" style="color: #94a3b8;">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ReimbursementCompanyModel> companies = new();
    private List<AreaModel> areas = new();
    private List<CityModel> cities = new();
    private List<StateModel> states = new();
    private List<CountryModel> countries = new();
    private List<BranchModel> branches = new();
    private List<FeetypeModel> feeTypes = new();

    private IEnumerable<ReimbursementCompanyModel> FilteredCompanies =>
        displayActiveOnly ? companies.Where(c => !c.deleted) : companies;

    private IEnumerable<ReimbursementCompanyModel> FilteredCompaniesBySearch =>
        FilteredCompanies.Where(c =>
            string.IsNullOrWhiteSpace(SearchQuery) ||
            (c.name != null && c.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (c.shortname != null && c.shortname.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (areas.FirstOrDefault(a => a.areacode == c.areacode)?.areaname?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) == true));

    private ReimbursementCompanyModel current = new();
    
    private AppSettings _appSettings = new();
    private string BaseUrl => _appSettings.BaseUrl;
    private bool isEditMode = false;
    private bool displayActiveOnly = true;
    private bool showForm = false;
    private bool isSubmitted = false;
    private string SearchQuery = "";

    private string TenantCode = "";
    private string TenantName = "";
    private string AuthToken = "";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tenantCodeResult = await _sessionStorage.GetAsync<string>("tenant_code");
                TenantCode = tenantCodeResult.Success ? tenantCodeResult.Value ?? "" : "";

                var tenantNameResult = await _sessionStorage.GetAsync<string>("tenant_name");
                TenantName = tenantNameResult.Success ? tenantNameResult.Value ?? "" : "";

                var tokenResult = await _sessionStorage.GetAsync<string>("authToken");
                AuthToken = tokenResult.Success ? tokenResult.Value ?? "" : "";

                if (!string.IsNullOrEmpty(AuthToken))
                {
                    TenantState.SetSession(TenantCode, AuthToken, TenantName);

                    await Task.WhenAll(
                        LoadCompanies(),
                        LoadAreas(),
                        LoadCities(),
                        LoadStates(),
                        LoadCountries(),
                        LoadBranches(),
                        LoadFeeTypes()
                    );
                    StateHasChanged();
                }
                else
                {
                    errorMessage = "Access denied: Missing valid session. Please log in again.";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Session error: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private HttpClient CreateClient()
    {
        var client = ClientFactory.CreateClient("LabCareApi");
        if (!string.IsNullOrEmpty(TenantCode))
        {
            client.DefaultRequestHeaders.Add("tenant_code", TenantCode);
        }
        if (!string.IsNullOrEmpty(AuthToken))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthToken);
        }
        return client;
    }

    private async Task LoadCompanies()
    {
        try
        {
            using var client = CreateClient();
            var response = await client.GetAsync($"{BaseUrl}ReimbursementCompany/getall");
            if (response.IsSuccessStatusCode)
            {
                companies = await response.Content.ReadFromJsonAsync<List<ReimbursementCompanyModel>>() ?? new List<ReimbursementCompanyModel>();
            }
            else 
            {
                errorMessage = $"Error loading data: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading companies: {ex.Message}";
        }
    }

    private async Task LoadAreas()
    {
        try {
            using var client = CreateClient();
            areas = await client.GetFromJsonAsync<List<AreaModel>>($"{BaseUrl}Area/get") ?? new();
        } catch {}
    }

    private async Task LoadCities()
    {
        try {
            using var client = CreateClient();
            cities = await client.GetFromJsonAsync<List<CityModel>>($"{BaseUrl}City/get") ?? new();
        } catch {}
    }

    private async Task LoadStates()
    {
        try {
            using var client = CreateClient();
            states = await client.GetFromJsonAsync<List<StateModel>>($"{BaseUrl}State/getall") ?? new();
        } catch {}
    }

    private async Task LoadCountries()
    {
        try {
            using var client = CreateClient();
            countries = await client.GetFromJsonAsync<List<CountryModel>>($"{BaseUrl}Country/get") ?? new();
        } catch {}
    }

    private async Task LoadBranches()
    {
        try {
            using var client = CreateClient();
            branches = await client.GetFromJsonAsync<List<BranchModel>>($"{BaseUrl}Branch/get") ?? new();
        } catch {}
    }

    private async Task LoadFeeTypes()
    {
        try {
            using var client = CreateClient();
            feeTypes = await client.GetFromJsonAsync<List<FeetypeModel>>($"{BaseUrl}Feetype/get") ?? new();
        } catch {}
    }

    private void OnAreaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int code))
        {
            current.areacode = code;
            var area = areas.FirstOrDefault(a => a.areacode == code);
            if (area != null)
            {
                current.pincode = area.areapincode;
                current.city = cities.FirstOrDefault(c => c.citycode == area.citycode)?.cityname;
                current.state = states.FirstOrDefault(s => s.statecode == area.statecode)?.statename;
                current.country = countries.FirstOrDefault(co => co.countrycode == area.countrycode)?.countryname;
            }
        }
    }

    private void NewCompany()
    {
        current = new ReimbursementCompanyModel();
        isEditMode = false;
        showForm = true;
        isSubmitted = false;
    }

    private async Task EditCompany(ReimbursementCompanyModel co)
    {
        try
        {
            using var client = CreateClient();
            var url = $"{BaseUrl}ReimbursementCompany/getbyid?ricode={co.ricode}";
            current = await client.GetFromJsonAsync<ReimbursementCompanyModel>(url) ?? new ReimbursementCompanyModel();
        }
        catch (Exception)
        {
            current = JsonConvert.DeserializeObject<ReimbursementCompanyModel>(JsonConvert.SerializeObject(co)) ?? new ReimbursementCompanyModel();
        }
        isEditMode = true;
        showForm = true;
        isSubmitted = false;
    }

    private async Task SaveCompany()
    {
        isSubmitted = true;
        if (string.IsNullOrEmpty(TenantCode))
        {
            errorMessage = "Error: Tenant code is not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(current.name) || string.IsNullOrWhiteSpace(current.shortname))
        {
            return;
        }

        // Check for duplicates
        if (companies.Any(c => c.name?.Trim().Equals(current.name?.Trim(), StringComparison.OrdinalIgnoreCase) == true && c.ricode != current.ricode))
        {
            errorMessage = $"Error: A company with the name '{current.name}' already exists.";
            return;
        }
        if (companies.Any(c => c.shortname?.Trim().Equals(current.shortname?.Trim(), StringComparison.OrdinalIgnoreCase) == true && c.ricode != current.ricode))
        {
            errorMessage = $"Error: A company with the short name '{current.shortname}' already exists.";
            return;
        }

        try
        {
            errorMessage = null;
            current.tenant_code = TenantCode;
            current.usercode = current.usercode == 0 ? 1 : current.usercode;
            current.computercode = current.computercode == 0 ? 1 : current.computercode;
            
            if(!isEditMode) current.entereddate = DateTime.Now;
            current.ibsdate = DateTime.Now;

            using var client = CreateClient();
            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}ReimbursementCompany/update", current);
            }
            else
            {
                response = await client.PostAsJsonAsync($"{BaseUrl}ReimbursementCompany/insert", current);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadCompanies();
                errorMessage = isEditMode ? "Company updated successfully." : "New company added.";
                showForm = false;
                StateHasChanged();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                errorMessage = $"Save failed ({response.StatusCode}): {errorBody}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
    }

    private async Task SoftDeleteCompany(long code)
    {
        if (code == 0) return;
        
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this company?"))
        {
            try
            {
                using var client = CreateClient();
                // Parameter changed to ricode to match backend model
                var response = await client.GetAsync($"{BaseUrl}ReimbursementCompany/softdelete?ricode={code}");
                if(response.IsSuccessStatusCode)
                {
                    await LoadCompanies();
                    if(current.ricode == code) showForm = false;
                }
                else 
                {
                    errorMessage = $"Delete failed: {await response.Content.ReadAsStringAsync()}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Delete error: {ex.Message}";
            }
        }
    }

    private void CloseForm()
    {
        isEditMode = false;
        showForm = false;
    }
}
