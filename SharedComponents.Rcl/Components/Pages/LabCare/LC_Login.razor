@using SharedComponents.Rcl.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using SharedComponents.Rcl.Services
@inject IHttpClientFactory ClientFactory
@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppSettingsOptions
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage _sessionStorage
@inject TenantSessionState TenantState
@inject NotificationService Toast

<!-- Stripe Login Card -->
<div class="stripe-card" style="@(Mode == "Tenant" ? "border-top: 4px solid #4f46e5;" : "")">
    <div class="stripe-logo-card">
        <span class="stripe-logo-text">LabCare <span>Elite</span></span>
    </div>
    
    @if (Mode == "Tenant")
    {
        <h2>Sign in to root tenant dashboard</h2>
    }
    else if (Mode == "Staff")
    {
        <h2>Sign In</h2>
    }
    else
    {
        <h2>Log In</h2>
    }

    @if (Mode == "Staff")
    {
        <EditForm Model="@staffLogin" OnValidSubmit="HandleStaffLogin" FormName="StaffLoginForm">
            <DataAnnotationsValidator />
            
            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="email">Email Address or Mobile Number</label>
                </div>
                <InputText id="email" @bind-Value="staffLogin.input" placeholder="Email Address or Mobile Number" class="stripe-input" />
                <ValidationMessage For="@(() => staffLogin.input)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="password">Password</label>
                    <a href="/forgot-password" class="stripe-link-subtle">Forgot your password?</a>
                </div>
                <div style="position: relative; display: flex; align-items: center;">
                    <input id="password" type="@(showPassword ? "text" : "password")" @bind="staffLogin.password" @bind:event="oninput" placeholder="••••••••" class="stripe-input" style="padding-right: 44px;" />
                    <button type="button" 
                            style="position: absolute; right: 14px; background: none; border: none; color: #94a3b8; cursor: pointer; padding: 0; display: flex; align-items: center;" 
                            @onclick="() => { showPassword = !showPassword; }" tabindex="-1">
                        <i class="bi @(showPassword ? "bi-eye" : "bi-eye-slash")" style="font-size: 16px;"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => staffLogin.password)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <div class="stripe-options-row">
                <label class="stripe-checkbox-label">
                    <input type="checkbox" class="stripe-checkbox" checked />
                    <span>Stay signed in</span>
                </label>
            </div>

            <button type="submit" class="stripe-btn-primary" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem;"></span>
                    <span>Signing In...</span>
                }
                else
                {
                    <span>Continue</span>
                }
            </button>
        </EditForm>
    }
    else
    {
        <EditForm Model="@adminLogin" OnValidSubmit="HandleAdminLogin" FormName="AdminLoginForm">
            <DataAnnotationsValidator />
            
            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="email">@(Mode == "Tenant" ? "Admin Email" : "Email Address")</label>
                </div>
                <InputText id="email" @bind-Value="adminLogin.email" placeholder="@(Mode == "Tenant" ? "admin@facility.com" : "name@example.com")" class="stripe-input" />
                <ValidationMessage For="@(() => adminLogin.email)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <div class="stripe-form-group">
                <div class="stripe-label-row">
                    <label for="password">@(Mode == "Tenant" ? "Secure Password" : "Password")</label>
                    <a href="/forgot-password" class="stripe-link-subtle">@(Mode == "Tenant" ? "Recover Admin Access" : "Forgot your password?")</a>
                </div>
                <div style="position: relative; display: flex; align-items: center;">
                    <input id="password" type="@(showPassword ? "text" : "password")" @bind="adminLogin.password" @bind:event="oninput" placeholder="••••••••" class="stripe-input" style="padding-right: 44px;" />
                    <button type="button" 
                            style="position: absolute; right: 14px; background: none; border: none; color: #94a3b8; cursor: pointer; padding: 0; display: flex; align-items: center;" 
                            @onclick="() => { showPassword = !showPassword; }" tabindex="-1">
                        <i class="bi @(showPassword ? "bi-eye" : "bi-eye-slash")" style="font-size: 16px;"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => adminLogin.password)" style="font-size: 13px; color: #ef4444; margin-top: 4px; display: block;" />
            </div>

            <div class="stripe-options-row">
                <label class="stripe-checkbox-label">
                    <input type="checkbox" class="stripe-checkbox" checked />
                    <span>Stay signed in</span>
                </label>
            </div>

            <button type="submit" class="stripe-btn-primary" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem;"></span>
                    <span>@(Mode == "Tenant" ? "Authenticating..." : "Signing In...")</span>
                }
                else
                {
                    <span>@(Mode == "Tenant" ? "Access Dashboard →" : "Continue")</span>
                }
            </button>
        </EditForm>
    }

    <div class="stripe-card-footer">
        @if (Mode == "Staff")
        {
            <a href="/" class="stripe-divider-link">Use Admin Login instead</a>
            <div class="stripe-register-section">
                <span>New laboratory?</span>
                <a href="/edit-profile" class="stripe-register-link">Register Facility</a>
            </div>
        }
        else if (Mode == "Tenant")
        {
            <a href="/user-login" class="stripe-divider-link">Use Staff Login instead</a>
        }
        else
        {
            <a href="/user-login" class="stripe-divider-link">Use Staff Login instead</a>
            <div class="stripe-register-section">
                <span>New laboratory?</span>
                <a href="/edit-profile" class="stripe-register-link">Register Facility</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Mode { get; set; } = "Admin"; // "Admin", "Staff", "Tenant"
    [Parameter] public string? ReturnUrl { get; set; }

    private LC_LoginModel adminLogin = new();
    private LC_LoginDto staffLogin = new();
    private bool showPassword = false;
    private bool IsLoading = false; 
    private AppSettings _appSettings = new();

    protected override void OnInitialized()
    {
        _appSettings = AppSettingsOptions.Value;
    }

    private async Task HandleAdminLogin()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            using var client = ClientFactory.CreateClient("LabCareApi");
            var response = await client.PostAsJsonAsync($"{_appSettings.BaseUrl}Tenant/login", adminLogin);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LC_LoginResponseModel>();
                
                if (result != null)
                {
                    string? tc = result.tenant_code ?? result.data?.tenant_code;
                    string? tn = result.tenant_name ?? result.data?.tenant_name;
                    string? tk = result.token ?? result.data?.token;

                    if (!string.IsNullOrEmpty(tk))
                    {
                        int? branchCodeVal = result.bhcode ?? result.data?.bhcode;
                        int? counterCodeVal = result.cntcode ?? result.data?.cntcode;

                        var userDetails = new UserDetailsModel
                        {
                            UserName = result.data?.tenant_name ?? "System Administrator",
                            Role = "Administrator",
                            TenantCode = tc,
                            TenantName = tn,
                            AuthToken = tk,
                            UserCode = result.user_code ?? 0,
                            BranchCode = branchCodeVal,
                            CounterCode = counterCodeVal,
                            Claim = result.data
                        };

                        await _sessionStorage.SetAsync("authToken", tk);
                        await _sessionStorage.SetAsync("tenant_code", tc ?? "");
                        await _sessionStorage.SetAsync("tenant_name", tn ?? "");
                        await _sessionStorage.SetAsync("bhcode", branchCodeVal?.ToString() ?? "");
                        await _sessionStorage.SetAsync("cntcode", counterCodeVal?.ToString() ?? "");
                        await _sessionStorage.SetAsync("UserDetails", userDetails);

                        TenantState.SetSession(tc ?? "", tk, tn ?? "", 0, branchCodeVal, counterCodeVal);

                        NavigationManager.NavigateTo(ReturnUrl ?? "/lc-referral");
                    }
                    else
                    {
                        Toast.Error("Success, but the authentication token was invalid.");
                    }
                }
            }
            else
            {
                Toast.Error("Unauthorized: Invalid administrator credentials.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"A network error occurred: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleStaffLogin()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            using var client = ClientFactory.CreateClient("LabCareApi");
            var response = await client.PostAsJsonAsync($"{_appSettings.BaseUrl}User/login", staffLogin);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LC_LoginResponse>();
                
                if (result != null)
                {
                    string? tc = result.userdetails?.tenant_code;
                    string? tn = result.userdetails?.tenant_code; // fallback to tenant_code
                    string? tk = result.token;

                    if (!string.IsNullOrEmpty(tk))
                    {
                        int? branchCodeVal = result.userdetails?.bhcode;
                        int? counterCodeVal = result.userdetails?.cntcode;

                        var userDetails = new UserDetailsModel
                        {
                            UserName = result.userdetails?.name ?? "Staff Member",
                            Role = !string.IsNullOrEmpty(result.userdetails?.module) ? result.userdetails.module : (result.userdetails?.role?.ToString() ?? "0"),
                            TenantCode = tc,
                            TenantName = tn,
                            AuthToken = tk,
                            UserCode = result.userdetails?.usercode ?? 0,
                            BranchCode = branchCodeVal,
                            CounterCode = counterCodeVal,
                            Claim = null
                        };

                        await _sessionStorage.SetAsync("authToken", tk);
                        await _sessionStorage.SetAsync("tenant_code", tc ?? "");
                        await _sessionStorage.SetAsync("tenant_name", tn ?? "");
                        await _sessionStorage.SetAsync("bhcode", branchCodeVal?.ToString() ?? "");
                        await _sessionStorage.SetAsync("cntcode", counterCodeVal?.ToString() ?? "");
                        await _sessionStorage.SetAsync("UserDetails", userDetails);
                        await _sessionStorage.SetAsync("UserRights", result.rights);

                        TenantState.SetSession(tc ?? "", tk, tn ?? "", result.userdetails?.usercode ?? 0, branchCodeVal, counterCodeVal, userDetails, result.rights);

                        NavigationManager.NavigateTo(ReturnUrl ?? "/lc-referral");
                    }
                    else
                    {
                        Toast.Error("Success, but no token was provided.");
                    }
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Toast.Error($"Login failed: {body}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"A network error occurred: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
