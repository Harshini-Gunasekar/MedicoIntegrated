@rendermode InteractiveServer
@using SharedComponents.Rcl.Services
@implements IDisposable
@inject NotificationService NotificationService

<div class="toast-container">
    @foreach (var toast in toasts)
    {
        <div class="toast-item @toast.Type.ToString().ToLower() @(toast.IsVisible ? "show" : "hide")">
            <div class="toast-content">
                <span class="material-icons-outlined icon">
                    @GetIcon(toast.Type)
                </span>
                <span class="message">@toast.Message</span>
            </div>
            <button class="close-btn" @onclick="() => RemoveToast(toast)">
                <span class="material-icons-outlined">close</span>
            </button>
        </div>
    }
</div>

@code {
    private List<ToastModel> toasts = new();

    protected override void OnInitialized()
    {
        NotificationService.OnShow += HandleShow;
    }

    private void HandleShow(string message, NotificationType type)
    {
        var toast = new ToastModel { Message = message, Type = type, IsVisible = true };
        toasts.Add(toast);
        InvokeAsync(StateHasChanged);

        // Auto remove after 5 seconds
        _ = RemoveAfterDelay(toast);
    }

    private async Task RemoveAfterDelay(ToastModel toast)
    {
        await Task.Delay(5000);
        await RemoveToast(toast);
    }

    private async Task RemoveToast(ToastModel toast)
    {
        toast.IsVisible = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    private string GetIcon(NotificationType type) => type switch
    {
        NotificationType.Success => "check_circle",
        NotificationType.Error => "error",
        NotificationType.Warning => "warning",
        _ => "info"
    };

    public void Dispose()
    {
        NotificationService.OnShow -= HandleShow;
    }

    private class ToastModel
    {
        public string Message { get; set; } = "";
        public NotificationType Type { get; set; }
        public bool IsVisible { get; set; }
    }
}
